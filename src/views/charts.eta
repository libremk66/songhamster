<style>
  /* 榜单浏览双栏:左榜单列表(34rem 弹性)、右歌曲区;等高(桌面) */
  .ch2 { display: grid; grid-template-columns: minmax(0, 34rem) minmax(0, 1fr); gap: 1rem; align-items: stretch; }
  .ch2 > div { height: 100%; min-width: 0; display: flex; flex-direction: column; }
  /* 移动端必须 minmax(0,1fr):1fr 的 min=auto 会被长榜单行内容撑出窗口 */
  @media (max-width: 1023.98px) {
    .ch2 { grid-template-columns: minmax(0, 1fr); } .ch2 > div { height: auto; }
    .songs-col { display: none; } /* 移动端歌曲走榜单行内折叠框,右侧整框隐藏 */
  }
  /* 移动端榜单行内展开框(点「查看歌曲」在该榜单下开合;超宽内容横向滚动) */
  .ch-songs-panel { margin: .4rem 0 .6rem; border: 1px solid oklch(var(--bc) / .15); border-radius: .5rem;
                    background: oklch(var(--b1)); padding: .6rem .7rem; max-width: 100%; overflow-x: auto; }
  /* 桌面右侧歌曲区:占满整高、内容超高内部滚动(与左侧榜单框一致) */
  #ch-songs-box { flex: 1; overflow-y: auto; display: flex; flex-direction: column; }
  /* 榜单行横向防护:长名省略号、多行区横向滚动 */
  #ch-boards .multi-box { overflow: auto; }
  #ch-boards .ch-row { min-width: 0; }
  #ch-boards .ch-row > span { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  /* 服务端片段里的旧式裸按钮:统一描边绿,去 pico 蓝 */
  #ch-boards button, #ch-songs-box button {
    background: transparent; border: 1px solid oklch(var(--bc) / 0.3); border-radius: .375rem;
    padding: .1rem .55rem; font-size: .75rem; line-height: 1.5; color: var(--sfg-deep);
  }
  #ch-boards button:hover, #ch-songs-box button:hover { background: color-mix(in oklab, var(--sfg) 18%, transparent); }
  #ch-boards button:disabled, #ch-songs-box button:disabled { opacity: .5; cursor: not-allowed; }
  /* 通用:表单双列栅格 / 标签行(与 connect/sync-setup 同源) */
  .fg { display: grid; grid-template-columns: 1fr; gap: .75rem 1.25rem; }
  @media (min-width: 768px) { .fg { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .flow-label-row { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin-bottom: .3rem; }
</style>
<div class="space-y-4">

  <!-- ===== 页头 ===== -->
  <header>
    <div class="flex items-center gap-2 flex-wrap">
      <h2 class="text-lg font-extrabold tracking-tight">榜单订阅</h2>
    </div>
  </header>

  <!-- ===== 我的榜单订阅 ===== -->
  <section id="ch-subs-section" class="card tier1 border border-base-300 shadow-sm">
    <div class="card-body gap-3">
      <div class="flex flex-wrap items-center gap-2">
        <h3 class="sec-green flex-1" style="margin-bottom:0">我的榜单订阅</h3>
        <button type="button" id="ch-new-btn" class="btn btn-primary sec-green-btn" onclick="chToggleForm()"><svg aria-hidden="true"><use href="#i-plus"/></svg>新建榜单订阅</button>
      </div>
      <p class="text-xs c-sub">订阅 = 定时拉榜 → 自动下载新上榜歌曲 → 加入 <%= targetName %> 同名播放列表（默认跌出榜单不删，可选镜像跟随/归档）</p>
      <p id="ch-list-msg" class="text-sm"></p>

      <form id="ch-form" style="display:none" hx-post="/api/tasks" hx-swap="none" hx-on::after-request="chFormDone(event)"
            data-fdel-ok="<%= fileDeleteOK ? 1 : 0 %>"
            class="rounded-lg border border-base-300 bg-base-200/50 p-3">
        <h4 class="text-sm font-bold mb-2">新建订阅</h4>
        <div class="fg">
          <label class="form-control w-full">
            <span class="label-text mb-1">平台</span>
            <select name="chartSource" id="chf-source" onchange="chfLoadBoards()" class="select select-bordered w-full">
              <% for (const p of [{k:'tx',n:'QQ音乐'},{k:'kw',n:'酷我音乐'},{k:'wy',n:'网易云音乐'},{k:'kg',n:'酷狗音乐'},{k:'mg',n:'咪咕音乐'},{k:'bd',n:'百度音乐'}]) { %>
              <option value="<%= p.k %>"><%= p.n %></option>
              <% } %>
            </select>
          </label>
          <label class="form-control w-full">
            <span class="label-text mb-1">榜单</span>
            <select name="chartId" id="chf-board" onchange="chfBoardPicked()" class="select select-bordered w-full"><option value="">选择平台后加载…</option></select>
          </label>
          <label class="form-control w-full">
            <span class="label-text mb-1">任务名（默认：平台+榜单名）</span>
            <input name="lxPlaylistName" id="chf-name" placeholder="如 QQ音乐·热歌榜" class="input input-bordered w-full">
          </label>
          <label class="form-control w-full">
            <span class="label-text mb-1">下载范围（榜单前 N 首，0=全榜）</span>
            <input type="number" name="maxCount" value="30" min="0" class="input input-bordered w-full">
          </label>
          <label class="form-control w-full" style="grid-column:1/-1">
            <span class="label-text mb-1">同步频率（cron 表达式）</span>
            <input name="cronExpr" value="0 8 * * *" placeholder="0 8 * * *" class="input input-bordered w-full font-mono text-xs">
            <span class="text-xs c-sub mt-1">⚠️ 各榜单刷新周期不同（部分每日、部分每周），建议按榜单特点自定义 cron；留空则仅手动同步。默认每天早上 8 点。</span>
          </label>
        </div>
        <div class="mt-3 border-t border-base-200 pt-2">
          <span class="text-sm font-medium block mb-1">同步方式</span>
          <label class="flex items-start gap-2 cursor-pointer py-0.5"><input type="radio" name="mode" value="incremental" checked class="radio radio-sm" onchange="chMode('new')"><span class="text-sm"><b>增量</b><span class="text-xs c-sub"> 只增不减——跌出榜单的歌留在播放列表里（默认）</span></span></label>
          <label class="flex items-start gap-2 cursor-pointer py-0.5"><input type="radio" name="mode" value="mirror" class="radio radio-sm" onchange="chMode('new')"><span class="text-sm"><b>镜像</b><span class="text-xs c-sub"> 跟随榜单——跌出即按下面策略处理（播放列表 = 当前榜单）</span></span></label>
          <div id="ch-del-new" style="display:none" class="mt-1">
            <span class="text-xs font-bold c-sub block mb-1">跌出榜单时处理方式:</span>
            <label class="flex items-start gap-2 cursor-pointer py-0.5"><input type="radio" name="delPolicy" value="keep" checked class="radio radio-sm" disabled><span class="text-sm"><b>处理1</b> 播放列表移除 + 文件不删(默认)</span></label>
            <label class="flex items-start gap-2 cursor-pointer py-0.5"><input type="radio" name="delPolicy" value="delete" class="radio radio-sm" disabled><span class="text-sm"><b>处理2</b> 播放列表移除 + 删除文件<% if (!fileDeleteOK) { %><span class="text-error">(当前 <%= targetName %> 不支持)</span><% } %></span></label>
            <label class="flex items-start gap-2 cursor-pointer py-0.5"><input type="radio" name="delPolicy" value="archive" class="radio radio-sm" disabled><span class="text-sm"><b>处理3</b> 移入归档歌单: <input name="archivePlaylist" class="input input-bordered input-sm" style="width:12rem" placeholder="默认 榜单订阅归档" value="榜单订阅归档" disabled></span></label>
            <div class="ml-6 mt-1 flex flex-wrap items-center gap-1.5">
              <select class="select select-bordered select-sm" style="width:15rem" data-arch-picker="archivePlaylist" onchange="archPickFrom(this)" disabled>
                <option value="">选择归档目标…</option>
                <option value="榜单订阅归档">统一：榜单订阅归档</option>
                <option value="[榜单名]归档">按来源：[榜单名]归档</option>
                <optgroup label="<%= targetName %> 已有播放列表">
                  <% for (const p of embyPlaylists) { %><option value="<%= p.name %>"><%= p.name %></option><% } %>
                </optgroup>
              </select>
              <span class="text-xs c-sub">输入框写目标歌单名（新的也行）；下拉挑预设或已有歌单。保存时不存在会自动创建，运行中被删则降级为「保留文件」</span>
            </div>
          </div>
        </div>
        <% if (scopeUI) { %>
        <label class="form-control w-full mt-2">
          <span class="label-text mb-1">目标歌单归属</span>
          <select name="playlistScope" id="scope-ch-new" class="select select-bordered select-sm w-full"
                  hx-get="/api/media/users/options" hx-include="closest form" hx-vals='{"type":"<%= targetKey %>"}'
                  hx-trigger="load" hx-target="this" hx-swap="innerHTML">
            <option value="shared">共享（所有人可见）</option>
          </select>
          <span class="text-xs c-sub mt-1">歌单在 <%= targetName %> 里<b>按用户</b>存：选「共享」= 只找/建所有人可见的歌单；选某个账号 = 在该账号的歌单里找</span>
        </label>
        <% } %>
        <div class="flex flex-wrap items-center gap-4 mt-2">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" name="createSameNamePlaylist" value="1" checked class="checkbox checkbox-sm">
            <span class="text-sm">同步到新建同名 <%= targetName %> 播放列表</span>
          </label>
          <span id="ch-subs-msg" class="text-sm"></span>
        </div>
        <input type="hidden" name="chartName" id="chf-chartname" value="">
        <input type="hidden" name="taskType" value="chart">
        <input type="hidden" name="syncMode" value="incremental">
        <div class="card-actions flex items-center gap-2 border-t border-base-200 pt-3 mt-3">
          <button type="submit" class="btn btn-primary"><svg aria-hidden="true"><use href="#i-check"/></svg>创建订阅</button>
          <span class="text-xs c-sub">创建后出现在上方列表，点「立即同步」跑第一次</span>
        </div>
      </form>

      <div id="ch-subs-rows" hx-get="/api/charts/subs" hx-trigger="load">
        <p class="c-sub text-xs py-6 text-center">加载中…</p>
      </div>
    </div>
  </section>

  <!-- ===== 榜单浏览 ===== -->
  <section class="card tier1 border border-base-300 shadow-sm">
    <div class="card-body gap-3">
      <h3 class="sec-green">榜单浏览</h3>
      <div class="ch2">
        <div class="rounded-lg border border-base-300 p-3">
          <div class="flow-label-row">
            <span class="label-text font-semibold">平台</span>
            <div class="flex items-center gap-2">
              <select id="ch-source" class="select select-bordered" onchange="chLoadBoards()" style="width:10rem">
                <% for (const p of [{k:'tx',n:'QQ音乐'},{k:'kw',n:'酷我音乐'},{k:'wy',n:'网易云音乐'},{k:'kg',n:'酷狗音乐'},{k:'mg',n:'咪咕音乐'},{k:'bd',n:'百度音乐'}]) { %>
                <option value="<%= p.k %>"><%= p.n %></option>
                <% } %>
              </select>
              <button type="button" class="btn btn-outline btn-xs px-2" onclick="chLoadBoards(true)"><svg aria-hidden="true"><use href="#i-refresh"/></svg>刷新榜单</button>
            </div>
          </div>
          <p class="text-xs c-sub mt-2 leading-relaxed">榜单每日/每周在变——此页显示<b>当下榜单</b>；lxserver 建议缓存 10 分钟，点刷新强制重拉。想订阅的点「订阅」自动填到上方新建表单。</p>
          <div id="ch-boards" class="mt-2 space-y-1">加载中…</div>
        </div>
        <div class="songs-col rounded-lg border border-base-300 p-3">
          <div id="ch-songs-box"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 删除订阅确认（与歌单同步页同一份组件，含 文件/歌单/历史 三个复选框） -->
  <style>
    /* 不用 daisy 的 .modal-backdrop 表单兜底：pico 桥会把其中的 button 涂成蓝色大块 */
    #del-dlg::backdrop { background: oklch(0 0 0 / .45); }
  </style>
  <%~ delDialog %>

</div>

<script>
function chLoadBoards(force) {
  var src = document.getElementById('ch-source').value
  var ts = force ? '&_t=' + Date.now() : ''
  htmx.ajax('GET', '/api/charts/boards?source=' + src + ts, { target: '#ch-boards', swap: 'innerHTML' })
}
function chSongsUrl(source, bangid, name) {
  return '/api/charts/songs?source=' + source + '&bangid=' + encodeURIComponent(bangid) + '&name=' + encodeURIComponent(name) + '&_t=' + Date.now()
}
function chLoadSongs(source, bangid, name, btn) {
  // 移动端(<1024):在该榜单行下方折叠展开;桌面:右侧歌曲区
  if (btn && window.innerWidth < 1024) {
    var row = btn.closest('.ch-row')
    if (!row) return
    var panel = row.nextElementSibling
    if (panel && panel.classList.contains('ch-songs-panel')) { panel.remove(); return } // 再点收起
    panel = document.createElement('div')
    panel.className = 'ch-songs-panel'
    panel.innerHTML = '<p class="hint">加载歌曲…</p>'
    row.insertAdjacentElement('afterend', panel)
    panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
    htmx.ajax('GET', chSongsUrl(source, bangid, name), { target: panel, swap: 'innerHTML' })
    return
  }
  var box = document.getElementById('ch-songs-box')
  box.innerHTML = '<p class="hint">加载歌曲…</p>'
  htmx.ajax('GET', chSongsUrl(source, bangid, name), { target: box, swap: 'innerHTML' })
}
function chfLoadBoards() {
  var src = document.getElementById('chf-source').value
  var sel = document.getElementById('chf-board')
  sel.innerHTML = '<option value="">加载中…</option>'
  fetch('/api/charts/boards?source=' + src + '&as=options')
    .then(function (r) { return r.text() })
    .then(function (html) { sel.innerHTML = html })
}
function chfBoardPicked() {
  var src = document.getElementById('chf-source').value
  var sel = document.getElementById('chf-board')
  var opt = sel.selectedOptions[0]
  if (!opt || !opt.value) return
  var srcLabel = document.getElementById('chf-source').selectedOptions[0].textContent.replace('音乐', '')
  document.getElementById('chf-chartname').value = opt.dataset.name || ''
  var name = document.getElementById('chf-name')
  if (!name.value) name.value = srcLabel + '·' + (opt.dataset.name || '')
}
function chToggleForm() {
  var f = document.getElementById('ch-form')
  f.style.display = f.style.display === 'none' ? '' : 'none'
  if (f.style.display !== 'none') chfLoadBoards()
}
function chFormDone(ev) {
  var f = document.getElementById('ch-form')
  if (ev.detail.successful) {
    f.style.display = 'none'
    document.getElementById('chf-name').value = ''
    chSubMsg('订阅已创建')
    htmx.ajax('GET', '/api/charts/subs', { target: '#ch-subs-rows' })
  } else {
    document.getElementById('ch-subs-msg').innerHTML = '<span class="bad">创建失败，请检查参数</span>'
  }
}
function chSubMsg(msg) {
  // 提示放列表标题旁：新建表单保存后会收起，放表单里的消息看不见
  var m = document.getElementById('ch-list-msg')
  if (m) m.innerHTML = '<span class="ok">✅ ' + msg + '</span>'
}
// 同步方式联动：只有镜像才启用"跌出处理"（处理2 还需目标服务器支持删文件）
function chMode(suffix) {
  var box = document.getElementById('ch-del-' + suffix)
  if (!box) return
  var form = box.closest('form')
  var sel = form.querySelector('input[name="mode"]:checked')
  var mirror = !!sel && sel.value === 'mirror'
  box.style.display = mirror ? '' : 'none'
  var fdelOK = form.getAttribute('data-fdel-ok') === '1'
  box.querySelectorAll('input[name="delPolicy"], input[name="archivePlaylist"], select[data-arch-picker]').forEach(function (x) {
    x.disabled = !mirror || (x.name === 'delPolicy' && x.value === 'delete' && !fdelOK)
  })
}
function chEditDone(ev) {
  if (ev.detail.successful) htmx.ajax('GET', '/api/charts/subs', { target: '#ch-subs-rows' })
}
// 浏览区"订阅"按钮：滚动到订阅区、展开新建表单并预填该榜单
function chSubscribe(source, bangid, name) {
  var sec = document.getElementById('ch-subs-section')
  if (sec) sec.scrollIntoView({ behavior: 'smooth', block: 'start' })
  var form = document.getElementById('ch-form')
  form.style.display = ''
  var srcSel = document.getElementById('chf-source')
  for (var i = 0; i < srcSel.options.length; i++) {
    if (srcSel.options[i].value === source) { srcSel.selectedIndex = i; break }
  }
  var nameInput = document.getElementById('chf-name')
  var srcLabel = srcSel.selectedOptions[0].textContent.replace('音乐', '')
  nameInput.value = srcLabel + '·' + name
  document.getElementById('chf-chartname').value = name
  fetch('/api/charts/boards?source=' + source + '&as=options')
    .then(function (r) { return r.text() })
    .then(function (html) {
      var sel = document.getElementById('chf-board')
      sel.innerHTML = html
      for (var i = 0; i < sel.options.length; i++) {
        if (sel.options[i].value === bangid) { sel.selectedIndex = i; break }
      }
    })
}
function chSelCount() {
  var box = document.querySelector('.ch-songs-panel:last-of-type') || document.getElementById('ch-songs-box')
  var btns = box ? box.querySelectorAll('.ch-sel:checked') : []
  var btn = document.getElementById('ch-dl-btn')
  if (btn) {
    btn.disabled = btns.length === 0
    btn.textContent = '⬇ 下载所选（' + btns.length + '）'
  }
}
function chManualDownload(source, bangid) {
  var box = document.querySelector('.ch-songs-panel:last-of-type') || document.getElementById('ch-songs-box')
  var checks = box ? Array.from(box.querySelectorAll('.ch-sel:checked')) : []
  if (!checks.length) return
  var keys = checks.map(function (c) { return c.value })
  var msg = document.getElementById('ch-dl-msg')
  fetch('/api/charts/manual-download', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ source: source, bangid: bangid, songKeys: keys }),
  })
    .then(function (r) { return r.text() })
    .then(function (html) {
      if (msg) { msg.innerHTML = html; msg.scrollIntoView({ behavior: 'smooth', block: 'nearest' }) }
      checks.forEach(function (c) { c.checked = false })
      chSelCount()
    })
    .catch(function (e) { if (msg) msg.innerHTML = '<span class="bad">提交失败：' + e + '</span>' })
}
chLoadBoards()

// ===== 榜单订阅列表：任务运行中时显示微缩进度条（轮询 /api/progress/json）=====
var chLive = { runningId: 0, shownId: 0 }
function chPollLive() {
  fetch('/api/progress/json')
    .then(function (r) { return r.json() })
    .then(function (d) {
      var rows = document.querySelectorAll('#ch-subs-rows tr[data-task-id]')
      if (!rows.length) return
      if (d.running) {
        var row = document.querySelector('#ch-subs-rows tr[data-task-id="' + d.taskId + '"]')
        if (!row) return // 跑的不是本页的订阅（比如歌单任务），不打扰
        var cell = row.querySelector('[data-live-task]')
        if (!cell) {
          // 这一行还没渲染成"运行中" → 刷新一次列表让它显示进度条
          // （正在编辑时不刷新，免得把编辑表单冲掉）
          if (!document.querySelector('#ch-subs-rows .edit-row') && chLive.shownId !== d.taskId) {
            chLive.shownId = d.taskId
            htmx.ajax('GET', '/api/charts/subs', { target: '#ch-subs-rows' })
          }
          return
        }
        var bar = cell.querySelector('.mini-bar > i')
        if (bar) bar.style.width = d.pct + '%'
        var wrap = cell.querySelector('.mini-bar')
        if (wrap) wrap.title = '第 ' + d.done + '/' + d.total + ' 首 · ' + d.phase + (d.current ? '（' + d.current + '）' : '')
        chLive.runningId = d.taskId
      } else if (chLive.runningId) {
        // 刚刚跑完 → 刷新一次，把"运行中"换成最终结果
        chLive.runningId = 0
        chLive.shownId = 0
        if (!document.querySelector('#ch-subs-rows .edit-row')) {
          htmx.ajax('GET', '/api/charts/subs', { target: '#ch-subs-rows' })
        }
      }
    })
    .catch(function () { /* 网络抖动，下次再试 */ })
}
setInterval(chPollLive, 2500)
</script>
