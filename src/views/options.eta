<style>
  /* 音质档位药丸:勾选=品牌绿填充描边 */
  .qchip { display: inline-flex; align-items: center; gap: .35rem; padding: .18rem .7rem;
           border: 1px solid oklch(var(--bc) / .25); border-radius: 999px; font-size: .75rem;
           cursor: pointer; transition: background .15s, border-color .15s; user-select: none; }
  .qchip:hover { border-color: oklch(var(--bc) / .45); }
  .qchip:has(input:checked) { border-color: var(--sfg); background: color-mix(in oklab, var(--sfg) 16%, transparent); }
  .qchip input { margin: 0; }
</style>
<div class="space-y-4">

  <!-- ===== 页头 ===== -->
  <header>
    <div class="flex items-center gap-2 flex-wrap">
      <h2 class="text-lg font-extrabold tracking-tight">下载选项</h2>
      <span class="badge badge-ghost badge-sm font-semibold px-2 py-1">全局</span>
    </div>
  </header>

  <form method="post" action="/api/config/download" hx-post="/api/config/download" hx-target="#dl-save-msg"
        class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-4">

      <!-- 音质偏好 -->
      <section>
        <h3 class="text-xs font-bold c-sub mb-1.5">音质偏好<span class="font-normal">（按高→低依次尝试，未勾选绝不使用）</span></h3>
        <div class="flex flex-wrap gap-1.5">
          <% for (const q of qOrder) { %>
          <label class="qchip">
            <input type="checkbox" name="qualities" value="<%= q %>" <%= cfg.download.qualities.includes(q) ? 'checked' : '' %>>
            <%= qLabels[q] %>
          </label>
          <% } %>
        </div>
        <p class="text-xs c-sub mt-1.5 leading-relaxed">实际能拿到哪一档取决于音源支持（按 LX 搜索结果自动识别）；勾选范围均拿不到的歌会标记「未满足」。Atmos 系为多声道沉浸式，体积较大。</p>
      </section>

      <div class="divider my-0"></div>

      <!-- 文件命名 -->
      <section>
        <h3 class="text-xs font-bold c-sub mb-1.5">文件命名</h3>
        <div class="fg items-center">
          <label class="form-control w-full">
            <span class="label-text mb-1">命名模板（占位符：[歌手] [专辑名] [歌曲名] [音质]）</span>
            <input name="filenameTemplate" value="<%= cfg.download.filenameTemplate %>" class="input input-bordered w-full font-mono text-xs">
          </label>
          <p class="text-xs c-sub leading-relaxed">示例：后海大鲨鱼 - 心要野 (flac24bit).flac</p>
        </div>
      </section>

      <div class="divider my-0"></div>

      <!-- 写入文件信息 -->
      <section>
        <h3 class="text-xs font-bold c-sub mb-1.5">写入文件信息</h3>
        <div class="flex flex-wrap gap-x-5 gap-y-1.5">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" name="writeId3" value="1" <%= cfg.download.writeId3 ? 'checked' : '' %> class="checkbox checkbox-sm">
            <span class="text-sm">ID3 标签（标题/歌手/专辑）</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" name="writeCover" value="1" <%= cfg.download.writeCover ? 'checked' : '' %> class="checkbox checkbox-sm">
            <span class="text-sm">封面</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" name="embedLyric" value="1" <%= cfg.download.embedLyric ? 'checked' : '' %> class="checkbox checkbox-sm">
            <span class="text-sm">内嵌歌词</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" name="cacheLyric" value="1" <%= cfg.download.cacheLyric ? 'checked' : '' %> class="checkbox checkbox-sm">
            <span class="text-sm">外置歌词 (.lrc)</span>
          </label>
        </div>
      </section>

      <div class="divider my-0"></div>

      <!-- 下载行为 -->
      <section>
        <h3 class="text-xs font-bold c-sub mb-1.5">下载行为</h3>
        <div class="fg">
          <label class="form-control w-full">
            <span class="label-text mb-1">并发下载数</span>
            <input type="number" name="concurrency" value="<%= cfg.download.concurrency %>" min="1" max="10" class="input input-bordered w-28">
          </label>
          <label class="form-control w-full">
            <span class="label-text mb-1">失败自动重试次数</span>
            <input type="number" name="retries" value="<%= cfg.download.retries %>" min="0" max="5" class="input input-bordered w-28">
          </label>
        </div>
      </section>

      <div class="card-actions flex flex-wrap items-center gap-2 border-t border-base-200 pt-3">
        <button type="submit" class="btn btn-primary">保存全部设置</button>
        <span id="dl-save-msg" class="text-sm"></span>
      </div>
    </div>
  </form>

</div>
