<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SongHamster - 登录</title>
  <link rel="icon" href="/static/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/static/apple-touch-icon.png">
  <link rel="stylesheet" href="/static/pico.css">
  <script src="/static/htmx.min.js"></script>
  <style>
    :root { --pico-form-element-spacing-vertical: .2rem; --pico-form-element-spacing-horizontal: .4rem; }
    body { min-height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; }
    .login-card { width: 100%; max-width: 360px; }
    /* 品牌区：图标（放大）→ 标题 → 注释，整块居中（登录卡片的视觉中心） */
    .brand-stack { display: flex; flex-direction: column; align-items: center; gap: .5rem; margin-bottom: 1.25rem; }
    .brand-stack img { width: 76px; height: 76px; border-radius: 12px; }
    .brand-stack .t { font-weight: 800; font-size: 1.65rem; line-height: 1.1; }
    .brand-stack .s { color: #6b7280; font-size: .95rem; }
    label { margin-bottom: .15rem; }
    input {
      height: 1.45rem !important;
      min-height: 1.45rem !important;
      padding: 0 .4rem !important;
      font-size: .9em !important;
    }
    button[type="submit"] {
      width: 100% !important;
      height: 1.8rem !important;
      min-height: 1.8rem !important;
      padding: 0 !important;
      background: #000 !important;
      border-color: #000 !important;
      color: #fff !important;
      font-weight: 500 !important;
    }
    button[type="submit"]:hover { background: #222 !important; border-color: #222 !important; }
  </style>
</head>
<body>
  <div class="login-card">
    <div class="brand-stack">
      <img src="/static/icon.png" alt="SongHamster 音乐仓鼠">
      <div class="t">SongHamster</div>
      <div class="s">LX 歌单自动同步入库</div>
    </div>
    <% if (!authEnabled) { %>
      <article style="text-align:center">
        <p>当前未启用账号认证，无需登录即可访问。</p>
        <p class="hint">可在登录后的 <b>设置 → 账号安全</b> 中启用。</p>
        <a role="button" href="/sync-setup">进入系统</a>
      </article>
    <% } else { %>
      <article>
        <form method="post" action="/api/auth/login" hx-post="/api/auth/login" hx-target="#login-msg" hx-swap="innerHTML" hx-on::after-request="if(event.detail.successful){ window.location.href='/sync-setup' }">
          <label>用户名<input name="username" autocomplete="username" required></label>
          <label>密码<input type="password" name="password" autocomplete="current-password" required></label>
          <button type="submit">登 录</button>
          <p id="login-msg" style="margin-top:.5rem"></p>
        </form>
      </article>
    <% } %>
  </div>
</body>
</html>
