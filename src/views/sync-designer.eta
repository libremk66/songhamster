<style>
  /* 原型页专用:双主 tab + 子 tab */
  .dt-tab { display: inline-flex; align-items: center; gap: .4rem; padding: .35rem .95rem; font-size: .875rem;
            cursor: pointer; background: oklch(var(--b1)); color: oklch(var(--bc) / .75);
            border: 1px solid oklch(var(--bc) / .22); border-radius: 999px; transition: color .15s, border-color .15s, background .15s; }
  .dt-tab svg { width: 1em; height: 1em; }
  .dt-tab:hover { border-color: var(--sfg); color: var(--sfg-deep); }
  .dt-tab.active { background: var(--sfg); border-color: var(--sfg); color: var(--sfg-ink); font-weight: 650; }
  .dsec { border: 1px solid oklch(var(--bc) / .15); border-radius: .6rem; background: oklch(var(--b1)); }
  .drow { display: flex; align-items: flex-start; gap: .5rem; padding: .45rem .3rem; border-radius: .5rem; cursor: pointer; }
  .drow:hover { background: color-mix(in oklab, var(--sfg) 8%, transparent); }
  .dopt { display: flex; align-items: flex-start; gap: .5rem; padding: .5rem .6rem; border: 1px solid oklch(var(--bc) / .15);
          border-radius: .55rem; cursor: pointer; margin-bottom: .4rem; transition: border-color .15s, background .15s; }
  .dopt:hover { border-color: oklch(var(--bc) / .4); }
  .dopt.sel { border-color: var(--sfg); background: color-mix(in oklab, var(--sfg) 8%, transparent); }
  .dopt-title { font-weight: 600; font-size: .875rem; }
  .d-note { border-left: 3px solid var(--sfg); background: color-mix(in oklab, var(--sfg) 7%, transparent);
            padding: .5rem .7rem; border-radius: .3rem; font-size: .8125rem; }
  .d-sum { font-size: .8125rem; line-height: 1.6; }
</style>
<div class="space-y-4">

  <header>
    <div class="flex items-center gap-2 flex-wrap">
      <h2 class="text-lg font-extrabold tracking-tight">同步任务设计器</h2>
      <span class="badge badge-warning badge-sm">原型 Phase A · 引擎未接入</span>
    </div>
    <p class="text-xs c-sub mt-1">按你 09-07 的规格排布:标签1=单任务创建(选择歌单),标签2=监听同步(完全/条件增量)。所有联动可点选,仅验证交互与语义;后端行为未绑定。</p>
  </header>

  <!-- ===== 主 Tab ===== -->
  <section class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-3">
      <div class="flex flex-wrap gap-1.5">
        <button type="button" class="dt-tab active" id="dtab1" onclick="dSwitchPanel(1)"><svg aria-hidden="true"><use href="#i-swap"/></svg>标签1 · 选择歌单(创建单个任务)</button>
        <button type="button" class="dt-tab" id="dtab2" onclick="dSwitchPanel(2)"><svg aria-hidden="true"><use href="#i-pulse"/></svg>标签2 · 监听同步(自动化)</button>
      </div>

      <!-- ============ 面板1:单任务创建 ============ -->
      <div id="dp1">
        <div class="space-y-3">

          <div class="dsec p-3">
            <h3 class="text-sm font-bold mb-2">框 1 · 选择 LX 歌单(源)</h3>
            <select id="p1_src" class="select select-bordered w-full" style="max-width:22rem">
              <% for (const n of ['我喜欢的（示例 1,284 首）','华语流行（示例 420 首）','粤语经典（示例 310 首）','欧美金曲（示例 260 首）']) { %>
              <option value="<%= n %>"><%= n %></option>
              <% } %>
            </select>
            <p class="text-xs c-sub mt-1">正式版将展示 LX 全部歌单(与现在「手动新增」下拉一致)</p>
          </div>


          <div class="dsec p-3">
            <h3 class="text-sm font-bold mb-2">框 2 · 同步到 <%= targetName %> 的目标播放列表/歌单</h3>
            <label class="drow">
              <input type="checkbox" id="p1_auto" checked class="checkbox checkbox-sm" onchange="dSync('p1')">
              <span class="text-sm">同名播放列表/歌单(<b>同步时自动生成</b>)</span>
            </label>
            <label class="drow">
              <input type="checkbox" id="p1_exist" class="checkbox checkbox-sm" onchange="dSync('p1')">
              <span class="text-sm">同步到<b>已有</b>播放列表/歌单</span>
            </label>
            <div id="p1_existbox" style="display:none" class="ml-6 my-1">
              <p class="text-xs c-sub mb-1">勾选目标歌单(正式版=服务器真实列表):</p>
              <% for (const n of ['音乐·测试歌单','通勤精选','家庭聚会']) { %>
              <label class="drow" style="padding:.2rem 0"><input type="checkbox" name="p1_ex" value="<%= n %>" class="checkbox checkbox-xs" onchange="dSync('p1')"><span class="text-sm"><%= n %></span></label>
              <% } %>
              <div id="p1_exnote" class="d-note mt-2" style="display:none">🔒 镜像安全说明:勾选已有歌单时,镜像同步<b>只移除/加入本任务产生的歌曲</b>;歌单里你手动加的、以及接管前已存在的歌曲一律不动(所有权追踪)。歌单被删除时按策略自动重建或告警。</div>
            </div>
          </div>


          <div class="dsec p-3">
            <h3 class="text-sm font-bold mb-2">框 3 · 同步方式</h3>
            <div class="space-y-1.5">
              <label class="dopt" id="p1_opt_inc" onclick="dPick('p1','inc')">
                <input type="radio" name="p1_mode" value="inc" checked class="radio radio-sm" onchange="dSync('p1')">
                <span><span class="dopt-title">1 · 增量同步</span><br><span class="text-xs c-sub">LX 歌单新增 → 同步到 <%= targetName %>;LX 删除<b>不</b>同步,服务器该歌单只增不减</span></span>
              </label>
              <label class="dopt" id="p1_opt_mirror" onclick="dPick('p1','mirror')">
                <input type="radio" name="p1_mode" value="mirror" class="radio radio-sm" onchange="dSync('p1')">
                <span><span class="dopt-title">2 · 镜像同步</span><br><span class="text-xs c-sub">LX 增/删都会同步到 <%= targetName %>(双向看齐)</span></span>
              </label>
            </div>

            <div id="p1_delbox" style="display:none" class="mt-2">
              <h4 class="text-xs font-bold c-sub mb-1.5">镜像同步 · LX 端删除时,歌单/歌曲的处理方式:</h4>
              <label class="drow"><input type="radio" name="p1_del" value="keep" checked class="radio radio-sm" onchange="dSync('p1')"><span class="text-sm"><b>处理1</b> 歌曲从播放列表移除 + 媒体库文件不删(最安全,默认)</span></label>
              <label class="drow"><input type="radio" name="p1_del" value="delete" class="radio radio-sm" onchange="dSync('p1')"><span class="text-sm"><b>处理2</b> 歌单移除 + 删除文件(仅映射目录内;道理鱼/Subsonic 不可用将置灰)</span></label>
              <label class="drow"><input type="radio" name="p1_del" value="archive" class="radio radio-sm" onchange="dSync('p1')"><span class="text-sm"><b>处理3</b> 从本歌单移除 + 移入归档歌单:<input id="p1_arch" class="input input-bordered input-sm mx-1" style="width:12rem" value="歌单同步任务归档"></span></label>
            </div>
          </div>


          <div class="dsec p-3">
            <h3 class="text-sm font-bold mb-2">框 4 · 定时 cron(空=仅手动)</h3>
            <div class="flex flex-wrap items-center gap-2">
              <input id="p1_cron" class="input input-bordered font-mono text-xs" style="width:12rem" value="0 6 * * *" placeholder="0 6 * * *">
              <span class="text-xs c-sub">分 时 日 月 周 · 默认每天 06:00</span>
            </div>
          </div>

          <div class="d-note d-sum" id="p1_sum">—</div>
          <div class="card-actions border-t border-base-200 pt-3">
            <button type="button" class="btn btn-primary" onclick="alert('原型阶段:引擎未接入,确认语义后接入')"><svg aria-hidden="true"><use href="#i-save"/></svg>保存为真实任务(原型)</button>
            <span class="text-xs c-sub">此按钮原型期不生效</span>
          </div>
        </div>
      </div>

      <!-- ============ 面板2:监听同步 ============ -->
      <div id="dp2" style="display:none">
        <div class="flex items-center gap-3 flex-wrap mb-2">
          <div class="flex flex-wrap gap-1.5">
            <button type="button" class="dt-tab active" id="dsub1" onclick="dSwitchSub(1)"><svg aria-hidden="true"><use href="#i-sync"/></svg>子标签1 · 完全同步(所有歌单)</button>
            <button type="button" class="dt-tab" id="dsub2" onclick="dSwitchSub(2)"><svg aria-hidden="true"><use href="#i-listSearch"/></svg>子标签2 · 条件增量同步(规则筛选)</button>
          </div>
          <label class="flex items-center gap-2 cursor-pointer ml-auto">
            <span class="text-sm font-semibold">监听总开关</span>
            <input type="checkbox" id="p_master" checked class="checkbox checkbox-sm" onchange="dMaster()">
          </label>
        </div>
        <div id="d_excl" class="d-note mb-3" style="display:none;border-left-color:#f59e0b;background:color-mix(in oklab,#f59e0b 8%,transparent)">
          ⚠️ <b>完全同步与条件增量互斥</b>:两者监听同一事件源(LX 新歌单),不能并存——开启其中一种会<b>自动关闭另一种</b>。
          已由旧模式自动创建的任务<b>保持运行</b>,不会自动暂停或删除;如需停用请到任务列表手动操作(正式版会提供「一键停用旧模式任务 N 个」入口)。
        </div>

        <!-- 子1 完全同步 -->
        <div id="dsp1" class="space-y-3">
          <div class="dsec p-3">
            <label class="drow"><input type="checkbox" id="p2_enable" checked class="checkbox checkbox-sm" onchange="dSubEnable('p2')"><span class="text-sm font-semibold">启用(完全同步模式)</span></label>
            <p class="text-xs c-sub mt-1">将现有所有歌单及将来新增的歌单全部自动同步;首次启用自动记录当前 LX 歌单为基线,之后新出现的歌单立即建任务。</p>
            <div class="flex flex-wrap items-center gap-2 mt-2">
              <span class="text-sm">检测计划 cron</span><input id="p2_check" class="input input-bordered font-mono text-xs" style="width:10rem" value="0 7 * * *">
            </div>
          </div>
          <div class="dsec p-3">
            <h3 class="text-sm font-bold mb-2">目标播放列表/歌单</h3>
            <label class="drow"><input type="checkbox" id="p2_auto" checked class="checkbox checkbox-sm" onchange="dSync('p2')"><span class="text-sm">同名播放列表/歌单(自动生成)</span></label>
            <label class="drow"><input type="checkbox" id="p2_exist" class="checkbox checkbox-sm" onchange="dSync('p2')"><span class="text-sm">同步到已有播放列表/歌单</span></label>
            <div id="p2_existbox" style="display:none" class="ml-6 mt-1">
              <% for (const n of ['通勤精选','家庭聚会']) { %>
              <label class="drow" style="padding:.2rem 0"><input type="checkbox" name="p2_ex" value="<%= n %>" class="checkbox checkbox-xs" onchange="dSync('p2')"><span class="text-sm"><%= n %></span></label>
              <% } %>
            </div>
          </div>
          <div class="dsec p-3">
            <h3 class="text-sm font-bold mb-2">同步方式(全监听默认)</h3>
            <div class="space-y-1.5">
              <label class="dopt" onclick="dPick('p2','inc')"><input type="radio" name="p2_mode" value="inc" checked class="radio radio-sm" onchange="dSync('p2')"><span><span class="dopt-title">增量</span><br><span class="text-xs c-sub">只增不减,服务器歌单只会越来越多</span></span></label>
              <label class="dopt" onclick="dPick('p2','mirror')"><input type="radio" name="p2_mode" value="mirror" class="radio radio-sm" onchange="dSync('p2')"><span><span class="dopt-title">镜像</span><br><span class="text-xs c-sub">增删都同步</span></span></label>
            </div>
            <div id="p2_delbox" style="display:none" class="mt-2">
              <h4 class="text-xs font-bold c-sub mb-1">LX 端删除时处理方式:</h4>
              <label class="drow"><input type="radio" name="p2_del" value="keep" checked class="radio radio-sm" onchange="dSync('p2')"><span class="text-sm"><b>处理1</b> 歌单移除 + 文件不删</span></label>
              <label class="drow"><input type="radio" name="p2_del" value="delete" class="radio radio-sm" onchange="dSync('p2')"><span class="text-sm"><b>处理2</b> 歌单移除 + 删除文件(能力受限置灰)</span></label>
              <label class="drow"><input type="radio" name="p2_del" value="archive" class="radio radio-sm" onchange="dSync('p2')"><span class="text-sm"><b>处理3</b> 移入归档歌单:<input id="p2_arch" class="input input-bordered input-sm mx-1" style="width:11rem" value="歌单同步任务归档"></span></label>
            </div>
            <div class="flex flex-wrap items-center gap-2 mt-2 pt-2 border-t border-base-200">
              <span class="text-sm">新任务定时 cron(空=建后立即一次)</span><input id="p2_taskcron" class="input input-bordered font-mono text-xs" style="width:11rem" value="0 6 * * *">
            </div>
          </div>
          <div class="d-note d-sum" id="p2_sum">—</div>
        </div>

        <!-- 子2 条件增量 -->
        <div id="dsp2" style="display:none" class="space-y-3">
          <div class="dsec p-3">
            <label class="drow"><input type="checkbox" id="p2b_enable" class="checkbox checkbox-sm" onchange="dSubEnable('p2b')"><span class="text-sm font-semibold">启用(条件增量模式)</span></label>
            <p class="text-xs c-sub mt-1">按规则筛选「哪些 LX 歌单值得自动同步」;规则变更只影响之后新出现的歌单,已建任务不回溯。</p>
          </div>
          <div class="dsec p-3">
            <h3 class="text-sm font-bold mb-2">框 1 · 规则筛选</h3>
            <label class="drow"><input type="checkbox" id="p2b_exOn" class="checkbox checkbox-sm" onchange="dSync('p2b')"><span class="text-sm font-semibold">排除</span><span class="text-xs c-sub">(命中以下条件则<b>不同步</b>:)</span></label>
            <div id="p2b_exbox" style="display:none" class="ml-7 mb-1">
              <div class="flex flex-wrap items-center gap-2 my-1">
                <select id="p2b_exSel" class="select select-bordered select-sm" style="width:15rem" onchange="dSync('p2b')"><option value="">选择现有歌单…</option><option>华语流行</option><option>粤语经典</option></select>
                <input id="p2b_exKw" class="input input-bordered input-sm" style="width:13rem" placeholder="或输入歌单名关键词,逗号分隔" oninput="dSync('p2b')">
              </div>
            </div>
            <label class="drow"><input type="checkbox" id="p2b_inOn" class="checkbox checkbox-sm" onchange="dSync('p2b')"><span class="text-sm font-semibold">匹配</span><span class="text-xs c-sub">(命中以下条件则<b>同步</b>:)</span></label>
            <div id="p2b_inbox" style="display:none" class="ml-7 mb-1">
              <div class="flex flex-wrap items-center gap-2 my-1">
                <select id="p2b_inSel" class="select select-bordered select-sm" style="width:15rem" onchange="dSync('p2b')"><option value="">选择现有歌单…</option><option>我喜欢的</option><option>欧美金曲</option></select>
                <input id="p2b_inKw" class="input input-bordered input-sm" style="width:13rem" placeholder="或输入歌单名关键词" oninput="dSync('p2b')">
              </div>
            </div>
            <p class="text-xs c-sub mt-1">规则语义(原型):同时启用时「匹配」为白名单、「排除」优先剔除;只开匹配=仅同步命中项;只开排除=全量减排除项。</p>
          </div>
          <div class="dsec p-3">
            <h3 class="text-sm font-bold mb-2">目标 / 同步方式 / 定时</h3>
            <div class="flex flex-wrap gap-4">
              <label class="drow"><input type="checkbox" id="p2b_auto" checked class="checkbox checkbox-sm" onchange="dSync('p2b')"><span class="text-sm">同名自动生成</span></label>
              <label class="drow"><input type="checkbox" id="p2b_exist" class="checkbox checkbox-sm" onchange="dSync('p2b')"><span class="text-sm">已有播放列表</span></label>
            </div>
            <div class="space-y-1.5 mt-1">
              <label class="dopt" onclick="dPick('p2b','inc')"><input type="radio" name="p2b_mode" value="inc" checked class="radio radio-sm" onchange="dSync('p2b')"><span><span class="dopt-title">增量</span><span class="text-xs c-sub"> 只增不减</span></span></label>
              <label class="dopt" onclick="dPick('p2b','mirror')"><input type="radio" name="p2b_mode" value="mirror" class="radio radio-sm" onchange="dSync('p2b')"><span><span class="dopt-title">镜像</span><span class="text-xs c-sub"> 增删同步</span></span></label>
            </div>
            <div id="p2b_delbox" style="display:none" class="mt-2">
              <label class="drow"><input type="radio" name="p2b_del" value="keep" checked class="radio radio-sm" onchange="dSync('p2b')"><span class="text-sm"><b>处理1</b> 歌单移除+文件不删</span></label>
              <label class="drow"><input type="radio" name="p2b_del" value="delete" class="radio radio-sm" onchange="dSync('p2b')"><span class="text-sm"><b>处理2</b> 歌单移除+删除文件(受限置灰)</span></label>
              <label class="drow"><input type="radio" name="p2b_del" value="archive" class="radio radio-sm" onchange="dSync('p2b')"><span class="text-sm"><b>处理3</b> 移入归档:<input id="p2b_arch" class="input input-bordered input-sm mx-1" style="width:11rem" value="歌单同步任务归档"></span></label>
            </div>
            <div class="flex flex-wrap items-center gap-2 mt-2">
              <span class="text-sm">检测 cron</span><input id="p2b_check" class="input input-bordered font-mono text-xs" style="width:10rem" value="0 7 * * *">
              <span class="text-sm">任务 cron(空=立即一次)</span><input id="p2b_taskcron" class="input input-bordered font-mono text-xs" style="width:10rem" value="0 6 * * *">
            </div>
          </div>
          <div class="d-note d-sum" id="p2b_sum">—</div>
        </div>
      </div>

    </div>
  </section>
</div>

<script>
// ===== 原型交互:纯前端状态联动 =====
function dSwitchPanel(n) {
  document.getElementById('dp1').style.display = n === 1 ? '' : 'none'
  document.getElementById('dp2').style.display = n === 2 ? '' : 'none'
  document.getElementById('dtab1').classList.toggle('active', n === 1)
  document.getElementById('dtab2').classList.toggle('active', n === 2)
  if (n === 2) dBanner()
  dSync('p1'); dSync('p2'); dSync('p2b')
}
function dSwitchSub(n) {
  document.getElementById('dsp1').style.display = n === 1 ? '' : 'none'
  document.getElementById('dsp2').style.display = n === 2 ? '' : 'none'
  document.getElementById('dsub1').classList.toggle('active', n === 1)
  document.getElementById('dsub2').classList.toggle('active', n === 2)
  dSync('p2'); dSync('p2b')
}
// ===== 监听器(单实例,模式互斥)+ A+C 任务策略 =====
// 原型模拟数据:各模式自动创建的任务数与暂停数(正式版来自 origin 标记)
var dT = { all: { made: 3, paused: 0 }, filtered: { made: 2, paused: 0 }, active: 'all' }
function dBanner() {
  var a = document.getElementById('p2_enable').checked
  var b = document.getElementById('p2b_enable').checked
  var el = document.getElementById('d_excl')
  if (a && b) { b = false; document.getElementById('p2b_enable').checked = false }
  var mode = a ? 'all' : (b ? 'filtered' : null)
  el.innerHTML = ''
  if (!document.getElementById('p_master').checked) {
    el.innerHTML = '⏸️ 监听总开关已关闭:不会自动为新歌单建任务,已建任务照常运行。'
    el.style.display = ''; return
  }
  if (!mode) { el.innerHTML = '⚠️ 尚未启用任何模式——监听开启但不会自动建任务(选择下面一种模式启用)。'; el.style.display = ''; return }
  dT.active = mode
  var m = dT[mode]
  el.innerHTML = '✅ 当前模式:<b>' + (mode === 'all' ? '完全同步(对所有 LX 歌单生效)' : '条件增量同步(仅规则命中歌单)') + '</b>。两模式互斥,切换只影响<b>之后新出现</b>的歌单;已有任务默认保持运行,不会被自动暂停或删除。'
  if (m.paused > 0) {
    var line = document.createElement('span')
    line.className = 'flex items-center gap-2 mt-1.5 flex-wrap'
    line.innerHTML = '💤 本模式有 <b>' + m.paused + '</b> 个任务处于「切换时暂停」状态:'
    var rb = document.createElement('button')
    rb.type = 'button'; rb.className = 'btn btn-outline btn-xs px-2'; rb.textContent = '恢复它们'
    rb.onclick = function () { dResume(mode) }
    line.appendChild(rb)
    el.appendChild(line)
  }
  el.style.display = ''
}
function dSubEnable(p) {
  var self = document.getElementById(p + '_enable')
  var newMode = p === 'p2' ? 'all' : 'filtered'   // 页面前缀 → 模式键
  if (self.checked) {
    document.getElementById('p_master').checked = true
    var other = p === 'p2' ? 'p2b' : 'p2'
    document.getElementById(other + '_enable').checked = false
    var oldMode = dT.active
    if (oldMode && oldMode !== newMode) {
      if (dT[newMode].paused > 0) dBanner()                    // 切回的模式自己带暂停任务 → 直接给恢复
      else if (dT[oldMode].made - dT[oldMode].paused > 0) dAsk(newMode, oldMode)  // 旧模式还有运行中的任务 → 询问
      else { dT.active = newMode; dBanner() }
    } else { dT.active = newMode; dBanner() }
  } else { dBanner() }
  dSync(p); dSync(p === 'p2' ? 'p2b' : 'p2')
}
function dAsk(newMode, oldMode) {
  var m = dT[oldMode]
  var el = document.getElementById('d_excl')
  el.innerHTML = '🔄 从「' + (oldMode === 'all' ? '完全同步' : '条件增量') + '」切到「' + (newMode === 'all' ? '完全同步' : '条件增量') + '」:<br>' +
    '旧模式已自动创建 <b>' + (m.made - m.paused) + '</b> 个任务。切换只影响之后新出现的歌单——这些任务如何处理?<br>'
  var bar = document.createElement('span')
  bar.className = 'flex gap-2 mt-1.5'
  function mkBtn(txt, cls, fn) {
    var b = document.createElement('button')
    b.type = 'button'; b.className = cls; b.textContent = txt; b.onclick = fn
    bar.appendChild(b)
  }
  mkBtn('保持运行(默认,推荐)', 'btn btn-primary btn-xs', function () { dPolicy('keep', oldMode, newMode) })
  mkBtn('暂停旧模式任务', 'btn btn-outline btn-xs', function () { dPolicy('pause', oldMode, newMode) })
  el.appendChild(bar)
  el.style.display = ''
}
function dPolicy(choice, oldMode, newMode) {
  if (choice === 'pause') dT[oldMode].paused = dT[oldMode].made
  dT.active = newMode
  var el = document.getElementById('d_excl')
  el.innerHTML = choice === 'pause'
    ? '⏸️ 已暂停旧「' + (oldMode === 'all' ? '完全同步' : '条件增量') + '」自动创建的 ' + dT[oldMode].made + ' 个任务(可随时恢复,未删除任何任务)。当前模式:「' + (newMode === 'all' ? '完全同步' : '条件增量') + '」已生效。'
    : '✅ 已保持旧模式任务运行。当前模式:「' + (newMode === 'all' ? '完全同步' : '条件增量') + '」已生效——只影响之后新出现的歌单。'
}
function dResume(mode) {
  dT[mode].paused = 0
  dBanner()
}
function dMaster() {
  var on = document.getElementById('p_master').checked
  if (!on) { document.getElementById('p2_enable').checked = false; document.getElementById('p2b_enable').checked = false }
  dBanner()
  dSync('p2'); dSync('p2b')
}

function dSum(p) {
  var sum = document.getElementById(p + '_sum')
  if (!sum) return
  var parts = []
  if (p === 'p1') parts.push('LX 歌单:【' + (document.getElementById('p1_src').value || '未选') + '】')
  var tg = []
  if (document.getElementById(p + '_auto').checked) tg.push('同名自动生成')
  var exN = Array.prototype.filter.call(document.querySelectorAll('input[name="' + p + '_ex"]:checked'), function (c) { return c.checked }).length
  if (document.getElementById(p + '_exist').checked) tg.push('已有播放列表(已勾 ' + exN + ' 个)')
  parts.push('目标:' + (tg.length ? tg.join(' + ') : '⚠ 未选目标'))
  var m = (document.querySelector('input[name="' + p + '_mode"]:checked') || {}).value || ''
  if (m === 'inc') parts.push('方式:增量(只增不减)')
  else if (m === 'mirror') {
    var del = (document.querySelector('input[name="' + p + '_del"]:checked') || {}).value
    var delTxt = { keep: '处理1 歌单移除+文件不删', delete: '处理2 歌单移除+删除文件', archive: '处理3 移入归档【' + ((document.getElementById(p + '_arch') || {}).value || '') + '】' }[del]
    parts.push('方式:镜像 ⇄ LX 看齐')
    parts.push('删除时:' + (delTxt || '未选删除策略 ⚠'))
  }
  if (p !== 'p1') parts.push('监听' + (document.getElementById(p + '_enable').checked ? '开' : '关'))
  if (p === 'p2b') {
    var rules = []
    if (document.getElementById('p2b_exOn').checked) rules.push('排除:' + (document.getElementById('p2b_exSel').value || '关键词:' + (document.getElementById('p2b_exKw').value || '空')))
    if (document.getElementById('p2b_inOn').checked) rules.push('匹配:' + (document.getElementById('p2b_inSel').value || '关键词:' + (document.getElementById('p2b_inKw').value || '空')))
    parts.push('规则:' + (rules.length ? rules.join(' 且 ') : '未启用规则 ⚠'))
  }
  sum.innerHTML = '📋 <b>' + (p === 'p1' ? '将创建任务' : p === 'p2' ? '完全同步监听' : '条件增量监听') + '</b>: ' + parts.join(' ｜ ')
}
function dPick(p, mode) {
  var r = document.querySelector('input[name="' + p + '_mode"][value="' + mode + '"]')
  if (r) r.checked = true
  dSync(p)
}
function dSync(p) {
  if (p !== 'p1' && !document.getElementById(p + '_enable').checked) { dSum(p); return }
  var exBox = document.getElementById(p + '_existbox')
  if (exBox) exBox.style.display = document.getElementById(p + '_exist').checked ? '' : 'none'
  var exNote = document.getElementById(p + '_exnote')
  if (exNote) exNote.style.display = (document.getElementById(p + '_exist').checked && document.querySelector('input[name="' + p + '_mode"][value="mirror"]').checked) ? '' : 'none'
  if (p === 'p2b') {
    document.getElementById('p2b_exbox').style.display = document.getElementById('p2b_exOn').checked ? '' : 'none'
    document.getElementById('p2b_inbox').style.display = document.getElementById('p2b_inOn').checked ? '' : 'none'
  }
  var sel = (document.querySelector('input[name="' + p + '_mode"]:checked') || {}).value
  var oi = document.getElementById(p + '_opt_inc'), om = document.getElementById(p + '_opt_mirror')
  if (oi) oi.classList.toggle('sel', sel === 'inc')
  if (om) om.classList.toggle('sel', sel === 'mirror')
  var delBox = document.getElementById(p + '_delbox')
  if (delBox) delBox.style.display = sel === 'mirror' ? '' : 'none'
  dSum(p)
}
dBanner(); dSync('p1'); dSync('p2'); dSync('p2b')
</script>
