<div class="space-y-4">

  <!-- ===== 页头 ===== -->
  <header>
    <div class="flex items-center gap-2 flex-wrap">
      <h2 class="text-lg font-extrabold tracking-tight">任务进度</h2>
      <span class="badge badge-outline badge-sm font-normal px-2 py-1 text-xs">每 3 秒自动刷新</span>
    </div>
  </header>

  <div id="progress-area" hx-get="/api/progress/table" hx-trigger="load, every 3s" hx-swap="innerHTML">
    <p class="c-sub text-xs py-10 text-center">加载中…</p>
  </div>

</div>
