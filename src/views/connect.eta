<style>
  .fg { display: grid; grid-template-columns: 1fr; gap: .75rem 1.25rem; }
  @media (min-width: 768px) { .fg { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  /* 媒体服务器选项卡：绿条旁的小胶囊；选中=白底 */
  .conn-tab { display: inline-flex; align-items: center; gap: .3rem; padding: .28rem .7rem; font-size: .8125rem;
              cursor: pointer; border-radius: 999px; border: 1px solid oklch(var(--bc) / .22);
              background: oklch(var(--b1)); color: oklch(var(--bc) / .78); transition: background .15s, border-color .15s, color .15s; }
  .conn-tab:hover { border-color: var(--sfg); color: var(--sfg-deep); }
  .conn-tab.on { background: oklch(var(--b1)); border-color: var(--sfg); color: var(--sfg-deep); font-weight: 650; }
  /* 选项卡上的"当前同步目标"小圆点 */
  .conn-dot { width: .4rem; height: .4rem; border-radius: 999px; background: var(--sfg); display: inline-block; }
  /* 绿条上的按钮（确定）：主题绿底 + 白字，与选项卡同高同字号 */
  .btn-invert { height: 1.875rem; min-height: 1.875rem; font-size: .8125rem; padding-left: .8rem; padding-right: .8rem;
                background: var(--sfg); border-color: var(--sfg); color: #fff; font-weight: 700; }
  .btn-invert:hover, .btn-invert:focus-visible { background: oklch(0.62 0.12 153); border-color: oklch(0.62 0.12 153); color: #fff; }
  /* 整体双栏布局:左 250 列表 + 右表单(≥1024),小屏堆叠 */
  .lxg { display: grid; gap: 1rem; align-items: start; }
  @media (min-width: 1024px) { .lxg { grid-template-columns: 250px minmax(0, 1fr); } }
  /* 输入框顶部 margin 归零(部分字段在 join 中、部分裸排导致行内错位 4px) */
  .fg .form-control > input, .fg .form-control .input { margin-top: 0; }
</style>
<div class="space-y-4">

  <!-- ===== 页头 ===== -->
  <header>
    <div class="flex items-center gap-2 flex-wrap">
      <h2 class="text-lg font-extrabold tracking-tight">连接容器</h2>
    </div>
  </header>

  <!-- ===== 1. LX 下载源 ===== -->
  <form method="post" action="/api/config/lx" hx-post="/api/config/lx" hx-target="#lx-save-msg"
        class="card tier1 border border-base-300 shadow-sm">
    <div class="card-body gap-3.5">
      <h3 class="sec-green">连接 LXSyncServer</h3>
      <div class="rounded-lg border border-base-300 p-3">
      <div class="fg">
        <label class="form-control w-full">
          <span class="label-text mb-1">服务地址</span>
          <input name="baseUrl" value="<%= cfg.lxserver.baseUrl %>" placeholder="http://127.0.0.1:19527" class="input input-bordered w-full">
        </label>
        <label class="form-control w-full">
          <span class="label-text mb-1">API key</span>
          <div class="join w-full">
            <input type="password" name="apiKey" id="lx-key" value="<%= cfg.lxserver.apiKey %>" autocomplete="off" class="input input-bordered join-item w-full">
            <button type="button" class="btn btn-outline join-item px-3" onclick="toggleKey('lx-key', this)" title="显示/隐藏"><svg aria-hidden="true"><use href="#i-eye"/></svg></button>
          </div>
        </label>
        <label class="form-control w-full">
          <span class="label-text mb-1">下载用户名（x-user-name）</span>
          <input name="username" value="<%= cfg.lxserver.username %>" placeholder="king" class="input input-bordered w-full">
        </label>
        <label class="form-control w-full">
          <span class="label-text mb-1">LX 下载目录<span class="text-error">*</span></span>
          <input name="downloadRoot" value="<%= cfg.lxserver.downloadRoot %>" placeholder="容器部署: /data/music；本机直跑: 宿主机路径" class="input input-bordered w-full">
          <span class="text-xs c-sub mt-1">本项目视角路径（本项目要读写它）</span>
        </label>
      </div>
      </div>
      <div class="card-actions flex flex-wrap items-center gap-2 border-t border-base-200 pt-4">
        <button type="submit" class="btn btn-primary"><svg aria-hidden="true"><use href="#i-save"/></svg>保存配置</button>
        <button type="button" class="btn btn-outline" hx-post="/api/test/lx" hx-target="#lx-test-result"><svg aria-hidden="true"><use href="#i-plug"/></svg>测试连接</button>
        <span id="lx-test-result" class="text-sm min-w-44"></span>
        <span id="lx-save-msg" class="text-sm w-full md:w-auto"></span>
      </div>
    </div>
  </form>

  <!-- ===== 连接媒体服务器（选项卡切类型 + 确定一键「存→测→探测→设为目标」） ===== -->
  <div id="conn-section" hx-get="/api/connect/section" hx-trigger="load" hx-swap="outerHTML">
    <p class="c-sub text-xs py-8 text-center">加载中…</p>
  </div>
  <div id="conn-msg" class="text-sm"></div>

  <!-- ===== 路径自检 ===== -->
  <section class="card tier1 border border-base-300 shadow-sm">
    <div class="card-body gap-4">
      <div class="flex flex-wrap items-center gap-2">
        <h3 class="sec-green flex-1" style="margin-bottom:0">路径自检</h3>
        <button type="button" class="btn btn-outline" hx-post="/api/paths/check" hx-target="#paths-result" hx-swap="innerHTML"><svg aria-hidden="true"><use href="#i-pulse"/></svg>运行自检</button>
      </div>
      <div class="rounded-lg border border-base-300 p-3">
        <p class="text-xs c-sub">检查下载目录可写、媒体库匹配情况，并给出路径关系提示</p>
        <div id="paths-result" class="text-sm mt-2 min-h-10"></div>
      </div>
    </div>
  </section>

</div>

<script>
// 连接媒体服务器：切换选项卡 = 切换要配置的服务器；点「确定」才保存并切换同步目标
function toggleKey(id, btn) {
  var el = document.getElementById(id)
  var u = btn.querySelector('use')
  if (el.type === 'password') { el.type = 'text'; if (u) u.setAttribute('href', '#i-eyeOff') }
  else { el.type = 'password'; if (u) u.setAttribute('href', '#i-eye') }
}
</script>
