<style>
  /* 本页 tab(创建/监听)与模式分段 */
  /* .sec-green / .tier1 已上移到 render.ts 共享块(榜单订阅页同源) */
  /* 子标签:胶囊,未选中白底/选中绿底(全站无直角) */
  .st-tab { display: inline-flex; align-items: center; gap: .4rem; padding: .35rem .95rem; font-size: .875rem;
            cursor: pointer; background: oklch(var(--b1)); color: oklch(var(--bc) / .75);
            border: 1px solid oklch(var(--bc) / .22); border-radius: 999px; transition: color .15s, border-color .15s, background .15s; }
  .st-tab svg { width: 1em; height: 1em; }
  .st-tab:hover { border-color: var(--sfg); color: var(--sfg-deep); }
  .st-tab.active { background: var(--sfg-fill); border-color: var(--sfg-fill); color: #fff; font-weight: 650; }
  .dopt { display: flex; align-items: flex-start; gap: .5rem; padding: .5rem .6rem; border: 1px solid oklch(var(--bc) / .15);
          border-radius: .55rem; cursor: pointer; margin-bottom: .4rem; transition: border-color .15s, background .15s; }
  .dopt:hover { border-color: oklch(var(--bc) / .4); }
  .dopt.sel { border-color: var(--sfg); background: color-mix(in oklab, var(--sfg) 8%, transparent); }
  .dopt-title { font-weight: 600; font-size: .875rem; }
  .d-note { border-left: 3px solid var(--sfg); background: color-mix(in oklab, var(--sfg) 7%, transparent);
            padding: .5rem .7rem; border-radius: .3rem; font-size: .8125rem; }
  /* 内层小框:白底 + 轻阴影(在浅灰一级框上形成层次) */
  .rounded-lg.border, .dopt { background: oklch(var(--b1)); box-shadow: 0 1px 3px oklch(var(--bc) / 0.12); }
  /* 紧凑标题行:子元素统一去 margin、垂直居中(修正 pico 按钮外距与 h4 默认边距的错位) */
  .lxhead { display: flex; align-items: center; gap: .5rem; margin-bottom: .5rem; }
  .lxhead > * { margin-top: 0; margin-bottom: 0; }
  .lxhead h4, .lxhead span { display: inline-flex; align-items: center; }
  .lxhead .btn { margin: 0; }
  /* 监听摘要表格行 */
  .sumcell { border-left: 1px solid oklch(var(--bc) / 0.12); padding: .45rem .85rem; }
  .sumcell:first-child { border-left: 0; }
  .sumlabel { font-size: .7rem; color: oklch(var(--bc) / 0.6); white-space: nowrap; }
  .sumcell > span:last-child { white-space: nowrap; }
  /* 监听摘要框:主题绿柔光 */
  /* 监听摘要框:橙色外框、无阴影 */
  .rounded-lg.border.sum-glow { border-color: #f59e0b; box-shadow: none; }
</style>
<div class="space-y-4">

  <!-- ===== 页头 ===== -->
  <header>
    <div class="flex items-center gap-2 flex-wrap">
      <h2 class="text-lg font-extrabold tracking-tight">歌单同步</h2>
    </div>
  </header>

  <!-- ===== 我的歌单同步任务 ===== -->
  <section class="card tier1 border border-base-300 shadow-sm">
    <div class="card-body gap-3">
      <h3 class="sec-green">我的歌单同步任务</h3>
      <div class="rounded-lg border border-base-300 overflow-x-auto mb-2 sum-glow">
        <div class="flex min-w-max divide-x divide-base-200">
          <div class="sumcell flex flex-col justify-center gap-0.5">
            <span class="sumlabel">监听</span>
            <span class="flex items-center gap-1"><span class="icv <%= listen.enabled ? 'icv-on' : 'icv-off' %>"><svg aria-hidden="true"><use href="#i-<%= listen.enabled ? 'check' : 'x' %>"/></svg></span><b><%= listen.enabled ? '启用' : '停用' %></b></span>
          </div>
          <div class="sumcell flex flex-col justify-center gap-0.5">
            <span class="sumlabel">模式</span><span><b><%= listen.activeMode === 'all' ? '完全同步' : '条件增量' %></b></span>
          </div>
          <div class="sumcell flex flex-col justify-center gap-0.5">
            <span class="sumlabel">检测 cron</span><span class="font-mono text-xs"><%= listen.checkCron %></span>
          </div>
          <% if (listen.activeMode === 'filtered') { %>
          <div class="sumcell flex flex-col justify-center gap-0.5">
            <span class="sumlabel">排除</span><span><%= listen.filtered.rules.exclude.enabled ? (listen.filtered.rules.exclude.keywords.join('、') || '歌单规则') : '—' %></span>
          </div>
          <div class="sumcell flex flex-col justify-center gap-0.5">
            <span class="sumlabel">匹配</span><span><%= listen.filtered.rules.match.enabled ? (listen.filtered.rules.match.keywords.join('、') || '歌单规则') : '—' %></span>
          </div>
          <% } else { %>
          <div class="sumcell flex flex-col justify-center gap-0.5">
            <span class="sumlabel">规则</span><span>—</span>
          </div>
          <% } %>
          <div class="sumcell flex flex-col justify-center gap-0.5">
            <span class="sumlabel">同名新建</span><span><%= (listen.activeMode === 'all' ? listen.all : listen.filtered.params).createSameNamePlaylist ? '是' : '否' %></span>
          </div>
          <div class="sumcell flex flex-col justify-center gap-0.5">
            <span class="sumlabel">已有歌单</span><span><%= (listen.activeMode === 'all' ? listen.all : listen.filtered.params).embyTargetPlaylistIds.length %> 个</span>
          </div>
          <div class="sumcell flex flex-col justify-center gap-0.5">
            <span class="sumlabel">方式</span><span><%= (listen.activeMode === 'all' ? listen.all : listen.filtered.params).taskMode === 'mirror' ? '镜像' : '增量' %></span>
          </div>
          <div class="sumcell flex flex-col justify-center gap-0.5">
            <span class="sumlabel">删除处理</span><span><% if ((listen.activeMode === 'all' ? listen.all : listen.filtered.params).taskMode !== 'mirror') { %>—<% } else { %><%= (listen.activeMode === 'all' ? listen.all : listen.filtered.params).delPolicy === 'delete' ? '处理2 删文件' : (listen.activeMode === 'all' ? listen.all : listen.filtered.params).delPolicy === 'archive' ? '处理3 归档' : '处理1 不删' %><% } %></span>
          </div>
          <div class="sumcell flex flex-col justify-center gap-0.5">
            <span class="sumlabel">归档歌单</span><span><%= (listen.activeMode === 'all' ? listen.all : listen.filtered.params).archivePlaylist %><% if (String((listen.activeMode === 'all' ? listen.all : listen.filtered.params).archivePlaylist).includes('[歌单名]')) { %><span class="text-xs c-sub"> (按来源)</span><% } %></span>
          </div>
          <div class="sumcell flex flex-col justify-center gap-0.5">
            <span class="sumlabel">任务 cron</span><span><%= (listen.activeMode === 'all' ? listen.all : listen.filtered.params).taskCron || '空' %></span>
          </div>
        </div>
      </div>

      <div id="task-table" class="overflow-x-auto" hx-get="/api/tasks/table?scope=playlist" hx-trigger="load">
        <p class="c-sub text-xs py-6 text-center">加载中…</p>
      </div>
      <div id="task-msg" class="text-sm"></div>

      <!-- 删除任务确认（含「永久忽略该歌单」） -->
      <style>
        /* 不用 daisy 的 .modal-backdrop 表单兜底：pico 桥会把其中的 button 涂成蓝色大块 */
        #del-dlg::backdrop, #incl-dlg::backdrop { background: oklch(0 0 0 / .45); }
      </style>
      <%~ delDialog %>

      <!-- 「包含现有歌单」二次确认：勾选=一次性批量建任务，不能悄悄发生 -->
      <dialog id="incl-dlg" class="modal">
        <div class="modal-box max-w-md">
          <h3 class="text-base font-bold">纳入现有歌单</h3>
          <p class="text-sm mt-2">保存后将为 <b id="incl-dlg-n">0</b> 个现有歌单创建同步任务，并立即开始排队下载。</p>
          <p class="text-xs c-sub mt-2">任务按「完全模式 · 新任务默认设置」创建。取消勾选不会删除已建的任务。</p>
          <div class="modal-action">
            <button type="button" class="btn btn-ghost btn-sm" onclick="inclCancel()">取消</button>
            <button type="button" class="btn btn-primary btn-sm" onclick="inclOk()">确定纳入</button>
          </div>
        </div>
      </dialog>
      <script>
        var inclConfirmed = false
        function inclExisting(cb) {
          if (!cb.checked) return
          var n = cb.getAttribute('data-count') || '0'
          var d = document.getElementById('incl-dlg')
          document.getElementById('incl-dlg-n').textContent = n
          if (d.showModal) d.showModal()
          else if (!window.confirm('将为 ' + n + ' 个现有歌单创建任务，确定？')) cb.checked = false
        }
        function inclOk() { inclConfirmed = true; document.getElementById('incl-dlg').close() }
        function inclCancel() { document.getElementById('incl-dlg').close() }
        ;(function () {
          var d = document.getElementById('incl-dlg')
          d.addEventListener('close', function () {
            if (!inclConfirmed) { var c = document.getElementById('incl_cb'); if (c) c.checked = false }
            inclConfirmed = false
          })
          d.addEventListener('click', function (e) { if (e.target === this) this.close() }) // 点遮罩 = 取消
        })()
      </script>

    </div>
  </section>

  <!-- ===== 创建 / 监听 ===== -->
  <section class="card tier1 border border-base-300 shadow-sm">
    <div class="card-body gap-3">
      <h3 class="sec-green">创建歌单同步任务</h3>
      <p class="text-xs c-sub" style="margin:-.35rem 0 .6rem">选择歌单创建单个任务;或开启监听,新出现的歌单自动同步</p>
      <div class="flex flex-wrap gap-1.5">
        <button type="button" class="st-tab active" id="ctab1" onclick="switchCT(1)"><svg aria-hidden="true"><use href="#i-plus"/></svg>选择歌单 · 创建同步任务</button>
        <button type="button" class="st-tab" id="ctab2" onclick="switchCT(2)"><svg aria-hidden="true"><use href="#i-pulse"/></svg>监听同步 · 自动新增</button>
      </div>

      <!-- ============ 创建单任务 ============ -->
      <div id="cpanel1">
        <form method="post" action="/api/tasks" hx-post="/api/tasks/bulk" hx-target="#manual-add-msg" hx-swap="innerHTML" class="space-y-3">
          <div class="rounded-lg border border-base-300 p-3">
            <div class="lxhead">
              <h4 class="text-sm font-bold" style="line-height:1">选择 LX 歌单</h4>
              <button type="button" class="btn btn-outline btn-xs px-2" onclick="lxRefresh()"><svg aria-hidden="true"><use href="#i-refresh"/></svg>刷新</button>
              <span class="text-xs c-sub" id="sel-count">已选 0 个</span>
            </div>
            <div class="rounded-lg border border-base-300 p-2 overflow-y-auto" style="max-height:15rem;width:26rem;max-width:100%">
              <div id="lx-list">
                <% for (const p of lxPlaylists) { %>
                <label class="flex items-center gap-2 cursor-pointer py-0.5">
                  <input type="checkbox" name="lxPlaylistKey" value="<%= p.key %>" class="checkbox checkbox-xs" onchange="lxCount()">
                  <span class="text-sm"><%= p.name %>（<%= p.songCount %> 首）</span>
                </label>
                <% } %>
                <% if (!lxPlaylists.length) { %><p class="text-xs c-sub py-3 text-center">未获取到 LX 歌单(连接 LX 后刷新)</p><% } %>
              </div>
            </div>
            <p class="text-xs c-sub mt-1">逐项勾选可一次为多个歌单创建任务(默认设置相同)。</p>
          </div>

          <div class="rounded-lg border border-base-300 p-3">
            <h4 class="text-sm font-bold mb-2">同步到 <%= targetName %> 的目标播放列表/歌单</h4>
            <label class="flex items-center gap-2 cursor-pointer py-0.5">
              <input type="checkbox" name="createSameNamePlaylist" value="1" checked class="checkbox checkbox-sm">
              <span class="text-sm">同名播放列表/歌单(<b>同步时自动生成</b>)</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer py-0.5">
              <input type="checkbox" id="mk_exist" class="checkbox checkbox-sm" onchange="mkRefresh()">
              <span class="text-sm">同步到<b>已有</b>播放列表/歌单</span>
            </label>
  <div id="mk_existbox" style="display:none" class="ml-6 mt-1">
    <div class="rounded-lg border border-base-300 p-2 overflow-y-auto" style="max-height:11rem;width:24rem;max-width:100%">
      <% if (embyPlaylists.length) { %>
        <% for (const p of embyPlaylists) { %>
        <label class="flex items-center gap-2 cursor-pointer py-0.5">
          <input type="checkbox" name="embyTarget" value="<%= p.id %>" class="checkbox checkbox-xs">
          <span class="text-sm"><%= p.name %></span>
        </label>
        <% } %>
      <% } else { %>
        <span class="text-xs c-sub">连接 <%= targetName %> 后可选择</span>
      <% } %>
    </div>
  </div>
            <div id="mk_note" class="d-note mt-2" style="display:none">🔒 镜像 + 已有歌单:只移除/加入<b>本任务产生的歌曲</b>;你手动加的与接管前已存在的歌曲不动(所有权追踪)。</div>
          </div>

          <div class="rounded-lg border border-base-300 p-3">
            <h4 class="text-sm font-bold mb-2">同步方式</h4>
            <label class="dopt" onclick="pickMode('mk','incremental')">
              <input type="radio" name="mode" value="incremental" checked class="radio radio-sm">
              <span><span class="dopt-title">1 · 增量同步</span><br><span class="text-xs c-sub">LX 新增 → 同步;LX 删除不处理,目标歌单只增不减</span></span>
            </label>
            <label class="dopt" onclick="pickMode('mk','mirror')">
              <input type="radio" name="mode" value="mirror" class="radio radio-sm">
              <span><span class="dopt-title">2 · 镜像同步</span><br><span class="text-xs c-sub">LX 增/删都同步到 <%= targetName %></span></span>
            </label>
            <div id="mk_delbox" style="display:none" class="mt-2">
              <h5 class="text-xs font-bold c-sub mb-1">LX 端删除时,歌单/歌曲的处理方式:</h5>
              <label class="flex items-start gap-2 cursor-pointer py-0.5"><input type="radio" name="delPolicy" value="keep" checked class="radio radio-sm"><span class="text-sm"><b>处理1</b> 歌单移除 + 媒体库文件不删(默认)</span></label>
              <label class="flex items-start gap-2 cursor-pointer py-0.5"><input type="radio" name="delPolicy" value="delete" class="radio radio-sm" <%= fileDeleteOK ? '' : 'disabled' %>><span class="text-sm"><b>处理2</b> 歌单移除 + 删除文件<% if (!fileDeleteOK) { %><span class="text-error">(当前 <%= targetName %> 不支持)</span><% } %></span></label>
              <label class="flex items-start gap-2 cursor-pointer py-0.5"><input type="radio" name="delPolicy" value="archive" class="radio radio-sm"><span class="text-sm"><b>处理3</b> 歌单移除 + 移入归档歌单: <input name="archivePlaylist" class="input input-bordered input-sm" style="width:12rem" placeholder="默认 歌单同步任务归档" value="歌单同步任务归档"></span></label>
              <div class="ml-6 mt-1 flex flex-wrap items-center gap-1.5">
                <select class="select select-bordered select-sm" style="width:15rem" data-arch-picker="archivePlaylist" onchange="archPickFrom(this)">
                  <option value="">选择归档目标…</option>
                  <option value="歌单同步任务归档">统一：歌单同步任务归档</option>
                  <option value="[歌单名]归档">按来源：[歌单名]归档</option>
                  <optgroup label="<%= targetName %> 已有播放列表">
                    <% for (const p of embyPlaylists) { %><option value="<%= p.name %>"><%= p.name %></option><% } %>
                  </optgroup>
                </select>
                <span class="text-xs c-sub">输入框写目标歌单名（新的也行）；下拉挑预设或已有歌单。保存时不存在会自动创建，运行中被删则降级为「保留文件」</span>
              </div>
            <p class="text-xs c-sub mt-1">删除均先移入回收站,可在「进度历史 → 回收站」恢复或彻底删除。</p>
            </div>
          </div>

          <div class="rounded-lg border border-base-300 p-3 lxhead flex-wrap">
            <h4 class="text-sm font-bold" style="line-height:1">定时 cron</h4>
            <input name="cronExpr" class="input input-bordered font-mono text-xs" style="width:12rem;margin:0" placeholder="0 6 * * *">
            <span class="text-xs c-sub" style="line-height:1">空 = 仅手动(创建后立即同步一次)</span>
          </div>

          <div id="manual-add-msg" class="text-sm"></div>
          <div class="card-actions border-t border-base-200 pt-3">
            <button type="submit" class="btn btn-primary"><svg aria-hidden="true"><use href="#i-plus"/></svg>添加任务</button>
          </div>
        </form>
      </div>

      <!-- ============ 监听同步 ============ -->
      <div id="cpanel2" style="display:none">
        <form hx-post="/api/config/listen" hx-target="#listen-msg" hx-swap="innerHTML" hx-on::after-request="if(event.detail.successful){location.reload()}" class="space-y-3">
          <div class="rounded-lg border border-base-300 p-3 flex flex-wrap items-center gap-3">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="hidden" name="enabled" value="0"><input type="checkbox" name="enabled" value="1" <%= listen.enabled ? 'checked' : '' %> class="checkbox checkbox-sm">
              <span class="text-sm font-semibold">启用监听</span>
            </label>
            <span class="text-sm">检测计划 cron</span>
            <input name="checkCron" class="input input-bordered font-mono text-xs" style="width:10rem" value="<%= listen.checkCron %>">
            <button type="button" class="btn btn-outline btn-xs px-2" hx-post="/listen/scan" hx-target="#listen-msg">立即检测</button>
            <span class="text-xs c-sub">
  <% if (listen.activeMode === 'all') { %>
    <% if (listen.includeExisting) { %>
      完全模式:现有及今后<b>新增</b>的歌单全部自动建任务
    <% } else { %>
      完全模式:启用前已存在的 <%= listen.baselineKeys.length %> 个歌单不自动建;此后<b>新出现</b>的歌单自动建任务
    <% } %>
  <% } else { %>
    条件模式:<b>无时间窗</b> —— 规则命中且尚未建任务即自动纳入(含现有歌单;保存后点「立即检测」生效)
  <% } %>
</span>
          </div>

          <div class="rounded-lg border border-base-300 p-3">
            <h4 class="text-sm font-bold mb-2">监听模式(互斥,二选一)</h4>
            <label class="dopt" onclick="pickMode('ls','all')">
              <input type="radio" name="activeMode" value="all" <%= listen.activeMode === 'all' ? 'checked' : '' %> class="radio radio-sm">
              <span><span class="dopt-title">完全同步</span><span class="text-xs c-sub"> 现有及将来新增的全部歌单自动同步</span></span>
            </label>
            <label class="dopt" onclick="pickMode('ls','filtered')">
              <input type="radio" name="activeMode" value="filtered" <%= listen.activeMode === 'filtered' ? 'checked' : '' %> class="radio radio-sm">
              <span><span class="dopt-title">条件增量同步</span><span class="text-xs c-sub"> 仅规则命中的歌单自动同步</span></span>
            </label>
          </div>

          <div id="ls_all_box" class="rounded-lg border border-base-300 p-3 <%= listen.activeMode === 'all' ? '' : 'hidden' %>">
  <h4 class="text-sm font-bold mb-2">完全模式 · 新任务默认设置</h4>
  <label class="flex items-start gap-2 cursor-pointer mb-3 rounded-lg border border-base-300 bg-base-200/40 p-2">
    <input type="hidden" name="includeExisting" value="0">
    <input type="checkbox" id="incl_cb" name="includeExisting" value="1" data-count="<%= existingCount %>" <%= listen.includeExisting ? 'checked' : '' %> <%= (!listen.includeExisting && !existingCount) ? 'disabled' : '' %> class="checkbox checkbox-sm" onchange="inclExisting(this)">
    <span class="text-sm"><%= listen.includeExisting ? '已包含现有歌单' : '包含现有歌单' %>（<%= existingCount %> 个待建）
      <span class="text-xs c-sub block"><% if (listen.includeExisting) { %>现有及今后<b>新增</b>的歌单都会自动建任务；取消勾选只影响今后，已建任务不删。<% } else { %>勾选 = 现有及今后新增的<b>全部</b>自动同步；不勾选 = 只同步今后新建的歌单（现有 <%= listen.baselineKeys.length %> 个已记为基线）。<% } %></span>
    </span>
  </label>
  <div class="flex flex-wrap gap-2">
    <label class="flex items-center gap-2 cursor-pointer"><input type="hidden" name="all[createSameNamePlaylist]" value="0"><input type="checkbox" name="all[createSameNamePlaylist]" value="1" <%= listen.all.createSameNamePlaylist ? 'checked' : '' %> class="checkbox checkbox-sm"><span class="text-sm">同名播放列表/歌单(自动生成)</span></label>
    <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" id="pA_exist" class="checkbox checkbox-sm" onchange="existToggle('pA')"><span class="text-sm">同步到已有播放列表/歌单</span></label>
  </div>
    <div id="pA_existbox" style="display:none" class="ml-6 mt-1">
    <div class="rounded-lg border border-base-300 p-2 overflow-y-auto" style="max-height:11rem;width:24rem;max-width:100%">
      <% if (embyPlaylists.length) { %>
        <% for (const p of embyPlaylists) { %>
        <label class="flex items-center gap-2 cursor-pointer py-0.5">
          <input type="checkbox" name="all[embyTarget]" value="<%= p.id %>" class="checkbox checkbox-xs">
          <span class="text-sm"><%= p.name %></span>
        </label>
        <% } %>
      <% } else { %>
        <span class="text-xs c-sub">连接 <%= targetName %> 后可选择</span>
      <% } %>
    </div>
  </div>
<div class="mt-1">
    <label class="dopt" onclick="LPick('pA','incremental')">
      <input type="radio" name="all[taskMode]" value="incremental" <%= listen.all.taskMode === 'incremental' ? 'checked' : '' %> class="radio radio-sm">
      <span><span class="dopt-title">1 · 增量同步</span><span class="text-xs c-sub"> 只增不减</span></span>
    </label>
    <label class="dopt" onclick="LPick('pA','mirror')">
      <input type="radio" name="all[taskMode]" value="mirror" <%= listen.all.taskMode === 'mirror' ? 'checked' : '' %> class="radio radio-sm">
      <span><span class="dopt-title">2 · 镜像同步</span><span class="text-xs c-sub"> 增删都同步到 <%= targetName %></span></span>
    </label>
    <div id="pA_del" style="display:none" class="mt-1">
      <h5 class="text-xs font-bold c-sub mb-1">LX 端删除时处理方式:</h5>
      <label class="flex items-start gap-2 cursor-pointer py-0.5"><input type="radio" name="all[delPolicy]" value="keep" <%= listen.all.delPolicy === 'keep' ? 'checked' : '' %> class="radio radio-sm"><span class="text-sm"><b>处理1</b> 歌单移除 + 文件不删(默认)</span></label>
      <label class="flex items-start gap-2 cursor-pointer py-0.5"><input type="radio" name="all[delPolicy]" value="delete" <%= listen.all.delPolicy === 'delete' ? 'checked' : '' %> class="radio radio-sm" <%= fileDeleteOK ? '' : 'disabled' %>><span class="text-sm"><b>处理2</b> 歌单移除 + 删除文件<% if (!fileDeleteOK) { %><span class="text-error">(当前 <%= targetName %> 不支持)</span><% } %></span></label>
      <label class="flex items-start gap-2 cursor-pointer py-0.5"><input type="radio" name="all[delPolicy]" value="archive" <%= listen.all.delPolicy === 'archive' ? 'checked' : '' %> class="radio radio-sm"><span class="text-sm"><b>处理3</b> 移入归档歌单: <input name="all[archivePlaylist]" class="input input-bordered input-sm" style="width:11rem" placeholder="默认 歌单同步任务归档" value="<%= listen.all.archivePlaylist %>"></span></label>
      <div class="ml-6 mt-1 flex flex-wrap items-center gap-1.5">
        <select class="select select-bordered select-sm" style="width:15rem" data-arch-picker="all[archivePlaylist]" onchange="archPickFrom(this)">
          <option value="">选择归档目标…</option>
          <option value="歌单同步任务归档">统一：歌单同步任务归档</option>
          <option value="[歌单名]归档">按来源：[歌单名]归档</option>
          <optgroup label="<%= targetName %> 已有播放列表">
            <% for (const p of embyPlaylists) { %><option value="<%= p.name %>"><%= p.name %></option><% } %>
          </optgroup>
        </select>
        <span class="text-xs c-sub">可直接输入新名字，或从左侧选预设/已有歌单；保存时不存在自动创建，运行中被删则降级为「保留文件」</span>
      </div>
            <p class="text-xs c-sub mt-1">删除均先移入回收站,可在「进度历史 → 回收站」恢复或彻底删除。</p>
    </div>
  </div>
  <div class="flex flex-wrap items-center gap-2 mt-1 pt-2 border-t border-base-200">
    <span class="text-sm">新任务 cron(空=建后立即一次)</span>
    <input name="all[taskCron]" class="input input-bordered input-sm font-mono text-xs" style="width:9rem" value="<%= listen.all.taskCron %>">
  </div>
</div>

<div id="ls_filtered_box" class="space-y-2 <%= listen.activeMode === 'filtered' ? '' : 'hidden' %>">
  <div class="rounded-lg border border-base-300 p-3">
  <h4 class="text-sm font-bold mb-2">条件模式 · 规则筛选</h4>
  <div class="flex flex-col gap-3 md:flex-row">
    <div class="rounded-lg border border-base-300 p-2.5 flex-1">
      <label class="flex items-center gap-2 cursor-pointer"><input type="hidden" name="filtered[rules][exclude][enabled]" value="0"><input type="checkbox" name="filtered[rules][exclude][enabled]" value="1" <%= listen.filtered.rules.exclude.enabled ? 'checked' : '' %> class="checkbox checkbox-xs"><span class="text-sm font-semibold">排除</span><span class="text-xs c-sub">(命中不同步)</span></label>
      <input name="filtered[rules][exclude][keywords]" class="input input-bordered input-sm w-full mt-1" placeholder="歌单名关键词,逗号分隔" value="<%= listen.filtered.rules.exclude.keywords.join(',') %>">
    </div>
    <div class="rounded-lg border border-base-300 p-2.5 flex-1">
      <label class="flex items-center gap-2 cursor-pointer"><input type="hidden" name="filtered[rules][match][enabled]" value="0"><input type="checkbox" name="filtered[rules][match][enabled]" value="1" <%= listen.filtered.rules.match.enabled ? 'checked' : '' %> class="checkbox checkbox-xs"><span class="text-sm font-semibold">匹配</span><span class="text-xs c-sub">(命中才同步)</span></label>
      <input name="filtered[rules][match][keywords]" class="input input-bordered input-sm w-full mt-1" placeholder="歌单名关键词,逗号分隔" value="<%= listen.filtered.rules.match.keywords.join(',') %>">
    </div>
  </div>
  <p class="text-xs c-sub mt-1">语义:排除优先;只开匹配=仅命中项;只开排除=全量减排除。变更只影响之后新出现的歌单(不回溯)。</p>
  </div>
  <div class="rounded-lg border border-base-300 p-3">
  <h4 class="text-sm font-bold mb-2">条件模式 · 新任务默认设置</h4>
  <div class="flex flex-wrap gap-2">
    <label class="flex items-center gap-2 cursor-pointer"><input type="hidden" name="filtered[params][createSameNamePlaylist]" value="0"><input type="checkbox" name="filtered[params][createSameNamePlaylist]" value="1" <%= listen.filtered.params.createSameNamePlaylist ? 'checked' : '' %> class="checkbox checkbox-sm"><span class="text-sm">同名播放列表/歌单(自动生成)</span></label>
    <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" id="pF_exist" class="checkbox checkbox-sm" onchange="existToggle('pF')"><span class="text-sm">同步到已有播放列表/歌单</span></label>
  </div>
    <div id="pF_existbox" style="display:none" class="ml-6 mt-1">
    <div class="rounded-lg border border-base-300 p-2 overflow-y-auto" style="max-height:11rem;width:24rem;max-width:100%">
      <% if (embyPlaylists.length) { %>
        <% for (const p of embyPlaylists) { %>
        <label class="flex items-center gap-2 cursor-pointer py-0.5">
          <input type="checkbox" name="filtered[params][embyTarget]" value="<%= p.id %>" class="checkbox checkbox-xs">
          <span class="text-sm"><%= p.name %></span>
        </label>
        <% } %>
      <% } else { %>
        <span class="text-xs c-sub">连接 <%= targetName %> 后可选择</span>
      <% } %>
    </div>
  </div>
<div class="mt-1">
    <label class="dopt" onclick="LPick('pF','incremental')">
      <input type="radio" name="filtered[params][taskMode]" value="incremental" <%= listen.filtered.params.taskMode === 'incremental' ? 'checked' : '' %> class="radio radio-sm">
      <span><span class="dopt-title">1 · 增量同步</span><span class="text-xs c-sub"> 只增不减</span></span>
    </label>
    <label class="dopt" onclick="LPick('pF','mirror')">
      <input type="radio" name="filtered[params][taskMode]" value="mirror" <%= listen.filtered.params.taskMode === 'mirror' ? 'checked' : '' %> class="radio radio-sm">
      <span><span class="dopt-title">2 · 镜像同步</span><span class="text-xs c-sub"> 增删都同步到 <%= targetName %></span></span>
    </label>
    <div id="pF_del" style="display:none" class="mt-1">
      <h5 class="text-xs font-bold c-sub mb-1">LX 端删除时处理方式:</h5>
      <label class="flex items-start gap-2 cursor-pointer py-0.5"><input type="radio" name="filtered[params][delPolicy]" value="keep" <%= listen.filtered.params.delPolicy === 'keep' ? 'checked' : '' %> class="radio radio-sm"><span class="text-sm"><b>处理1</b> 歌单移除 + 文件不删(默认)</span></label>
      <label class="flex items-start gap-2 cursor-pointer py-0.5"><input type="radio" name="filtered[params][delPolicy]" value="delete" <%= listen.filtered.params.delPolicy === 'delete' ? 'checked' : '' %> class="radio radio-sm" <%= fileDeleteOK ? '' : 'disabled' %>><span class="text-sm"><b>处理2</b> 歌单移除 + 删除文件<% if (!fileDeleteOK) { %><span class="text-error">(当前 <%= targetName %> 不支持)</span><% } %></span></label>
      <label class="flex items-start gap-2 cursor-pointer py-0.5"><input type="radio" name="filtered[params][delPolicy]" value="archive" <%= listen.filtered.params.delPolicy === 'archive' ? 'checked' : '' %> class="radio radio-sm"><span class="text-sm"><b>处理3</b> 移入归档歌单: <input name="filtered[params][archivePlaylist]" class="input input-bordered input-sm" style="width:11rem" placeholder="默认 歌单同步任务归档" value="<%= listen.filtered.params.archivePlaylist %>"></span></label>
      <div class="ml-6 mt-1 flex flex-wrap items-center gap-1.5">
        <select class="select select-bordered select-sm" style="width:15rem" data-arch-picker="filtered[params][archivePlaylist]" onchange="archPickFrom(this)">
          <option value="">选择归档目标…</option>
          <option value="歌单同步任务归档">统一：歌单同步任务归档</option>
          <option value="[歌单名]归档">按来源：[歌单名]归档</option>
          <optgroup label="<%= targetName %> 已有播放列表">
            <% for (const p of embyPlaylists) { %><option value="<%= p.name %>"><%= p.name %></option><% } %>
          </optgroup>
        </select>
        <span class="text-xs c-sub">可直接输入新名字，或从左侧选预设/已有歌单；保存时不存在自动创建，运行中被删则降级为「保留文件」</span>
      </div>
            <p class="text-xs c-sub mt-1">删除均先移入回收站,可在「进度历史 → 回收站」恢复或彻底删除。</p>
    </div>
  </div>
  <div class="flex flex-wrap items-center gap-2 mt-1 pt-2 border-t border-base-200">
    <span class="text-sm">新任务 cron(空=建后立即一次)</span>
    <input name="filtered[params][taskCron]" class="input input-bordered input-sm font-mono text-xs" style="width:9rem" value="<%= listen.filtered.params.taskCron %>">
  </div>
  </div>
</div>

          <div class="flex flex-wrap items-center gap-2">
            <button type="button" class="btn btn-outline btn-xs px-2" hx-post="/listen/switch" hx-vals='{"mode":"<%= listen.activeMode %>","taskPolicy":"pause"}' hx-target="#listen-msg">暂停当前模式自动任务(可恢复)</button>
            <button type="button" class="btn btn-ghost btn-xs px-2" hx-post="/listen/resume" hx-vals='{"mode":"<%= listen.activeMode %>"}' hx-target="#listen-msg">恢复自动任务</button>
            <span class="text-xs c-sub">模式互斥:开启一种自动关闭另一种;旧任务默认保持运行(A+C,绝不自动删除)</span>
          </div>

          <div id="listen-msg" class="text-sm"></div>
          <div class="card-actions border-t border-base-200 pt-3">
            <button type="submit" class="btn btn-primary"><svg aria-hidden="true"><use href="#i-save"/></svg>保存监听设置</button>
          </div>
        </form>
        <!-- 忽略列表：删除任务时勾选「永久忽略」的歌单（不自动重建）；取消忽略后下次扫描会重新创建任务 -->
        <div id="listen-ignored" class="mt-3" hx-get="/api/listen/ignored/panel" hx-trigger="load"></div>
      </div>

    </div>
  </section>
</div>

<script>
// ===== 轻量联动 =====
function switchCT(n) {
  document.getElementById('cpanel1').style.display = n === 1 ? '' : 'none'
  document.getElementById('cpanel2').style.display = n === 2 ? '' : 'none'
  document.getElementById('ctab1').classList.toggle('active', n === 1)
  document.getElementById('ctab2').classList.toggle('active', n === 2)
}
function lxCount() {
  var n = document.querySelectorAll('#lx-list input[name="lxPlaylistKey"]:checked').length
  document.getElementById('sel-count').textContent = '已选 ' + n + ' 个'
}
function lxRefresh() { location.reload() } // 重载拉最新歌单(含数量)
function mkRefresh() {
  var c = document.getElementById('mk_exist').checked
  document.getElementById('mk_existbox').style.display = c ? '' : 'none'
  var mirror = document.querySelector('input[name="mode"]:checked')
  var isMirror = mirror && mirror.value === 'mirror'
  document.getElementById('mk_note').style.display = (c && isMirror) ? '' : 'none'
}
function pickMode(scope, val) {
  if (scope === 'mk') {
    var r = document.querySelector('input[name="mode"][value="' + val + '"]')
    if (r) r.checked = true
    document.getElementById('mk_delbox').style.display = val === 'mirror' ? '' : 'none'
    var dis = val !== 'mirror'
    document.querySelectorAll('#mk_delbox input, #mk_delbox select').forEach(function (x) { x.disabled = dis })
    mkRefresh()
  } else {
    var r2 = document.querySelector('input[name="activeMode"][value="' + val + '"]')
    if (r2) r2.checked = true
    var all = val === 'all'
    document.getElementById('ls_all_box').classList.toggle('hidden', !all)
    document.getElementById('ls_filtered_box').classList.toggle('hidden', all)
  }
}
// 监听默认参数区:与单任务同构的联动(按 pA=all / pF=filtered 前缀)
function LPick(p, val) {
  var name = p === 'pA' ? 'all[taskMode]' : 'filtered[params][taskMode]'
  var r = document.querySelector('input[name="' + name + '"][value="' + val + '"]')
  if (r) r.checked = true
  tuneParams(p)
}
function existToggle(p) {
  var ex = document.getElementById(p + '_exist').checked
  document.getElementById(p + '_existbox').style.display = ex ? '' : 'none'
}
function tuneParams(p) {
  var name = p === 'pA' ? 'all[taskMode]' : 'filtered[params][taskMode]'
  var sel = document.querySelector('input[name="' + name + '"]:checked')
  var mirror = sel && sel.value === 'mirror'
  document.getElementById(p + '_del').style.display = mirror ? '' : 'none'
  var delName = p === 'pA' ? 'all[delPolicy]' : 'filtered[params][delPolicy]'
  var archName = p === 'pA' ? 'all[archivePlaylist]' : 'filtered[params][archivePlaylist]'
  document.querySelectorAll('input[name="' + delName + '"], input[name="' + archName + '"], select[data-arch-picker="' + archName + '"]').forEach(function (x) { x.disabled = !mirror })
}
(function () {
  pickMode('mk', 'incremental')
  tuneParams('pA'); tuneParams('pF')
})()

// ===== 任务表「进度历史」列：跑着的任务实时刷进度条，跑完自动刷新成结果 =====
// （与榜单订阅页同一套逻辑；轮询 /api/progress/json）
var sfLive = { runningId: 0, shownId: 0 }
function sfPollLive() {
  fetch('/api/progress/json')
    .then(function (r) { return r.json() })
    .then(function (d) {
      if (!document.querySelector('#task-table tr[data-task-id]')) return
      if (d.running) {
        var row = document.querySelector('#task-table tr[data-task-id="' + d.taskId + '"]')
        if (!row) return // 跑的不是本页的歌单任务（比如榜单订阅），不打扰
        var cell = row.querySelector('[data-live-task]')
        if (!cell) {
          // 这行还没渲染成"运行中" → 刷新一次让它出现进度条（编辑中不刷，免得冲掉编辑表单）
          if (!document.querySelector('#task-table .edit-row') && sfLive.shownId !== d.taskId) {
            sfLive.shownId = d.taskId
            htmx.ajax('GET', '/api/tasks/table?scope=playlist', { target: '#task-table' })
          }
          return
        }
        var bar = cell.querySelector('.mini-bar > i')
        if (bar) bar.style.width = d.pct + '%'
        var wrap = cell.querySelector('.mini-bar')
        if (wrap) wrap.title = '第 ' + d.done + '/' + d.total + ' 首 · ' + d.phase + (d.current ? '（' + d.current + '）' : '')
        sfLive.runningId = d.taskId
      } else if (sfLive.runningId) {
        // 刚刚跑完 → 刷新一次，把"运行中"换成最终结果
        sfLive.runningId = 0
        sfLive.shownId = 0
        if (!document.querySelector('#task-table .edit-row')) {
          htmx.ajax('GET', '/api/tasks/table?scope=playlist', { target: '#task-table' })
        }
      }
    })
    .catch(function () { /* 网络抖动，下次再试 */ })
}
setInterval(sfPollLive, 2500)
</script>
