<style>
  /* 手动新增:左右块垂直居中、内部不溢出 */
  .add-flow { align-items: center; }
  .add-flow .lx-col, .add-flow .target-col { min-width: 0; }
  .flow-label-row { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin-bottom: .3rem; }
  @media (max-width: 767.98px) {
    .add-flow { flex-direction: column; align-items: stretch; }
    .arrow-col { width: auto !important; padding: .2rem 0 !important; }
    .arrow-label, .add-flow label span { overflow-wrap: anywhere; white-space: normal; }
  }
  /* 自动新增:左字段/右默认设置 各半(桌面),窄屏换行堆叠 */
  .aa-split { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: flex-start; }
  .aa-split > .aa-field-col, .aa-split > .aa-panel { flex: 1 1 0; min-width: 260px; }
  /* 手动新增左右选区各自成框 */
  .manual-box { flex: 1; min-width: 0; border: 1px solid oklch(var(--bc) / .18); border-radius: .5rem;
                background: oklch(var(--b1)); padding: .6rem .75rem; }
  /* 任务操作列:横向不换行(移动端表格滚动时按钮横排) */
  #task-table .act { display: flex; gap: .35rem; flex-wrap: nowrap; white-space: nowrap; justify-content: flex-end; }
</style>
<div class="space-y-4">

  <!-- ===== 页头 ===== -->
  <header>
    <div class="flex items-center gap-2 flex-wrap">
      <h2 class="text-lg font-extrabold tracking-tight">歌单同步</h2>
    </div>
  </header>

  <!-- ===== 任务列表 ===== -->
  <section class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-3">
      <h3 class="card-title text-base">我的歌单同步任务</h3>
      <div id="task-table" class="overflow-x-auto" hx-get="/api/tasks/table?scope=playlist" hx-trigger="load">
        <p class="c-sub text-xs py-6 text-center">加载中…</p>
      </div>
    </div>
  </section>

  <!-- ===== 自动新增 ===== -->
  <form method="post" action="/api/config/autoadd" hx-post="/api/config/autoadd" hx-target="#autoadd-msg"
        class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-3.5">
      <div class="flex items-center gap-3">
        <span class="w-8 h-8 rounded-lg bg-primary/15 text-primary font-bold text-base flex items-center justify-center shrink-0">＋</span>
        <div>
          <h3 class="card-title text-base">自动新增同步任务</h3>
          <p class="text-xs c-sub">启用后，新出现在 LX 中的歌单会被自动创建同步任务并立即同步</p>
        </div>
        <label class="ml-auto flex items-center gap-2 cursor-pointer shrink-0">
          <input type="checkbox" name="enabled" value="1" <%= cfg.general.autoadd.enabled ? 'checked' : '' %> class="checkbox checkbox-sm">
          <span class="text-xs font-semibold">启用</span>
        </label>
      </div>

      <div class="aa-split">
      <div class="aa-field-col flex flex-col gap-3">
        <label class="form-control w-full">
          <span class="label-text mb-1">启用日期</span>
          <input type="date" name="baselineDate" value="<%= cfg.general.autoadd.baselineDate || '' %>" class="input input-bordered w-full">
          <span class="text-xs c-sub mt-1">只自动同步该日期之后新增的 LX 歌单（首次启用时自动记录现有歌单为基线）</span>
        </label>
        <label class="form-control w-full">
          <span class="label-text mb-1">检测计划<span class="c-sub font-normal">（分 时 日 月 周）</span></span>
          <input name="checkCron" value="<%= cfg.general.autoadd.checkCron %>" placeholder="0 6 * * *" class="input input-bordered w-full font-mono text-xs">
          <span class="text-xs c-sub mt-1">空 = 仅手动</span>
        </label>
      </div>

      <div class="aa-panel rounded-lg border border-base-300 bg-base-200/50 p-3 space-y-2">
        <h4 class="text-xs font-bold c-sub">新任务默认设置</h4>
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" name="createSameNamePlaylist" value="1" <%= cfg.general.autoadd.createSameNamePlaylist ? 'checked' : '' %> class="checkbox checkbox-sm">
          <span class="text-sm">同步到新建同名 <%= targetName %> 播放列表（歌单）</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" id="aa-to-existing" onchange="toggleExistingId(this, 'aa')" <%= cfg.general.autoadd.embyTargetPlaylistIds.length ? 'checked' : '' %> class="checkbox checkbox-sm">
          <span class="text-sm">同步到现有 <%= targetName %> 播放列表（歌单）</span>
        </label>
        <div class="existing-box" id="existing-boxaa" style="display:<%= cfg.general.autoadd.embyTargetPlaylistIds.length ? '' : 'none' %>">
          <div id="existing-list-aa" class="bg-base-100 rounded-md border border-base-300 p-2 max-h-40 overflow-y-auto space-y-0.5">
            <% if (embyPlaylists.length) { %>
              <% for (const p of embyPlaylists) { %>
              <label class="flex items-center gap-2 cursor-pointer py-0.5">
                <input type="checkbox" name="embyTarget" value="<%= p.id %>" <%= cfg.general.autoadd.embyTargetPlaylistIds.includes(p.id) ? 'checked' : '' %> class="checkbox checkbox-xs">
                <span class="text-sm truncate"><%= p.name %></span>
              </label>
              <% } %>
            <% } else { %>
              <span class="hint text-xs">连接 <%= targetName %> 后可选择</span>
            <% } %>
          </div>
        </div>
        <div class="line" style="margin-top:.4rem">
          <span class="text-sm font-medium w-24 shrink-0">同步方式</span>
          <select name="syncMode" onchange="showModeDescId(this, 'aa')" class="select select-bordered">
            <option value="incremental" <%= cfg.general.autoadd.syncMode === 'incremental' ? 'selected' : '' %>>增量（只加新歌）</option>
            <option value="full" <%= cfg.general.autoadd.syncMode === 'full' ? 'selected' : '' %>>完全（<%= targetName %> 向 LX 看齐：增+删）</option>
          </select>
          <span class="mode-desc" id="mode-desc-aa"></span>
        </div>
        <div class="line">
          <span class="text-sm font-medium w-24 shrink-0">定时 cron</span>
          <input name="taskCron" value="<%= cfg.general.autoadd.taskCron || '' %>" placeholder="0 6 * * *" class="input input-bordered w-44 font-mono text-xs">
          <small class="hint text-xs">空 = 创建后立即同步一次，之后仅手动</small>
        </div>
      </div>
      </div>

      <div class="card-actions flex flex-wrap items-center gap-2 border-t border-base-200 pt-3">
        <button type="submit" class="btn btn-primary">保存设置</button>
        <button type="button" class="btn btn-outline" hx-post="/api/autoadd/scan" hx-target="#autoadd-msg">立即检测</button>
        <span id="autoadd-msg" class="text-sm"></span>
      </div>
      <div id="autoadd-panel" hx-get="/api/autoadd/panel" hx-trigger="load"></div>
    </div>
  </form>

  <!-- ===== 手动新增 ===== -->
  <form method="post" action="/api/tasks" hx-post="/api/tasks" hx-target="#manual-add-msg" hx-swap="innerHTML"
        class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-3.5">
      <div class="flex items-center gap-3">
        <span class="w-8 h-8 rounded-lg bg-primary/15 text-primary font-bold text-base flex items-center justify-center shrink-0">＋</span>
        <div>
          <h3 class="card-title text-base">手动新增同步任务</h3>
          <p class="text-xs c-sub">把一个 LX 歌单同步到 <%= targetName %> 的播放列表</p>
        </div>
      </div>
      <div id="manual-add-msg" class="text-sm"></div>

      <div class="rounded-lg border border-base-300 bg-base-200/50 p-3">
        <div class="add-flow" style="max-width:860px;margin-inline:auto">
          <div class="lx-col">
            <div class="manual-box">
              <div class="flow-label-row">
                <span class="label-text font-semibold">LX 歌单</span>
                <button type="button" class="btn btn-outline btn-xs px-2" hx-get="/api/lx/playlists/options" hx-target="#lx-select" hx-swap="innerHTML">刷新</button>
              </div>
              <select name="lxPlaylistKey" id="lx-select" required class="select select-bordered w-full">
                <option value="" disabled selected>选择歌单…</option>
                <% for (const p of lxPlaylists) { %>
                <option value="<%= p.key %>"><%= p.name %>（<%= p.songCount %> 首）</option>
                <% } %>
              </select>
            </div>
          </div>

          <div class="arrow-col">
            <span class="arrow-label">同步到 <%= targetName %> 中的<br>播放列表（歌单）</span>
            <span class="arrow-icon"><img src="/static/logo.svg" alt="→"></span>
          </div>

          <div class="target-col">
            <div class="manual-box">
              <div class="flow-label-row">
                <span class="label-text font-semibold">目标 · <%= targetName %> 播放列表</span>
                <button type="button" class="btn btn-outline btn-xs px-2" hx-get="/api/emby/playlists/checkboxes" hx-target="#existing-list" hx-swap="innerHTML">刷新</button>
              </div>
              <label class="flex items-center gap-2 cursor-pointer py-0.5">
                <input type="checkbox" name="createSameNamePlaylist" value="1" checked class="checkbox checkbox-sm">
                <span class="text-sm">同步到新建 <%= targetName %> 播放列表（歌单）</span>
              </label>
              <p class="hint opt-hint text-xs">新建一个与该 LX 歌单同名的 <%= targetName %> 歌单并加入歌曲</p>
              <label class="flex items-center gap-2 cursor-pointer py-0.5">
                <input type="checkbox" id="to-existing" onchange="toggleExistingId(this, '')" class="checkbox checkbox-sm">
                <span class="text-sm">同步到现有 <%= targetName %> 播放列表（歌单）</span>
              </label>
              <div class="existing-box" id="existing-box" style="display:none">
                <div id="existing-list" class="bg-base-100 rounded-md border border-base-300 p-2 max-h-40 overflow-y-auto space-y-0.5">
                  <% if (embyPlaylists.length) { %>
                    <% for (const p of embyPlaylists) { %>
                    <label class="flex items-center gap-2 cursor-pointer py-0.5">
                      <input type="checkbox" name="embyTarget" value="<%= p.id %>" class="checkbox checkbox-xs">
                      <span class="text-sm truncate"><%= p.name %></span>
                    </label>
                    <% } %>
                  <% } else { %>
                    <span class="hint text-xs">连接 <%= targetName %> 后可选择</span>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="fg">
        <div class="line items-center">
          <span class="text-sm font-medium w-24 shrink-0">同步方式</span>
          <select name="syncMode" onchange="showModeDescId(this, '')" class="select select-bordered">
            <option value="incremental">增量（只加新歌）</option>
            <option value="full">完全（<%= targetName %> 向 LX 看齐：增+删）</option>
          </select>
          <span class="mode-desc" id="mode-desc"></span>
        </div>
        <div class="line items-center">
          <span class="text-sm font-medium w-24 shrink-0">定时 cron</span>
          <input name="cronExpr" placeholder="0 6 * * *" class="input input-bordered font-mono text-xs">
          <small class="hint text-xs">空 = 仅手动</small>
        </div>
      </div>

      <div class="card-actions flex items-center gap-2 border-t border-base-200 pt-3">
        <button type="submit" class="btn btn-primary">添加任务</button>
      </div>
    </div>
  </form>

</div>

<script>
var syncModeSels = document.querySelectorAll('select[name="syncMode"]')
showModeDescId(syncModeSels[0], 'aa') // 自动新增模块（页面第一个）
if (syncModeSels[1]) showModeDescId(syncModeSels[1], '') // 新增同步任务
</script>
