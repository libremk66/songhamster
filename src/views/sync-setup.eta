<style>
  /* 本页 tab(创建/监听)与模式分段 */
  .st-tab { display: inline-flex; align-items: center; gap: .4rem; padding: .45rem 1rem; font-size: .875rem;
            border-bottom: 2px solid transparent; color: oklch(var(--bc) / 0.7); cursor: pointer; background: none;
            border-radius: 0; transition: color .15s, border-color .15s; }
  .st-tab svg { width: 1em; height: 1em; }
  .st-tab:hover { color: var(--sfg-deep); }
  .st-tab.active { color: var(--sfg-deep); font-weight: 650; border-bottom-color: var(--sfg); }
  .dopt { display: flex; align-items: flex-start; gap: .5rem; padding: .5rem .6rem; border: 1px solid oklch(var(--bc) / .15);
          border-radius: .55rem; cursor: pointer; margin-bottom: .4rem; transition: border-color .15s, background .15s; }
  .dopt:hover { border-color: oklch(var(--bc) / .4); }
  .dopt.sel { border-color: var(--sfg); background: color-mix(in oklab, var(--sfg) 8%, transparent); }
  .dopt-title { font-weight: 600; font-size: .875rem; }
  .d-note { border-left: 3px solid var(--sfg); background: color-mix(in oklab, var(--sfg) 7%, transparent);
            padding: .5rem .7rem; border-radius: .3rem; font-size: .8125rem; }
</style>
<div class="space-y-4">

  <!-- ===== 页头 ===== -->
  <header>
    <div class="flex items-center gap-2 flex-wrap">
      <h2 class="text-lg font-extrabold tracking-tight">歌单同步</h2>
      <span class="badge badge-outline badge-sm font-normal px-2 py-1 text-xs" id="mode-chip"><%= listen.enabled ? (listen.activeMode === 'all' ? '监听已启用 · 完全同步' : '监听已启用 · 条件增量') : '监听未启用' %></span>
    </div>
  </header>

  <!-- ===== 我的歌单同步任务 ===== -->
  <section class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-3">
      <h3 class="card-title text-base">我的歌单同步任务</h3>
      <div id="task-table" class="overflow-x-auto" hx-get="/api/tasks/table?scope=playlist" hx-trigger="load">
        <p class="c-sub text-xs py-6 text-center">加载中…</p>
      </div>
    </div>
  </section>

  <!-- ===== 创建 / 监听 ===== -->
  <section class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-3">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h3 class="card-title text-base">创建歌单同步任务</h3>
        <span class="text-xs c-sub">选择歌单创建单个任务;或开启监听,新出现的歌单自动同步</span>
      </div>
      <div class="flex gap-1 border-b border-base-200">
        <button type="button" class="st-tab active" id="ctab1" onclick="switchCT(1)"><svg aria-hidden="true"><use href="#i-plus"/></svg>选择歌单 · 创建同步任务</button>
        <button type="button" class="st-tab" id="ctab2" onclick="switchCT(2)"><svg aria-hidden="true"><use href="#i-pulse"/></svg>监听同步 · 自动新增</button>
      </div>

      <!-- ============ 创建单任务 ============ -->
      <div id="cpanel1">
        <form method="post" action="/api/tasks" hx-post="/api/tasks" hx-target="#manual-add-msg" hx-swap="innerHTML" class="space-y-3">
          <div class="rounded-lg border border-base-300 p-3">
            <h4 class="text-sm font-bold mb-2"><span class="c-sub">框1</span> · 选择 LX 歌单</h4>
            <div class="flex flex-wrap items-center gap-2">
              <select name="lxPlaylistKey" id="lx-select" required class="select select-bordered" style="min-width:20rem">
                <option value="" disabled selected>选择歌单…</option>
                <% for (const p of lxPlaylists) { %>
                <option value="<%= p.key %>"><%= p.name %>（<%= p.songCount %> 首）</option>
                <% } %>
              </select>
              <button type="button" class="btn btn-outline btn-xs px-2" hx-get="/api/lx/playlists/options" hx-target="#lx-select" hx-swap="innerHTML">刷新</button>
            </div>
          </div>

          <div class="rounded-lg border border-base-300 p-3">
            <h4 class="text-sm font-bold mb-2"><span class="c-sub">框2</span> · 同步到 <%= targetName %> 的目标播放列表/歌单</h4>
            <label class="flex items-center gap-2 cursor-pointer py-0.5">
              <input type="checkbox" name="createSameNamePlaylist" value="1" checked class="checkbox checkbox-sm">
              <span class="text-sm">同名播放列表/歌单(<b>同步时自动生成</b>)</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer py-0.5">
              <input type="checkbox" id="mk_exist" class="checkbox checkbox-sm" onchange="mkRefresh()">
              <span class="text-sm">同步到<b>已有</b>播放列表/歌单</span>
            </label>
            <div id="mk_existbox" style="display:none" class="ml-6 mt-1">
              <div class="flex flex-wrap gap-x-4">
                <% if (embyPlaylists.length) { %>
                  <% for (const p of embyPlaylists) { %>
                  <label class="flex items-center gap-2 cursor-pointer py-0.5"><input type="checkbox" name="embyTarget" value="<%= p.id %>" class="checkbox checkbox-xs"><span class="text-sm"><%= p.name %></span></label>
                  <% } %>
                <% } else { %>
                  <span class="text-xs c-sub">连接 <%= targetName %> 后可选择</span>
                <% } %>
              </div>
            </div>
            <div id="mk_note" class="d-note mt-2" style="display:none">🔒 镜像 + 已有歌单:只移除/加入<b>本任务产生的歌曲</b>;你手动加的与接管前已存在的歌曲不动(所有权追踪)。</div>
          </div>

          <div class="rounded-lg border border-base-300 p-3">
            <h4 class="text-sm font-bold mb-2"><span class="c-sub">框3</span> · 同步方式</h4>
            <label class="dopt" onclick="pickMode('mk','incremental')">
              <input type="radio" name="mode" value="incremental" checked class="radio radio-sm">
              <span><span class="dopt-title">1 · 增量同步</span><br><span class="text-xs c-sub">LX 新增 → 同步;LX 删除不处理,目标歌单只增不减</span></span>
            </label>
            <label class="dopt" onclick="pickMode('mk','mirror')">
              <input type="radio" name="mode" value="mirror" class="radio radio-sm">
              <span><span class="dopt-title">2 · 镜像同步</span><br><span class="text-xs c-sub">LX 增/删都同步到 <%= targetName %></span></span>
            </label>
            <div id="mk_delbox" style="display:none" class="mt-2">
              <h5 class="text-xs font-bold c-sub mb-1">LX 端删除时,歌单/歌曲的处理方式:</h5>
              <label class="flex items-start gap-2 cursor-pointer py-0.5"><input type="radio" name="delPolicy" value="keep" checked class="radio radio-sm"><span class="text-sm"><b>处理1</b> 歌单移除 + 媒体库文件不删(默认)</span></label>
              <label class="flex items-start gap-2 cursor-pointer py-0.5"><input type="radio" name="delPolicy" value="delete" class="radio radio-sm" <%= fileDeleteOK ? '' : 'disabled' %>><span class="text-sm"><b>处理2</b> 歌单移除 + 媒体库删文件<% if (fileDeleteOK) { %><span class="c-sub">(文件进回收站可恢复)</span><% } else { %><span class="text-error">(当前 <%= targetName %> 不支持)</span><% } %></span></label>
              <label class="flex items-start gap-2 cursor-pointer py-0.5"><input type="radio" name="delPolicy" value="archive" class="radio radio-sm"><span class="text-sm"><b>处理3</b> 歌单移除 + 移入归档歌单: <input name="archivePlaylist" class="input input-bordered input-sm" style="width:12rem" value="歌单同步任务归档"></span></label>
            </div>
          </div>

          <div class="rounded-lg border border-base-300 p-3 flex flex-wrap items-center gap-2">
            <h4 class="text-sm font-bold"><span class="c-sub">框4</span> 定时 cron</h4>
            <input name="cronExpr" class="input input-bordered font-mono text-xs" style="width:12rem" placeholder="0 6 * * *">
            <span class="text-xs c-sub">空 = 仅手动(创建后立即同步一次)</span>
          </div>

          <div id="manual-add-msg" class="text-sm"></div>
          <div class="card-actions border-t border-base-200 pt-3">
            <button type="submit" class="btn btn-primary"><svg aria-hidden="true"><use href="#i-plus"/></svg>添加任务</button>
          </div>
        </form>
      </div>

      <!-- ============ 监听同步 ============ -->
      <div id="cpanel2" style="display:none">
        <form hx-post="/api/config/listen" hx-target="#listen-msg" hx-swap="innerHTML" class="space-y-3">
          <div class="rounded-lg border border-base-300 p-3 flex flex-wrap items-center gap-3">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="enabled" value="1" <%= listen.enabled ? 'checked' : '' %> class="checkbox checkbox-sm">
              <span class="text-sm font-semibold">启用监听</span>
            </label>
            <span class="text-sm">检测计划 cron</span>
            <input name="checkCron" class="input input-bordered font-mono text-xs" style="width:10rem" value="<%= listen.checkCron %>">
            <button type="button" class="btn btn-outline btn-xs px-2" hx-post="/listen/scan" hx-target="#listen-msg">立即检测</button>
            <span class="text-xs c-sub">基线 <%= listen.baselineKeys.length %> 个歌单<% if (listen.baselineDate) { %> · 自 <%= listen.baselineDate %><% } %>;之后新增歌单按模式自动建任务</span>
          </div>

          <div class="rounded-lg border border-base-300 p-3">
            <h4 class="text-sm font-bold mb-2">监听模式(互斥,二选一)</h4>
            <label class="dopt" onclick="pickMode('ls','all')">
              <input type="radio" name="activeMode" value="all" <%= listen.activeMode === 'all' ? 'checked' : '' %> class="radio radio-sm">
              <span><span class="dopt-title">完全同步</span><span class="text-xs c-sub"> 现有及将来新增的全部歌单自动同步</span></span>
            </label>
            <label class="dopt" onclick="pickMode('ls','filtered')">
              <input type="radio" name="activeMode" value="filtered" <%= listen.activeMode === 'filtered' ? 'checked' : '' %> class="radio radio-sm">
              <span><span class="dopt-title">条件增量同步</span><span class="text-xs c-sub"> 仅规则命中的歌单自动同步</span></span>
            </label>
          </div>

          <div id="ls_all_box" class="rounded-lg border border-base-300 p-3 space-y-2 <%= listen.activeMode === 'all' ? '' : 'hidden' %>">
            <h4 class="text-sm font-bold">完全模式 · 新任务默认设置</h4>
            <div class="flex flex-wrap gap-x-5 gap-y-2 items-center">
              <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" name="all[createSameNamePlaylist]" value="1" <%= listen.all.createSameNamePlaylist ? 'checked' : '' %> class="checkbox checkbox-sm"><span class="text-sm">同名播放列表(自动生成)</span></label>
              <select name="all[taskMode]" class="select select-bordered">
                <option value="incremental" <%= listen.all.taskMode === 'incremental' ? 'selected' : '' %>>增量</option>
                <option value="mirror" <%= listen.all.taskMode === 'mirror' ? 'selected' : '' %>>镜像</option>
              </select>
              <select name="all[delPolicy]" class="select select-bordered">
                <option value="keep">删除处理1(歌单移除+文件不删)</option>
                <option value="delete" <%= listen.all.delPolicy === 'delete' && fileDeleteOK ? 'selected' : '' %> <%= fileDeleteOK ? '' : 'disabled' %>>处理2:歌单移除+删文件<% if (!fileDeleteOK) { %>(当前 <%= targetName %> 不支持)<% } %></option>
                <option value="archive" <%= listen.all.delPolicy === 'archive' ? 'selected' : '' %>>处理3:移入归档歌单</option>
              </select>
              <input name="all[archivePlaylist]" class="input input-bordered input-sm" style="width:11rem" value="<%= listen.all.archivePlaylist %>">
              <span class="text-xs c-sub">新任务 cron</span>
              <input name="all[taskCron]" class="input input-bordered input-sm font-mono text-xs" style="width:9rem" value="<%= listen.all.taskCron %>">
            </div>
          </div>

          <div id="ls_filtered_box" class="rounded-lg border border-base-300 p-3 space-y-2 <%= listen.activeMode === 'filtered' ? '' : 'hidden' %>">
            <h4 class="text-sm font-bold">条件模式 · 规则筛选</h4>
            <div class="flex flex-col gap-3 md:flex-row">
              <div class="rounded-lg border border-base-300 p-2.5 flex-1">
                <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" name="filtered[rules][exclude][enabled]" value="1" <%= listen.filtered.rules.exclude.enabled ? 'checked' : '' %> class="checkbox checkbox-xs"><span class="text-sm font-semibold">排除</span><span class="text-xs c-sub">(命中不同步)</span></label>
                <input name="filtered[rules][exclude][keywords]" class="input input-bordered input-sm w-full mt-1" placeholder="歌单名关键词,逗号分隔" value="<%= listen.filtered.rules.exclude.keywords.join(',') %>">
              </div>
              <div class="rounded-lg border border-base-300 p-2.5 flex-1">
                <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" name="filtered[rules][match][enabled]" value="1" <%= listen.filtered.rules.match.enabled ? 'checked' : '' %> class="checkbox checkbox-xs"><span class="text-sm font-semibold">匹配</span><span class="text-xs c-sub">(命中才同步)</span></label>
                <input name="filtered[rules][match][keywords]" class="input input-bordered input-sm w-full mt-1" placeholder="歌单名关键词,逗号分隔" value="<%= listen.filtered.rules.match.keywords.join(',') %>">
              </div>
            </div>
            <p class="text-xs c-sub">语义:排除优先;只开匹配=仅命中项;只开排除=全量减排除。变更只影响之后新出现的歌单(不回溯)。</p>
            <h5 class="text-sm font-bold pt-1">条件模式 · 新任务默认设置</h5>
            <div class="flex flex-wrap gap-x-4 gap-y-2 items-center">
              <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" name="filtered[params][createSameNamePlaylist]" value="1" <%= listen.filtered.params.createSameNamePlaylist ? 'checked' : '' %> class="checkbox checkbox-sm"><span class="text-sm">同名自动生成</span></label>
              <select name="filtered[params][taskMode]" class="select select-bordered">
                <option value="incremental" <%= listen.filtered.params.taskMode === 'incremental' ? 'selected' : '' %>>增量</option>
                <option value="mirror" <%= listen.filtered.params.taskMode === 'mirror' ? 'selected' : '' %>>镜像</option>
              </select>
              <select name="filtered[params][delPolicy]" class="select select-bordered">
                <option value="keep">删除处理1</option>
                <option value="delete" <%= listen.filtered.params.delPolicy === 'delete' && fileDeleteOK ? 'selected' : '' %> <%= fileDeleteOK ? '' : 'disabled' %>>处理2<% if (!fileDeleteOK) { %>(不支持)<% } %></option>
                <option value="archive" <%= listen.filtered.params.delPolicy === 'archive' ? 'selected' : '' %>>处理3</option>
              </select>
              <input name="filtered[params][archivePlaylist]" class="input input-bordered input-sm" style="width:10rem" value="<%= listen.filtered.params.archivePlaylist %>">
              <input name="filtered[params][taskCron]" class="input input-bordered input-sm font-mono text-xs" style="width:9rem" value="<%= listen.filtered.params.taskCron %>" placeholder="任务 cron">
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <button type="button" class="btn btn-outline btn-xs px-2" hx-post="/listen/switch" hx-vals='{"mode":"<%= listen.activeMode %>","taskPolicy":"pause"}' hx-target="#listen-msg">暂停当前模式自动任务(可恢复)</button>
            <button type="button" class="btn btn-ghost btn-xs px-2" hx-post="/listen/resume" hx-vals='{"mode":"<%= listen.activeMode %>"}' hx-target="#listen-msg">恢复自动任务</button>
            <span class="text-xs c-sub">模式互斥:开启一种自动关闭另一种;旧任务默认保持运行(A+C,绝不自动删除)</span>
          </div>

          <div id="listen-msg" class="text-sm"></div>
          <div class="card-actions border-t border-base-200 pt-3">
            <button type="submit" class="btn btn-primary"><svg aria-hidden="true"><use href="#i-save"/></svg>保存监听设置</button>
          </div>
        </form>
      </div>

    </div>
  </section>
</div>

<script>
// ===== 轻量联动 =====
function switchCT(n) {
  document.getElementById('cpanel1').style.display = n === 1 ? '' : 'none'
  document.getElementById('cpanel2').style.display = n === 2 ? '' : 'none'
  document.getElementById('ctab1').classList.toggle('active', n === 1)
  document.getElementById('ctab2').classList.toggle('active', n === 2)
}
function mkRefresh() {
  var c = document.getElementById('mk_exist').checked
  document.getElementById('mk_existbox').style.display = c ? '' : 'none'
  var mirror = document.querySelector('input[name="mode"]:checked')
  var isMirror = mirror && mirror.value === 'mirror'
  document.getElementById('mk_note').style.display = (c && isMirror) ? '' : 'none'
}
function pickMode(scope, val) {
  if (scope === 'mk') {
    var r = document.querySelector('input[name="mode"][value="' + val + '"]')
    if (r) r.checked = true
    document.getElementById('mk_delbox').style.display = val === 'mirror' ? '' : 'none'
    var dis = val !== 'mirror'
    document.querySelectorAll('#mk_delbox input').forEach(function (x) { x.disabled = dis })
    mkRefresh()
  } else {
    var r2 = document.querySelector('input[name="activeMode"][value="' + val + '"]')
    if (r2) r2.checked = true
    var all = val === 'all'
    document.getElementById('ls_all_box').classList.toggle('hidden', !all)
    document.getElementById('ls_filtered_box').classList.toggle('hidden', all)
    document.getElementById('mode-chip').textContent = '监听:' + (all ? '完全同步' : '条件增量')
  }
}
(function () {
  pickMode('mk', 'incremental')
})()
</script>
