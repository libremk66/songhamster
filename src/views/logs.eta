<div class="space-y-4">

  <!-- ===== 页头 ===== -->
  <header>
    <div class="flex items-center gap-2 flex-wrap">
      <h2 class="text-lg font-extrabold tracking-tight">日志</h2>
      <span class="badge badge-outline badge-sm font-normal px-2 py-1 text-xs">每 3 秒自动刷新</span>
    </div>
  </header>

  <section class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body p-2">
      <div id="log-area" hx-get="/api/logs/partial" hx-trigger="load, every 3s" hx-swap="innerHTML">
        <pre class="font-mono text-xs leading-relaxed p-3 overflow-auto" style="max-height:72vh"><%= logs %></pre>
      </div>
    </div>
  </section>

</div>
