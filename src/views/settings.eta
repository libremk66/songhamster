<div class="space-y-4">

  <!-- ===== 页头 ===== -->
  <header>
    <div class="flex items-center gap-2 flex-wrap">
      <h2 class="text-lg font-extrabold tracking-tight">设置</h2>
    </div>
  </header>

  <!-- ===== 通用 ===== -->
  <form method="post" action="/api/config/general" hx-post="/api/config/general" hx-target="#gen-msg"
        class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-3">
      <h3 class="card-title text-base">通用</h3>
      <div class="fg">
        <label class="form-control w-full">
          <span class="label-text mb-1">日志保留天数</span>
          <input type="number" name="logRetentionDays" value="<%= cfg.general.logRetentionDays %>" min="1" max="365" class="input input-bordered w-28">
          <span class="text-xs c-sub mt-1">日志按天存在 <code class="bg-base-200 px-1 rounded">data/logs/</code>；启动时清理超过该天数的旧文件。1~365 天，默认 30。</span>
        </label>
      </div>
      <div class="card-actions flex flex-wrap items-center gap-2 border-t border-base-200 pt-3">
        <button type="submit" class="btn btn-primary"><svg aria-hidden="true"><use href="#i-save"/></svg>保存</button>
        <span id="gen-msg" class="text-sm"></span>
      </div>
    </div>
  </form>

  <!-- ===== 账号安全 ===== -->
  <form method="post" action="/api/auth/settings" hx-post="/api/auth/settings" hx-target="#auth-msg"
        class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-3">
      <h3 class="card-title text-base">账号安全</h3>
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" name="enabled" value="1" <%= cfg.auth.enabled ? 'checked' : '' %> class="checkbox checkbox-sm">
        <span class="text-sm">启用账号认证（登录后访问）</span>
      </label>
      <div class="fg">
        <label class="form-control w-full">
          <span class="label-text mb-1">用户名</span>
          <input name="username" value="<%= cfg.auth.username %>" placeholder="admin" class="input input-bordered w-56">
        </label>
        <% if (cfg.auth.enabled) { %>
        <label class="form-control w-full">
          <span class="label-text mb-1">当前密码</span>
          <input type="password" name="currentPassword" placeholder="修改账号需验证" class="input input-bordered w-full">
          <span class="text-xs c-sub mt-1">已启用状态下修改/停用需要验证当前密码</span>
        </label>
        <% } %>
        <label class="form-control w-full">
          <span class="label-text mb-1"><%= cfg.auth.enabled ? '新密码（留空=不改）' : '新密码' %></span>
          <input type="password" name="newPassword" placeholder="" class="input input-bordered w-56">
          <span class="text-xs c-sub mt-1">密码以 scrypt 哈希存储，不保存明文；启用时必填</span>
        </label>
      </div>
      <div class="card-actions flex flex-wrap items-center gap-2 border-t border-base-200 pt-3">
        <button type="submit" class="btn btn-primary"><svg aria-hidden="true"><use href="#i-save"/></svg>保存账号设置</button>
        <span id="auth-msg" class="text-sm"></span>
      </div>
    </div>
  </form>

<!-- ===== 通知 ===== -->
  <form method="post" action="/api/config/notify" hx-post="/api/config/notify" hx-target="#notify-msg"
        class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-3">
      <h3 class="card-title text-base">通知</h3>
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" name="enabled" value="1" <%= cfg.notify.enabled ? 'checked' : '' %> class="checkbox checkbox-sm">
        <span class="text-sm">启用通知（同步跑完或出错时推送一条）</span>
      </label>
      <p class="text-xs c-sub leading-relaxed">每个渠道自己选「订阅哪些事件」——比如"失败推手机、成功只发群里"。<b>通知发送失败只记日志，不影响同步</b>；点「发送测试」用当前填写的内容试发（不必先保存）。</p>

      <% const ch = cfg.notify.channels %>
      <!-- 飞书 -->
      <div class="rounded-lg border border-base-300 p-2.5 space-y-1.5">
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" name="feishu_enabled" value="1" <%= ch.feishu.enabled ? 'checked' : '' %> class="checkbox checkbox-sm">
          <b class="text-sm">飞书</b><span class="text-xs c-sub">群机器人 Webhook（群设置 → 添加机器人 → 自定义机器人）</span>
        </label>
        <input name="feishu_webhook" value="<%= ch.feishu.webhook %>" placeholder="https://open.feishu.cn/open-apis/bot/v2/hook/…" class="input input-bordered input-sm w-full font-mono text-xs">
        <input name="feishu_secret" value="<%= ch.feishu.secret %>" placeholder="签名密钥（机器人开了「签名校验」才填）" class="input input-bordered input-sm w-full font-mono text-xs">
        <%~ include('partials/notify-events.eta', { type: 'feishu', events: ch.feishu.events }) %>
        <button type="button" class="btn btn-ghost btn-xs" hx-post="/api/notify/test/feishu" hx-include="closest form" hx-target="#notify-msg" hx-swap="innerHTML">发送测试</button>
      </div>

      <!-- Bark -->
      <div class="rounded-lg border border-base-300 p-2.5 space-y-1.5">
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" name="bark_enabled" value="1" <%= ch.bark.enabled ? 'checked' : '' %> class="checkbox checkbox-sm">
          <b class="text-sm">Bark</b><span class="text-xs c-sub">iPhone 推送</span>
        </label>
        <input name="bark_server" value="<%= ch.bark.server %>" placeholder="https://api.day.app" class="input input-bordered input-sm w-full font-mono text-xs">
        <input name="bark_key" value="<%= ch.bark.key %>" placeholder="你的 Bark Key" class="input input-bordered input-sm w-full font-mono text-xs">
        <%~ include('partials/notify-events.eta', { type: 'bark', events: ch.bark.events }) %>
        <button type="button" class="btn btn-ghost btn-xs" hx-post="/api/notify/test/bark" hx-include="closest form" hx-target="#notify-msg" hx-swap="innerHTML">发送测试</button>
      </div>

      <!-- Server酱 -->
      <div class="rounded-lg border border-base-300 p-2.5 space-y-1.5">
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" name="serverchan_enabled" value="1" <%= ch.serverchan.enabled ? 'checked' : '' %> class="checkbox checkbox-sm">
          <b class="text-sm">Server酱</b><span class="text-xs c-sub">推送到微信</span>
        </label>
        <input name="serverchan_key" value="<%= ch.serverchan.sendKey %>" placeholder="SendKey（sct.ftqq.com 获取）" class="input input-bordered input-sm w-full font-mono text-xs">
        <%~ include('partials/notify-events.eta', { type: 'serverchan', events: ch.serverchan.events }) %>
        <button type="button" class="btn btn-ghost btn-xs" hx-post="/api/notify/test/serverchan" hx-include="closest form" hx-target="#notify-msg" hx-swap="innerHTML">发送测试</button>
      </div>

      <!-- 自定义 Webhook -->
      <div class="rounded-lg border border-base-300 p-2.5 space-y-1.5">
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" name="webhook_enabled" value="1" <%= ch.webhook.enabled ? 'checked' : '' %> class="checkbox checkbox-sm">
          <b class="text-sm">自定义 Webhook</b><span class="text-xs c-sub">接你自己的服务</span>
        </label>
        <div class="flex gap-2">
          <select name="webhook_method" class="select select-bordered select-sm w-24">
            <option value="POST" <%= ch.webhook.method === 'POST' ? 'selected' : '' %>>POST</option>
            <option value="GET" <%= ch.webhook.method === 'GET' ? 'selected' : '' %>>GET</option>
          </select>
          <input name="webhook_url" value="<%= ch.webhook.url %>" placeholder="https://…（GET 时可用 {title} {text} 占位）" class="input input-bordered input-sm w-full font-mono text-xs">
        </div>
        <input name="webhook_headers" value="<%= ch.webhook.headers %>" placeholder='自定义请求头 JSON，如 {"Authorization":"Bearer xxx"}' class="input input-bordered input-sm w-full font-mono text-xs">
        <input name="webhook_body" value="<%= ch.webhook.bodyTemplate %>" placeholder='POST 的 body 模板（可用 {title} {text}），留空发 {"title":…,"text":…}' class="input input-bordered input-sm w-full font-mono text-xs">
        <%~ include('partials/notify-events.eta', { type: 'webhook', events: ch.webhook.events }) %>
        <button type="button" class="btn btn-ghost btn-xs" hx-post="/api/notify/test/webhook" hx-include="closest form" hx-target="#notify-msg" hx-swap="innerHTML">发送测试</button>
      </div>

      <div class="card-actions flex flex-wrap items-center gap-2 border-t border-base-200 pt-3">
        <button type="submit" class="btn btn-primary">保存通知设置</button>
        <span id="notify-msg" class="text-sm"></span>
      </div>
    </div>
  </form>

<% if (false) { /* 高级设置：暂时不开发，先隐藏；要恢复就把本行改成 if (true) */ %>
  <!-- ===== 高级设置 ===== -->
  <form method="post" action="/api/config/advanced" hx-post="/api/config/advanced" hx-target="#adv-msg"
        class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-3">
      <h3 class="card-title text-base">高级设置</h3>
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" name="dedupCheck" value="1" id="adv-dd" onchange="toggleAdvQ()" <%= cfg.advanced.dedupCheck ? 'checked' : '' %> class="checkbox checkbox-sm">
        <span class="text-sm">同步前查重</span>
      </label>
      <p class="text-xs c-sub leading-relaxed">默认关闭，开启后每首歌都需查一次 <%= targetName %>，耗时增加。同步歌单前先检查 <%= targetName %> 曲库：已存在对应歌曲则跳过该曲的 LX 搜索下载，仅执行歌单加入（全库查重）。适用于「库中已有高音质不想重复下载」的场景。</p>
      <div id="adv-dedup-q" style="display:<%= cfg.advanced.dedupCheck ? '' : 'none' %>">
        <div class="prow">
          <span class="p-lbl" style="width:9em">查重音质门槛</span>
          <select name="dedupMinQuality" class="select select-bordered" style="width:16rem">
            <option value="">不检查音质（任意存在即跳过）</option>
            <% for (const q of qOrder) { %>
            <option value="<%= q %>" <%= cfg.advanced.dedupMinQuality === q ? 'selected' : '' %>><%= qLabels[q] %></option>
            <% } %>
          </select>
        </div>
        <p class="text-xs c-sub mt-1">库内已有音质 ≥ 所选档位 → 跳过下载；低于所选（如只有 320k）→ 视为缺失，继续下载高音质</p>
      </div>
      <div class="card-actions flex flex-wrap items-center gap-2 border-t border-base-200 pt-3">
        <button type="submit" class="btn btn-primary"><svg aria-hidden="true"><use href="#i-save"/></svg>保存高级设置</button>
        <span id="adv-msg" class="text-sm"></span>
      </div>
    </div>
  </form>

<% } %>
  <!-- ===== 运行信息 ===== -->
  <section class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-1">
      <h3 class="card-title text-base">运行信息</h3>
      <p class="text-xs c-sub leading-relaxed">
        配置: <code class="bg-base-200 px-1 rounded">data/config.yaml</code> ｜ 数据库: <code class="bg-base-200 px-1 rounded">data/songhamster.db</code><br>
        Emby 媒体库 Id: <code class="bg-base-200 px-1 rounded"><%= cfg.emby.mediaLibraryId || '未探测' %></code>
      </p>
    </div>
  </section>

</div>

<script>
function toggleAdvQ() {
  var el = document.getElementById('adv-dd')
  var q = document.getElementById('adv-dedup-q')
  if (q) q.style.display = el.checked ? '' : 'none'
}
</script>
