<div class="space-y-4">

  <!-- ===== 页头 ===== -->
  <header>
    <div class="flex items-center gap-2 flex-wrap">
      <h2 class="text-lg font-extrabold tracking-tight">设置</h2>
    </div>
  </header>

  <!-- ===== 通用 ===== -->
  <form method="post" action="/api/config/general" hx-post="/api/config/general" hx-target="#gen-msg"
        class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-3">
      <h3 class="card-title text-base">通用</h3>
      <div class="fg">
        <label class="form-control w-full">
          <span class="label-text mb-1">日志保留天数</span>
          <input type="number" name="logRetentionDays" value="<%= cfg.general.logRetentionDays %>" min="1" max="365" class="input input-bordered w-28">
          <span class="text-xs c-sub mt-1">日志按天存在 <code class="bg-base-200 px-1 rounded">data/logs/</code>；启动时清理超过该天数的旧文件。1~365 天，默认 30。</span>
        </label>
      </div>
      <div class="card-actions flex flex-wrap items-center gap-2 border-t border-base-200 pt-3">
        <button type="submit" class="btn btn-primary"><svg aria-hidden="true"><use href="#i-save"/></svg>保存</button>
        <span id="gen-msg" class="text-sm"></span>
      </div>
    </div>
  </form>

  <!-- ===== 账号安全 ===== -->
  <form method="post" action="/api/auth/settings" hx-post="/api/auth/settings" hx-target="#auth-msg"
        class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-3">
      <h3 class="card-title text-base">账号安全</h3>
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" name="enabled" value="1" <%= cfg.auth.enabled ? 'checked' : '' %> class="checkbox checkbox-sm">
        <span class="text-sm">启用账号认证（登录后访问）</span>
      </label>
      <div class="fg">
        <label class="form-control w-full">
          <span class="label-text mb-1">用户名</span>
          <input name="username" value="<%= cfg.auth.username %>" placeholder="admin" class="input input-bordered w-56">
        </label>
        <% if (cfg.auth.enabled) { %>
        <label class="form-control w-full">
          <span class="label-text mb-1">当前密码</span>
          <input type="password" name="currentPassword" placeholder="修改账号需验证" class="input input-bordered w-full">
          <span class="text-xs c-sub mt-1">已启用状态下修改/停用需要验证当前密码</span>
        </label>
        <% } %>
        <label class="form-control w-full">
          <span class="label-text mb-1"><%= cfg.auth.enabled ? '新密码（留空=不改）' : '新密码' %></span>
          <input type="password" name="newPassword" placeholder="" class="input input-bordered w-56">
          <span class="text-xs c-sub mt-1">密码以 scrypt 哈希存储，不保存明文；启用时必填</span>
        </label>
      </div>
      <div class="card-actions flex flex-wrap items-center gap-2 border-t border-base-200 pt-3">
        <button type="submit" class="btn btn-primary"><svg aria-hidden="true"><use href="#i-save"/></svg>保存账号设置</button>
        <span id="auth-msg" class="text-sm"></span>
      </div>
    </div>
  </form>

<% if (false) { /* 通知（预留）/ 高级设置：暂时不开发，先隐藏；要恢复就把本行改成 if (true) */ %>
  <!-- ===== 通知（预留） ===== -->
  <section class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-2">
      <h3 class="card-title text-base">通知（预留）</h3>
      <p class="text-xs c-sub">通知功能规划中：飞书 webhook 配置将在后续版本开放。</p>
      <label class="form-control w-full">
        <span class="label-text mb-1">飞书 Webhook（占位）</span>
        <input disabled placeholder="https://open.feishu.cn/open-apis/bot/v2/hook/xxx" class="input input-bordered w-full opacity-60">
      </label>
    </div>
  </section>

  <!-- ===== 高级设置 ===== -->
  <form method="post" action="/api/config/advanced" hx-post="/api/config/advanced" hx-target="#adv-msg"
        class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-3">
      <h3 class="card-title text-base">高级设置</h3>
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" name="dedupCheck" value="1" id="adv-dd" onchange="toggleAdvQ()" <%= cfg.advanced.dedupCheck ? 'checked' : '' %> class="checkbox checkbox-sm">
        <span class="text-sm">同步前查重</span>
      </label>
      <p class="text-xs c-sub leading-relaxed">默认关闭，开启后每首歌都需查一次 <%= targetName %>，耗时增加。同步歌单前先检查 <%= targetName %> 曲库：已存在对应歌曲则跳过该曲的 LX 搜索下载，仅执行歌单加入（全库查重）。适用于「库中已有高音质不想重复下载」的场景。</p>
      <div id="adv-dedup-q" style="display:<%= cfg.advanced.dedupCheck ? '' : 'none' %>">
        <div class="prow">
          <span class="p-lbl" style="width:9em">查重音质门槛</span>
          <select name="dedupMinQuality" class="select select-bordered" style="width:16rem">
            <option value="">不检查音质（任意存在即跳过）</option>
            <% for (const q of qOrder) { %>
            <option value="<%= q %>" <%= cfg.advanced.dedupMinQuality === q ? 'selected' : '' %>><%= qLabels[q] %></option>
            <% } %>
          </select>
        </div>
        <p class="text-xs c-sub mt-1">库内已有音质 ≥ 所选档位 → 跳过下载；低于所选（如只有 320k）→ 视为缺失，继续下载高音质</p>
      </div>
      <div class="card-actions flex flex-wrap items-center gap-2 border-t border-base-200 pt-3">
        <button type="submit" class="btn btn-primary"><svg aria-hidden="true"><use href="#i-save"/></svg>保存高级设置</button>
        <span id="adv-msg" class="text-sm"></span>
      </div>
    </div>
  </form>

<% } %>
  <!-- ===== 运行信息 ===== -->
  <section class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-1">
      <h3 class="card-title text-base">运行信息</h3>
      <p class="text-xs c-sub leading-relaxed">
        配置: <code class="bg-base-200 px-1 rounded">data/config.yaml</code> ｜ 数据库: <code class="bg-base-200 px-1 rounded">data/songhamster.db</code><br>
        Emby 媒体库 Id: <code class="bg-base-200 px-1 rounded"><%= cfg.emby.mediaLibraryId || '未探测' %></code>
      </p>
    </div>
  </section>

</div>

<script>
function toggleAdvQ() {
  var el = document.getElementById('adv-dd')
  var q = document.getElementById('adv-dedup-q')
  if (q) q.style.display = el.checked ? '' : 'none'
}
</script>
