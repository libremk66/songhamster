<div class="space-y-4">

  <!-- ===== 页头 ===== -->
  <header>
    <div class="flex items-center gap-2 flex-wrap">
      <h2 class="text-lg font-extrabold tracking-tight">设置</h2>
    </div>
  </header>

  <!-- ===== 通用 ===== -->
  <form method="post" action="/api/config/general" hx-post="/api/config/general" hx-target="#gen-msg"
        class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-3">
      <h3 class="card-title text-base">通用</h3>
      <div class="fg">
        <label class="form-control w-full">
          <span class="label-text mb-1">日志保留天数</span>
          <input type="number" name="logRetentionDays" value="<%= cfg.general.logRetentionDays %>" min="1" max="365" class="input input-bordered w-28">
          <span class="text-xs c-sub mt-1">日志按天存在 <code class="bg-base-200 px-1 rounded">data/logs/</code>；启动时清理超过该天数的旧文件。1~365 天，默认 30。</span>
        </label>
      </div>
      <div class="card-actions flex flex-wrap items-center gap-2 border-t border-base-200 pt-3">
        <button type="submit" class="btn btn-primary"><svg aria-hidden="true"><use href="#i-save"/></svg>保存</button>
        <span id="gen-msg" class="text-sm"></span>
      </div>
    </div>
  </form>

  <!-- ===== 账号安全 ===== -->
  <form method="post" action="/api/auth/settings" hx-post="/api/auth/settings" hx-target="#auth-msg"
        class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-3">
      <h3 class="card-title text-base">账号安全</h3>
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" name="enabled" value="1" <%= cfg.auth.enabled ? 'checked' : '' %> class="checkbox checkbox-sm">
        <span class="text-sm">启用账号认证（登录后访问）</span>
      </label>
      <div class="fg">
        <label class="form-control w-full">
          <span class="label-text mb-1">用户名</span>
          <input name="username" value="<%= cfg.auth.username %>" placeholder="admin" class="input input-bordered w-56">
        </label>
        <% if (cfg.auth.enabled) { %>
        <label class="form-control w-full">
          <span class="label-text mb-1">当前密码</span>
          <input type="password" name="currentPassword" placeholder="修改账号需验证" class="input input-bordered w-full">
          <span class="text-xs c-sub mt-1">已启用状态下修改/停用需要验证当前密码</span>
        </label>
        <% } %>
        <label class="form-control w-full">
          <span class="label-text mb-1"><%= cfg.auth.enabled ? '新密码（留空=不改）' : '新密码' %></span>
          <input type="password" name="newPassword" placeholder="" class="input input-bordered w-56">
          <span class="text-xs c-sub mt-1">密码以 scrypt 哈希存储，不保存明文；启用时必填</span>
        </label>
      </div>
      <div class="card-actions flex flex-wrap items-center gap-2 border-t border-base-200 pt-3">
        <button type="submit" class="btn btn-primary"><svg aria-hidden="true"><use href="#i-save"/></svg>保存账号设置</button>
        <span id="auth-msg" class="text-sm"></span>
      </div>
    </div>
  </form>

<!-- ===== 通知 ===== -->
  <style>
    /* 渠道子标签（与进度历史页的子标签同款胶囊样式） */
    .nt-tab { display: inline-flex; align-items: center; gap: .35rem; padding: .25rem .8rem; font-size: .8125rem;
              cursor: pointer; background: oklch(var(--b1)); color: oklch(var(--bc) / .75);
              border: 1px solid oklch(var(--bc) / .22); border-radius: 999px; transition: color .15s, border-color .15s, background .15s; }
    .nt-tab:hover { border-color: var(--sfg); color: var(--sfg-deep); }
    .nt-tab.active { background: var(--sfg-fill); border-color: var(--sfg-fill); color: #fff; font-weight: 650; }
    .nt-dot { width: .45rem; height: .45rem; border-radius: 999px; background: oklch(var(--bc) / .3); flex-shrink: 0; }
    .nt-dot.on { background: #22c55e; }
  </style>
  <section class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-2">
      <h3 class="card-title text-base">通知</h3>
      <p class="text-xs c-sub leading-relaxed">同步跑完或出错时推一条。<b>每个渠道单独选订阅哪些事件</b>（比如"失败推手机、成功只发群里"）；<b>发送失败只记日志，不影响同步</b>。</p>

      <% const ch = cfg.notify.channels %>
      <% const NT = [
        { key: 'feishu', label: '飞书', on: ch.feishu.enabled },
        { key: 'wecom', label: '企业微信', on: ch.wecom.enabled },
        { key: 'dingtalk', label: '钉钉', on: ch.dingtalk.enabled },
        { key: 'bark', label: 'Bark', on: ch.bark.enabled },
        { key: 'serverchan', label: 'Server酱', on: ch.serverchan.enabled },
        { key: 'telegram', label: 'Telegram', on: ch.telegram.enabled },
        { key: 'webhook', label: '自定义 Webhook', on: ch.webhook.enabled },
      ] %>
      <% const byKey = Object.fromEntries(NT.map((x) => [x.key, x])) %>

      <div class="space-y-1">
        <% for (const g of ntGroups) { %>
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="text-xs c-sub w-14 flex-shrink-0"><%= g.label %></span>
          <% for (const k of g.types) { const t = byKey[k]; if (!t) continue; %>
          <button type="button" class="nt-tab <%= t.key === 'feishu' ? 'active' : '' %>" id="nt-tab-<%= t.key %>" onclick="ntSwitch('<%= t.key %>')">
            <span class="nt-dot <%= t.on ? 'on' : '' %>"></span><%= t.label %>
          </button>
          <% } %>
        </div>
        <% } %>
      </div>

      <form method="post" action="/api/config/notify" hx-post="/api/config/notify" hx-target="#notify-msg" class="space-y-2 mt-1">
        <!-- 飞书 -->
        <div id="nt-pane-feishu" class="nt-pane space-y-1.5">
          <p class="text-xs c-sub">群的「设置 → 群机器人 → 添加机器人 → 自定义机器人」，把 Webhook 地址粘过来</p>
          <input name="feishu_webhook" value="<%= ch.feishu.webhook %>" placeholder="https://open.feishu.cn/open-apis/bot/v2/hook/…" class="input input-bordered input-sm w-full font-mono text-xs">
          <input name="feishu_secret" value="<%= ch.feishu.secret %>" placeholder="签名密钥（机器人开了「签名校验」才填）" class="input input-bordered input-sm w-full font-mono text-xs">
          <%~ include('partials/notify-events.eta', { type: 'feishu', events: ch.feishu.events }) %>
          <div class="flex flex-wrap items-center gap-2">
            <button type="button" class="btn btn-primary btn-sm" hx-post="/api/config/notify" hx-vals='{"enable":"feishu"}' hx-include="closest form" hx-target="#notify-msg"
                    hx-on::after-request="if(event.detail.successful) ntSetDot('feishu', true)">保存启用</button>
            <button type="button" class="btn btn-ghost btn-sm" hx-post="/api/config/notify" hx-vals='{"disable":"feishu"}' hx-include="closest form" hx-target="#notify-msg"
                    hx-on::after-request="if(event.detail.successful) ntSetDot('feishu', false)">停用</button>
            <button type="button" class="btn btn-outline btn-sm" hx-post="/api/notify/test/feishu" hx-include="closest form" hx-target="#notify-msg">发送测试</button>
          </div>
        </div>

        <!-- 企业微信 -->
        <div id="nt-pane-wecom" class="nt-pane hidden space-y-1.5">
          <p class="text-xs c-sub">企业微信群 → 群机器人 → 添加机器人 → 复制 Webhook 地址（内容上限 2048 字节，超长会自动截断）</p>
          <input name="wecom_webhook" value="<%= ch.wecom.webhook %>" placeholder="https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=…" class="input input-bordered input-sm w-full font-mono text-xs">
          <%~ include('partials/notify-events.eta', { type: 'wecom', events: ch.wecom.events }) %>
          <div class="flex flex-wrap items-center gap-2">
            <button type="button" class="btn btn-primary btn-sm" hx-post="/api/config/notify" hx-vals='{"enable":"wecom"}' hx-include="closest form" hx-target="#notify-msg"
                    hx-on::after-request="if(event.detail.successful) ntSetDot('wecom', true)">保存启用</button>
            <button type="button" class="btn btn-ghost btn-sm" hx-post="/api/config/notify" hx-vals='{"disable":"wecom"}' hx-include="closest form" hx-target="#notify-msg"
                    hx-on::after-request="if(event.detail.successful) ntSetDot('wecom', false)">停用</button>
            <button type="button" class="btn btn-outline btn-sm" hx-post="/api/notify/test/wecom" hx-include="closest form" hx-target="#notify-msg">发送测试</button>
          </div>
        </div>

        <!-- 钉钉 -->
        <div id="nt-pane-dingtalk" class="nt-pane hidden space-y-1.5">
          <p class="text-xs c-sub">钉钉群 → 群设置 → 智能群助手 → 添加机器人 → 自定义；安全设置选了「加签」就把密钥也填上</p>
          <input name="dingtalk_webhook" value="<%= ch.dingtalk.webhook %>" placeholder="https://oapi.dingtalk.com/robot/send?access_token=…" class="input input-bordered input-sm w-full font-mono text-xs">
          <input name="dingtalk_secret" value="<%= ch.dingtalk.secret %>" placeholder="加签密钥（安全设置选了「加签」才填）" class="input input-bordered input-sm w-full font-mono text-xs">
          <%~ include('partials/notify-events.eta', { type: 'dingtalk', events: ch.dingtalk.events }) %>
          <div class="flex flex-wrap items-center gap-2">
            <button type="button" class="btn btn-primary btn-sm" hx-post="/api/config/notify" hx-vals='{"enable":"dingtalk"}' hx-include="closest form" hx-target="#notify-msg"
                    hx-on::after-request="if(event.detail.successful) ntSetDot('dingtalk', true)">保存启用</button>
            <button type="button" class="btn btn-ghost btn-sm" hx-post="/api/config/notify" hx-vals='{"disable":"dingtalk"}' hx-include="closest form" hx-target="#notify-msg"
                    hx-on::after-request="if(event.detail.successful) ntSetDot('dingtalk', false)">停用</button>
            <button type="button" class="btn btn-outline btn-sm" hx-post="/api/notify/test/dingtalk" hx-include="closest form" hx-target="#notify-msg">发送测试</button>
          </div>
        </div>

        <!-- Bark -->
        <div id="nt-pane-bark" class="nt-pane hidden space-y-1.5">
          <p class="text-xs c-sub">iPhone 装 Bark，把推送地址里的 Key 填进来（服务器地址一般不用改）</p>
          <input name="bark_server" value="<%= ch.bark.server %>" placeholder="https://api.day.app" class="input input-bordered input-sm w-full font-mono text-xs">
          <input name="bark_key" value="<%= ch.bark.key %>" placeholder="你的 Bark Key" class="input input-bordered input-sm w-full font-mono text-xs">
          <%~ include('partials/notify-events.eta', { type: 'bark', events: ch.bark.events }) %>
          <div class="flex flex-wrap items-center gap-2">
            <button type="button" class="btn btn-primary btn-sm" hx-post="/api/config/notify" hx-vals='{"enable":"bark"}' hx-include="closest form" hx-target="#notify-msg"
                    hx-on::after-request="if(event.detail.successful) ntSetDot('bark', true)">保存启用</button>
            <button type="button" class="btn btn-ghost btn-sm" hx-post="/api/config/notify" hx-vals='{"disable":"bark"}' hx-include="closest form" hx-target="#notify-msg"
                    hx-on::after-request="if(event.detail.successful) ntSetDot('bark', false)">停用</button>
            <button type="button" class="btn btn-outline btn-sm" hx-post="/api/notify/test/bark" hx-include="closest form" hx-target="#notify-msg">发送测试</button>
          </div>
        </div>

        <!-- Server酱 -->
        <div id="nt-pane-serverchan" class="nt-pane hidden space-y-1.5">
          <p class="text-xs c-sub">到 sct.ftqq.com 登录后复制 SendKey</p>
          <input name="serverchan_key" value="<%= ch.serverchan.sendKey %>" placeholder="SendKey" class="input input-bordered input-sm w-full font-mono text-xs">
          <%~ include('partials/notify-events.eta', { type: 'serverchan', events: ch.serverchan.events }) %>
          <div class="flex flex-wrap items-center gap-2">
            <button type="button" class="btn btn-primary btn-sm" hx-post="/api/config/notify" hx-vals='{"enable":"serverchan"}' hx-include="closest form" hx-target="#notify-msg"
                    hx-on::after-request="if(event.detail.successful) ntSetDot('serverchan', true)">保存启用</button>
            <button type="button" class="btn btn-ghost btn-sm" hx-post="/api/config/notify" hx-vals='{"disable":"serverchan"}' hx-include="closest form" hx-target="#notify-msg"
                    hx-on::after-request="if(event.detail.successful) ntSetDot('serverchan', false)">停用</button>
            <button type="button" class="btn btn-outline btn-sm" hx-post="/api/notify/test/serverchan" hx-include="closest form" hx-target="#notify-msg">发送测试</button>
          </div>
        </div>

        <!-- Telegram -->
        <div id="nt-pane-telegram" class="nt-pane hidden space-y-1.5">
          <p class="text-xs c-sub">@BotFather 建机器人拿 Token；chat_id 可给机器人发条消息后从 getUpdates 里看。国内直连不通时把 API 地址换成自建反代</p>
          <input name="telegram_token" value="<%= ch.telegram.token %>" placeholder="Bot Token，如 123456:ABC-DEF…" class="input input-bordered input-sm w-full font-mono text-xs">
          <input name="telegram_chat" value="<%= ch.telegram.chatId %>" placeholder="chat_id，如 123456789 或 -1001234567890" class="input input-bordered input-sm w-full font-mono text-xs">
          <input name="telegram_base" value="<%= ch.telegram.apiBase %>" placeholder="https://api.telegram.org" class="input input-bordered input-sm w-full font-mono text-xs">
          <%~ include('partials/notify-events.eta', { type: 'telegram', events: ch.telegram.events }) %>
          <div class="flex flex-wrap items-center gap-2">
            <button type="button" class="btn btn-primary btn-sm" hx-post="/api/config/notify" hx-vals='{"enable":"telegram"}' hx-include="closest form" hx-target="#notify-msg"
                    hx-on::after-request="if(event.detail.successful) ntSetDot('telegram', true)">保存启用</button>
            <button type="button" class="btn btn-ghost btn-sm" hx-post="/api/config/notify" hx-vals='{"disable":"telegram"}' hx-include="closest form" hx-target="#notify-msg"
                    hx-on::after-request="if(event.detail.successful) ntSetDot('telegram', false)">停用</button>
            <button type="button" class="btn btn-outline btn-sm" hx-post="/api/notify/test/telegram" hx-include="closest form" hx-target="#notify-msg">发送测试</button>
          </div>
        </div>

        <!-- 自定义 Webhook -->
        <div id="nt-pane-webhook" class="nt-pane hidden space-y-1.5">
          <p class="text-xs c-sub">接到你自己的服务：GET 时可用 <code>{title}</code> <code>{text}</code> 占位；POST 留空 body 则发 <code>{"title":…,"text":…}</code></p>
          <div class="flex gap-2">
            <select name="webhook_method" class="select select-bordered select-sm w-24">
              <option value="POST" <%= ch.webhook.method === 'POST' ? 'selected' : '' %>>POST</option>
              <option value="GET" <%= ch.webhook.method === 'GET' ? 'selected' : '' %>>GET</option>
            </select>
            <input name="webhook_url" value="<%= ch.webhook.url %>" placeholder="https://…" class="input input-bordered input-sm w-full font-mono text-xs">
          </div>
          <input name="webhook_headers" value="<%= ch.webhook.headers %>" placeholder='自定义请求头 JSON，如 {"Authorization":"Bearer xxx"}' class="input input-bordered input-sm w-full font-mono text-xs">
          <input name="webhook_body" value="<%= ch.webhook.bodyTemplate %>" placeholder="POST 的 body 模板（可用 {title} {text}）" class="input input-bordered input-sm w-full font-mono text-xs">
          <%~ include('partials/notify-events.eta', { type: 'webhook', events: ch.webhook.events }) %>
          <div class="flex flex-wrap items-center gap-2">
            <button type="button" class="btn btn-primary btn-sm" hx-post="/api/config/notify" hx-vals='{"enable":"webhook"}' hx-include="closest form" hx-target="#notify-msg"
                    hx-on::after-request="if(event.detail.successful) ntSetDot('webhook', true)">保存启用</button>
            <button type="button" class="btn btn-ghost btn-sm" hx-post="/api/config/notify" hx-vals='{"disable":"webhook"}' hx-include="closest form" hx-target="#notify-msg"
                    hx-on::after-request="if(event.detail.successful) ntSetDot('webhook', false)">停用</button>
            <button type="button" class="btn btn-outline btn-sm" hx-post="/api/notify/test/webhook" hx-include="closest form" hx-target="#notify-msg">发送测试</button>
          </div>
        </div>

        <div id="notify-msg" class="text-sm"></div>
      </form>

      <script>
        // 渠道子标签切换（只显示当前渠道，别一屏全铺开）
        function ntSetDot(key, on) {
          var dot = document.querySelector('#nt-tab-' + key + ' .nt-dot')
          if (dot) dot.classList.toggle('on', !!on)
        }
        function ntSwitch(key) {
          ['feishu', 'wecom', 'dingtalk', 'bark', 'serverchan', 'telegram', 'webhook'].forEach(function (k) {
            var tab = document.getElementById('nt-tab-' + k)
            var pane = document.getElementById('nt-pane-' + k)
            if (tab) tab.classList.toggle('active', k === key)
            if (pane) pane.classList.toggle('hidden', k !== key)
          })
        }
      </script>
    </div>
  </section>

<% if (false) { /* 高级设置：暂时不开发，先隐藏；要恢复就把本行改成 if (true) */ %>
  <!-- ===== 高级设置 ===== -->
  <form method="post" action="/api/config/advanced" hx-post="/api/config/advanced" hx-target="#adv-msg"
        class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-3">
      <h3 class="card-title text-base">高级设置</h3>
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" name="dedupCheck" value="1" id="adv-dd" onchange="toggleAdvQ()" <%= cfg.advanced.dedupCheck ? 'checked' : '' %> class="checkbox checkbox-sm">
        <span class="text-sm">同步前查重</span>
      </label>
      <p class="text-xs c-sub leading-relaxed">默认关闭，开启后每首歌都需查一次 <%= targetName %>，耗时增加。同步歌单前先检查 <%= targetName %> 曲库：已存在对应歌曲则跳过该曲的 LX 搜索下载，仅执行歌单加入（全库查重）。适用于「库中已有高音质不想重复下载」的场景。</p>
      <div id="adv-dedup-q" style="display:<%= cfg.advanced.dedupCheck ? '' : 'none' %>">
        <div class="prow">
          <span class="p-lbl" style="width:9em">查重音质门槛</span>
          <select name="dedupMinQuality" class="select select-bordered" style="width:16rem">
            <option value="">不检查音质（任意存在即跳过）</option>
            <% for (const q of qOrder) { %>
            <option value="<%= q %>" <%= cfg.advanced.dedupMinQuality === q ? 'selected' : '' %>><%= qLabels[q] %></option>
            <% } %>
          </select>
        </div>
        <p class="text-xs c-sub mt-1">库内已有音质 ≥ 所选档位 → 跳过下载；低于所选（如只有 320k）→ 视为缺失，继续下载高音质</p>
      </div>
      <div class="card-actions flex flex-wrap items-center gap-2 border-t border-base-200 pt-3">
        <button type="submit" class="btn btn-primary"><svg aria-hidden="true"><use href="#i-save"/></svg>保存高级设置</button>
        <span id="adv-msg" class="text-sm"></span>
      </div>
    </div>
  </form>

<% } %>
  <!-- ===== 运行信息 ===== -->
  <section class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-1">
      <h3 class="card-title text-base">运行信息</h3>
      <p class="text-xs c-sub leading-relaxed">
        配置: <code class="bg-base-200 px-1 rounded">data/config.yaml</code> ｜ 数据库: <code class="bg-base-200 px-1 rounded">data/songhamster.db</code><br>
        Emby 媒体库 Id: <code class="bg-base-200 px-1 rounded"><%= cfg.emby.mediaLibraryId || '未探测' %></code>
      </p>
    </div>
  </section>

</div>

<script>
function toggleAdvQ() {
  var el = document.getElementById('adv-dd')
  var q = document.getElementById('adv-dedup-q')
  if (q) q.style.display = el.checked ? '' : 'none'
}
</script>
