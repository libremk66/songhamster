<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>songferry</title>
  <link rel="stylesheet" href="/static/pico.css">
  <script src="/static/htmx.min.js"></script>
  <style>
    header nav { flex-wrap: wrap; }
    .status-dot { display:inline-block; width:.6em; height:.6em; border-radius:50%; margin-right:.3em; }
    .ok { background:#4caf50; } .bad { background:#f44336; } .muted { background:#999; }
    table.compact td, table.compact th { padding:.3rem .4rem; }
    .hint { color:#8a8a8a; font-size:.85em; }
    main { max-width: 1100px; }
    .card-grid { display:grid; grid-template-columns: repeat(auto-fill, minmax(320px,1fr)); gap:.8rem; }
    details { margin-bottom: .6rem; }
    .row-inline { display:flex; gap:1rem; align-items:flex-end; flex-wrap:wrap; }
    .row-inline > div { flex: 1; min-width: 160px; }
    .quality-check { display:flex; gap:1.5rem; flex-wrap:wrap; align-items:center; }
  </style>
</head>
<body>
  <header class="container">
    <nav>
      <ul><li><strong>🎵 songferry</strong></li></ul>
      <ul>
        <% for (const item of nav) { %>
          <li><a href="/<%= item.id %>" <%= item.id === active ? 'style="font-weight:bold;text-decoration:underline"' : '' %>><%= item.label %></a></li>
        <% } %>
      </ul>
    </nav>
  </header>
  <main class="container">
    <%~ it.content %>
  </main>
  <footer class="container hint">
    songferry v0.1.0 · LX 歌单自动同步入库
  </footer>
</body>
</html>
