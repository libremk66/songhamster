<div class="dup-result-view">
<% const autoIdSet = new Set(autoIds || []) %>
<% const keepIdSet = new Set(keepIds || []) %>
<% const manualN = groups.reduce((n, g) => n + g.items.filter((it) => !keepIdSet.has(it.id) && !(it.inTrash)).length, 0) %>
<% if (threshold) { %>
<div class="btn-row" style="margin:.5rem 0">
  <button hx-post="/api/dupe/delete" hx-vals='{"ids":"<%= autoIds.join(',') %>"}' hx-target="closest .dup-result-view .dup-op-msg" hx-swap="innerHTML"
    hx-on::after-request="htmx.ajax('GET','/api/trash/partial',{target:'#trash-panel'})"
    hx-confirm="将把 <%= autoIds.length %> 首候选移入回收站（可恢复，非物理删除）。确认执行？">移入回收站（<%= autoIds.length %> 首）</button>
  <span class="hint">删除安全缓冲：文件移入回收站可恢复；移入/恢复后点"手动扫库"让 <%= targetName %> 清理条目</span>
</div>
<div class="dup-op-msg"></div>
<% } %>
<% if (manualN > 0) { %>
<p class="hint" style="margin:.4rem 0">另有 <%= manualN %> 首候选需处理——在下方逐条操作（移入回收站或忽略）。</p>
<% } %>
<% for (const g of groups) { %>
<article style="padding:.6rem .8rem;margin-bottom:.6rem">
  <div style="margin-bottom:.2rem">
    <strong><%= g.name %></strong>
    <% if (g.artist) { %><small class="hint"> - <%= g.artist %></small><% } %>
    <small class="hint">（重复 <%= g.items.length %> 份）</small>
  </div>
  <table>
    <tbody>
      <% g.items.forEach((it) => { const isKeep = keepIdSet.has(it.id) %>
      <tr data-keep="<%= isKeep ? '1' : '0' %>" style="<%= isKeep ? 'background:#f0f8f0' : it.inTrash ? 'background:#fdf0f0' : '' %>">
        <td style="white-space:nowrap">
          <% if (it.inTrash) { %><span class="bad" style="font-weight:600">🗑 已移入回收站</span>
          <% } else if (isKeep) { %><span class="ok">⭐ 保留（建议）</span><% } %>
        </td>
        <td style="white-space:nowrap"><%= it.qualityLabel %></td>
        <td style="white-space:nowrap"><%= it.sizeStr || '—' %></td>
        <td style="width:45%;word-break:break-all"><small><%= it.path || '' %></small></td>
        <td style="white-space:nowrap">
          <% if (it.inTrash) { %>
          <button class="btn-sm" hx-post="/api/dupe/row/restore" hx-vals='{"id":"<%= it.id %>","path":"<%= it.path %>"}' hx-target="closest td" hx-swap="innerHTML"
            hx-on::after-request="if(event.detail.successful){dupeClearRow(this)};htmx.ajax('GET','/api/trash/partial',{target:'#trash-panel'})">恢复</button>
          <% } else { %>
          <button class="btn-sm secondary" hx-post="/api/dupe/delete" hx-vals='{"ids":"<%= it.id %>","paths":"<%= it.path %>"}' hx-target="closest td" hx-swap="innerHTML"
            hx-on::after-request="if(event.detail.successful){dupeMarkTrash(this)};htmx.ajax('GET','/api/trash/partial',{target:'#trash-panel'})"
            hx-confirm="<%= isKeep ? '这是建议保留的最高音质副本，仍要移入回收站吗（可恢复）？' : '将移入回收站（可恢复）。确认？' %>\n<%= it.path %>">移入回收站</button>
          <% } %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</article>
<% } %>
<% if (!groups.length) { %><p class="hint">所选媒体库中未发现重复歌曲</p><% } %>
</div>
