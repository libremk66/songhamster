<!-- 平铺事件表：一行 = 一次「任务运行 × 歌曲」；表头第二行是筛选控件；每页 25 条翻页 -->
<% const fmtD = (d) => (d ? d.slice(5) : '') %>
<% const win = 2 %>
<% const pFrom = Math.max(1, page - win) %>
<% const pTo = Math.min(pages, page + win) %>
<div id="hist-rows-wrap">
  <form id="hist-filter" hx-get="/api/history/rows" hx-target="#hist-rows-wrap" hx-swap="outerHTML"
        hx-trigger="change" hx-include="this" onsubmit="return false">
    <div class="hist-scroll-host">
      <button type="button" class="hist-scroll-btn hist-scroll-left" title="向左滚动" onclick="histScroll(-1)">‹</button>
      <button type="button" class="hist-scroll-btn hist-scroll-right" title="向右滚动" onclick="histScroll(1)">›</button>

      <div class="overflow-x-auto hist-table-wrap" id="hist-scroll">
        <table class="table table-xs w-full hist-table">
          <colgroup>
            <col class="w-36"><!-- 日期时间 -->
            <col class="w-40"><!-- 所属任务 -->
            <col class="w-40"><!-- 任务属性 -->
            <col class="w-44"><!-- 歌曲名 -->
            <col class="w-32"><!-- 歌手 -->
            <col class="w-20"><!-- 音质 -->
            <col class="w-20"><!-- 操作 -->
            <col class="w-36"><!-- 处理过程 -->
            <col class="w-32"><!-- 结果 -->
            <col class="w-24"><!-- 文件大小 -->
            <col class="w-72"><!-- 文件路径 -->
            <col class="w-36"><!-- 引用情况 -->
            <col class="w-28"><!-- 行操作 -->
          </colgroup>
          <thead>
            <tr class="c-sub">
              <th>日期时间</th><th>所属任务</th><th>任务属性</th><th>歌曲名</th><th>歌手</th><th>音质</th>
              <th>操作</th><th>处理过程</th><th>结果</th><th>文件大小</th><th>文件路径</th><th>引用情况</th><th class="text-right">行操作</th>
            </tr>
            <tr class="hist-filters">
              <th class="hist-date-th" title="点开选择起始/结束日期"
                  onclick="document.getElementById('hist-date-dlg').showModal()">
                <!-- 整个表头格都是点击区（不只是图标）：emoji 换 SVG，避免不同浏览器把 emoji 画到框外 -->
                <span class="btn btn-outline btn-xs w-full whitespace-nowrap hist-date-btn">
                  <svg aria-hidden="true"><use href="#i-calendar"/></svg>
                  <span><%= (raw.from || raw.to) ? ((raw.from ? fmtD(raw.from) : '…') + '~' + (raw.to ? fmtD(raw.to) : '…')) : '日期' %></span>
                </span>
              </th>
              <th>
                <select name="taskName" class="select select-bordered select-xs w-full">
                  <option value="">全部任务</option>
                  <% for (const n of facets.taskNames) { %><option value="<%= n %>" <%= f.taskName === n ? 'selected' : '' %>><%= n %></option><% } %>
                </select>
              </th>
              <th><input name="attr" value="<%= f.attr ?? '' %>" placeholder="如 镜像/处理3" class="input input-bordered input-xs w-full" title="按任务设置项过滤：镜像、处理3、歌单名、前 15 首…"></th>
              <th><input name="song" value="<%= f.song ?? '' %>" placeholder="歌名关键词" class="input input-bordered input-xs w-full"></th>
              <th><input name="singer" value="<%= f.singer ?? '' %>" placeholder="歌手关键词" class="input input-bordered input-xs w-full"></th>
              <th>
                <select name="quality" class="select select-bordered select-xs w-full">
                  <option value="">全部</option>
                  <% for (const qq of facets.qualities) { %><option value="<%= qq %>" <%= f.quality === qq ? 'selected' : '' %>><%= qq %></option><% } %>
                </select>
              </th>
              <th>
                <select name="action" class="select select-bordered select-xs w-full">
                  <option value="">全部</option>
                  <option value="in" <%= f.action === 'in' ? 'selected' : '' %>>入库</option>
                  <option value="out" <%= f.action === 'out' ? 'selected' : '' %>>移出</option>
                </select>
              </th>
              <th>
                <select name="process" class="select select-bordered select-xs w-full">
                  <option value="">全部</option>
                  <% for (const g of H.PROCESS_GROUPS) { %>
                  <optgroup label="<%= g.label %>">
                    <% for (const c of g.codes) { %><option value="<%= c %>" <%= f.process === c ? 'selected' : '' %>><%= H.processLabel(c) %></option><% } %>
                  </optgroup>
                  <% } %>
                </select>
              </th>
              <th>
                <select name="status" class="select select-bordered select-xs w-full">
                  <option value="">全部</option>
                  <% for (const st of ['success', 'skipped_dup', 'dedup', 'removed', 'unsatisfied', 'failed']) { %>
                  <option value="<%= st %>" <%= f.status === st ? 'selected' : '' %>><%= H.statusMeta(st).label %></option>
                  <% } %>
                </select>
              </th>
              <th></th>
              <th><input name="path" value="<%= f.path ?? '' %>" placeholder="路径关键词" class="input input-bordered input-xs w-full"></th>
              <th></th>
              <th class="text-right">
                <button type="button" class="btn btn-ghost btn-xs" title="清空筛选"
                        hx-get="/api/history/rows" hx-target="#hist-rows-wrap" hx-swap="outerHTML">重置</button>
              </th>
            </tr>
          </thead>
          <tbody>
            <% if (!rows.length) { %>
            <tr><td colspan="13" class="c-sub text-xs py-8 text-center">没有符合条件的历史记录</td></tr>
            <% } %>
            <% for (const r of rows) { %>
            <tr id="hi-<%= r.id %>">
              <td class="whitespace-nowrap"><%= fmtLocal(r.startedAt, true) %></td>
              <td>
                <span class="text-xs c-sub"><%= r.taskType === 'chart' ? '榜单' : r.taskType === 'adhoc' ? '手动下载' : '歌单' %></span>
                <div class="hist-wrap"><b><%= r.taskName ?? '—' %></b></div>
              </td>
              <td class="text-xs c-sub">
                <% for (const line of H.taskAttrs(r)) { %><div class="hist-wrap"><%= line %></div><% } %>
              </td>
              <td class="hist-wrap">
                <%= r.songName ?? r.songKey %>
                <% if (r.attemptNo > 1) { %><span class="text-xs c-sub">（第 <%= r.attemptNo %> 次）</span><% } %>
              </td>
              <td class="hist-wrap"><%= r.singer ?? '' %></td>
              <td class="whitespace-nowrap"><%= r.quality ?? '—' %></td>
              <td class="whitespace-nowrap">
                <% if (r.action === 'out') { %><span class="st-warn">移出</span>
                <% } else if (r.action === 'in') { %><span class="st-ok">入库</span>
                <% } else { %><span class="c-sub">—</span><% } %>
              </td>
              <td>
                <span class="badge badge-ghost badge-sm hist-wrap"><%= H.processLabel(r.process) %></span>
                <% const steps = H.detailSteps(r.detail) %>
                <% if (steps.length) { %>
                <details class="mt-0.5">
                  <summary class="cursor-pointer text-xs c-sub select-none">轨迹</summary>
                  <ol class="text-xs c-sub mt-1 space-y-0.5 list-decimal list-inside">
                    <% for (const s of steps) { %><li class="hist-wrap"><%= s %></li><% } %>
                  </ol>
                </details>
                <% } %>
              </td>
              <td>
                <% const sm = H.statusMeta(r.status) %>
                <span class="<%= sm.cls %> hist-wrap"><%= sm.label %></span>
                <% if (r.errorReason) { %><div class="text-xs c-sub hist-wrap"><%= r.errorReason %></div><% } %>
              </td>
              <td class="whitespace-nowrap"><%= H.fmtSize(r.fileSize) %></td>
              <td class="text-xs hist-wrap"><%= r.filePath ?? '—' %></td>
              <td class="text-xs hist-wrap"><%= H.refsText(r.refBefore, r.refAfter) %></td>
              <td class="text-right whitespace-nowrap">
                <% if (r.status === 'failed') { %>
                <button type="button" class="btn btn-outline btn-xs" title="重下这一首并补入库/入歌单"
                        hx-post="/api/history/item/<%= r.id %>/retry" hx-target="#hist-msg" hx-swap="innerHTML">重试</button>
                <% } %>
                <button type="button" class="btn btn-ghost btn-xs text-error" title="删除这条记录涉及的内容（文件/歌单/历史）"
                        data-item="<%= r.id %>" data-name="<%= r.songName ?? '' %>"
                        onclick="histAskDeleteOne(this)">删除</button>
              </td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- 日期弹层：dialog 在最顶层渲染，不受表格横向滚动影响 -->
    <dialog id="hist-date-dlg" class="modal">
      <div class="modal-box max-w-xs">
        <h3 class="text-base font-bold">按日期筛选</h3>
        <label class="text-xs c-sub mt-3 block">起始日期</label>
        <!-- 点输入框任意位置都弹出日历：原生那个小图标的热区和画出来的位置有偏移，很难瞄准 -->
        <input type="date" name="from" value="<%= raw.from %>" class="input input-bordered input-sm w-full"
               onclick="histPickDate(this)" hx-on:change="event.stopPropagation()">
        <label class="text-xs c-sub mt-2 block">结束日期</label>
        <input type="date" name="to" value="<%= raw.to %>" class="input input-bordered input-sm w-full"
               onclick="histPickDate(this)" hx-on:change="event.stopPropagation()">
        <p class="text-xs c-sub mt-2">按本地时区的自然日筛选（选完点「应用」）</p>
        <div class="modal-action">
          <button type="button" class="btn btn-ghost btn-sm" onclick="document.getElementById('hist-date-dlg').close()">取消</button>
          <button type="button" class="btn btn-ghost btn-sm" onclick="histClearDates()">清除</button>
          <button type="button" id="hist-date-apply" class="btn btn-primary btn-sm"
                  hx-get="/api/history/rows" hx-include="#hist-filter"
                  hx-target="#hist-rows-wrap" hx-swap="outerHTML"
                  onclick="document.getElementById('hist-date-dlg').close()">应用</button>
        </div>
      </div>
    </dialog>

    <!-- 移动端卡片（桌面隐藏） -->
    <div class="hist-cards space-y-2">
      <% if (!rows.length) { %><p class="c-sub text-xs py-8 text-center">没有符合条件的历史记录</p><% } %>
      <% for (const r of rows) { %>
      <% const sm2 = H.statusMeta(r.status) %>
      <% const steps2 = H.detailSteps(r.detail) %>
      <div class="rounded-lg border border-base-300 p-2 text-xs">
        <div class="flex items-center gap-2 flex-wrap">
          <b><%= r.songName ?? r.songKey %></b>
          <span class="c-sub"><%= r.singer ?? '' %></span>
          <span class="flex-1"></span>
          <span class="<%= sm2.cls %>"><%= sm2.label %></span>
        </div>
        <div class="c-sub mt-0.5"><%= fmtLocal(r.startedAt, true) %> · <%= r.taskType === 'chart' ? '榜单' : r.taskType === 'adhoc' ? '手动下载' : '歌单' %>《<%= r.taskName ?? '—' %>》</div>
        <div class="c-sub mt-0.5"><%= H.taskAttrs(r).join(' · ') %></div>
        <div class="mt-0.5">
          <span class="badge badge-ghost badge-sm"><%= H.processLabel(r.process) %></span>
          <span class="c-sub"><%= r.quality ?? '—' %> · <%= H.fmtSize(r.fileSize) %></span>
        </div>
        <% if (r.errorReason) { %><div class="st-bad mt-0.5"><%= r.errorReason %></div><% } %>
        <% if (steps2.length) { %>
        <details class="mt-1"><summary class="cursor-pointer c-sub select-none">轨迹</summary>
          <ol class="c-sub mt-1 space-y-0.5 list-decimal list-inside"><% for (const s of steps2) { %><li><%= s %></li><% } %></ol>
        </details>
        <% } %>
        <div class="mt-1 flex gap-1">
          <% if (r.status === 'failed') { %>
          <button type="button" class="btn btn-outline btn-xs" hx-post="/api/history/item/<%= r.id %>/retry" hx-target="#hist-msg" hx-swap="innerHTML">重试</button>
          <% } %>
          <button type="button" class="btn btn-ghost btn-xs text-error" data-item="<%= r.id %>" data-name="<%= r.songName ?? '' %>" onclick="histAskDeleteOne(this)">删除</button>
        </div>
      </div>
      <% } %>
    </div>

    <!-- 翻页：每页 25 条 -->
    <div class="flex flex-wrap items-center justify-center gap-1 py-3 text-xs">
      <span class="c-sub mr-2">共 <%= total %> 条 · 第 <%= page %>/<%= pages %> 页</span>
      <% const mk = (p, label, dis) => { %>
      <button type="button" class="btn btn-xs <%= p === page ? 'btn-active' : 'btn-outline' %>" <%= dis ? 'disabled' : '' %>
              hx-get="/api/history/rows" hx-include="#hist-filter" hx-vals='{"page":"<%= p %>"}'
              hx-target="#hist-rows-wrap" hx-swap="outerHTML"><%= label %></button>
      <% } %>
      <% mk(1, '«', page <= 1) %>
      <% mk(page - 1, '‹', page <= 1) %>
      <% for (let p = pFrom; p <= pTo; p++) { mk(p, String(p), false) } %>
      <% mk(page + 1, '›', page >= pages) %>
      <% mk(pages, '»', page >= pages) %>
    </div>
  </form>
</div>
