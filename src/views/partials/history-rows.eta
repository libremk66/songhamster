<!-- 平铺事件表：一行 = 一次「任务运行 × 歌曲」；表头第二行是筛选控件（2026-09-13 重构） -->
<% const lim = f.limit ?? 100 %>
<% const sel = (name, val) => (f[name] === val ? 'selected' : '') %>
<div id="hist-rows-wrap">
  <form id="hist-filter" hx-get="/api/history/rows" hx-target="#hist-rows-wrap" hx-swap="outerHTML"
        hx-trigger="change" hx-include="this" onsubmit="return false">

    <!-- 日期区间：放在滚动容器**外面**——表头那一行在 overflow-x-auto 里，弹出的日历会被裁掉 -->
    <div class="flex items-center gap-2 flex-wrap mb-1.5">
      <details class="dropdown">
        <summary class="btn btn-outline btn-xs whitespace-nowrap">
          📅 <%= (raw.from || raw.to) ? ((raw.from || '…') + ' ~ ' + (raw.to || '…')) : '按日期筛选' %>
        </summary>
        <div class="dropdown-content z-50 mt-1 p-3 rounded-lg border border-base-300 bg-base-100 shadow-lg w-60">
          <label class="text-xs c-sub">起始日期</label>
          <input type="date" name="from" value="<%= raw.from %>" class="input input-bordered input-xs w-full"
                 hx-on:change="event.stopPropagation()">
          <label class="text-xs c-sub mt-2 block">结束日期</label>
          <input type="date" name="to" value="<%= raw.to %>" class="input input-bordered input-xs w-full"
                 hx-on:change="event.stopPropagation()">
          <div class="flex gap-2 mt-3">
            <button type="button" id="hist-date-apply" class="btn btn-primary btn-xs flex-1"
                    hx-get="/api/history/rows" hx-include="#hist-filter"
                    hx-target="#hist-rows-wrap" hx-swap="outerHTML">应用</button>
            <button type="button" class="btn btn-ghost btn-xs" onclick="histClearDates()">清除</button>
          </div>
          <p class="text-xs c-sub mt-2">按本地时区的自然日筛选</p>
        </div>
      </details>
      <span class="text-xs c-sub">日期区间按<b>本地时区</b>的自然日算（选完点「应用」）</span>
    </div>

    <!-- 横向滚动：左右两侧固定按钮（不随内容滚动而移动） -->
    <div class="hist-scroll-host">
      <button type="button" class="hist-scroll-btn hist-scroll-left" title="向左滚动" onclick="histScroll(-1)">‹</button>
      <button type="button" class="hist-scroll-btn hist-scroll-right" title="向右滚动" onclick="histScroll(1)">›</button>

      <div class="overflow-x-auto hist-table-wrap" id="hist-scroll">
        <table class="table table-xs w-full hist-table">
          <colgroup>
            <col class="w-32"><!-- 日期时间 -->
            <col class="w-32"><!-- 所属任务 -->
            <col class="w-32"><!-- 任务属性 -->
            <col class="w-40"><!-- 歌曲名 -->
            <col class="w-28"><!-- 歌手 -->
            <col class="w-20"><!-- 音质 -->
            <col class="w-16"><!-- 操作 -->
            <col class="w-40"><!-- 处理过程 -->
            <col class="w-32"><!-- 结果 -->
            <col class="w-20"><!-- 文件大小 -->
            <col class="w-56"><!-- 文件路径 -->
            <col class="w-32"><!-- 引用情况 -->
            <col class="w-24"><!-- 行操作 -->
          </colgroup>
          <thead>
            <tr class="c-sub">
              <th>日期时间</th>
              <th>所属任务</th>
              <th>任务属性</th>
              <th>歌曲名</th>
              <th>歌手</th>
              <th>音质</th>
              <th>操作</th>
              <th>处理过程</th>
              <th>结果</th>
              <th>文件大小</th>
              <th>文件路径</th>
              <th>引用情况</th>
              <th class="text-right">行操作</th>
            </tr>
            <tr class="hist-filters">
              <th></th>
              <th>
                <select name="taskName" class="select select-bordered select-xs w-full">
                  <option value="">全部任务</option>
                  <% for (const n of facets.taskNames) { %><option value="<%= n %>" <%= sel('taskName', n) %>><%= n %></option><% } %>
                </select>
              </th>
              <th>
                <input name="attr" value="<%= f.attr ?? '' %>" placeholder="如 镜像/处理3"
                       class="input input-bordered input-xs w-full" title="按任务设置项过滤：镜像、处理3、歌单名、前 15 首…">
              </th>
              <th><input name="song" value="<%= f.song ?? '' %>" placeholder="歌名关键词" class="input input-bordered input-xs w-full"></th>
              <th><input name="singer" value="<%= f.singer ?? '' %>" placeholder="歌手关键词" class="input input-bordered input-xs w-full"></th>
              <th>
                <select name="quality" class="select select-bordered select-xs w-full">
                  <option value="">全部</option>
                  <% for (const qq of facets.qualities) { %><option value="<%= qq %>" <%= sel('quality', qq) %>><%= qq %></option><% } %>
                </select>
              </th>
              <th>
                <select name="action" class="select select-bordered select-xs w-full">
                  <option value="">全部</option>
                  <option value="in" <%= sel('action', 'in') %>>入库</option>
                  <option value="out" <%= sel('action', 'out') %>>移出</option>
                </select>
              </th>
              <th>
                <select name="process" class="select select-bordered select-xs w-full">
                  <option value="">全部</option>
                  <% for (const g of H.PROCESS_GROUPS) { %>
                  <optgroup label="<%= g.label %>">
                    <% for (const c of g.codes) { %><option value="<%= c %>" <%= sel('process', c) %>><%= H.processLabel(c) %></option><% } %>
                  </optgroup>
                  <% } %>
                </select>
              </th>
              <th>
                <select name="status" class="select select-bordered select-xs w-full">
                  <option value="">全部</option>
                  <% for (const st of ['success', 'skipped_dup', 'dedup', 'removed', 'unsatisfied', 'failed']) { %>
                  <option value="<%= st %>" <%= sel('status', st) %>><%= H.statusMeta(st).label %></option>
                  <% } %>
                </select>
              </th>
              <th></th>
              <th><input name="path" value="<%= f.path ?? '' %>" placeholder="路径关键词" class="input input-bordered input-xs w-full"></th>
              <th></th>
              <th class="text-right">
                <button type="button" class="btn btn-ghost btn-xs" title="清空筛选"
                        hx-get="/api/history/rows" hx-target="#hist-rows-wrap" hx-swap="outerHTML">重置</button>
              </th>
            </tr>
          </thead>
          <tbody>
            <% if (!rows.length) { %>
            <tr><td colspan="13" class="c-sub text-xs py-8 text-center">没有符合条件的历史记录</td></tr>
            <% } %>
            <% for (const r of rows) { %>
            <tr id="hi-<%= r.id %>">
              <td class="whitespace-nowrap"><%= fmtLocal(r.startedAt, true) %></td>
              <td class="whitespace-nowrap">
                <b><%= r.taskName ?? '—' %></b>
                <span class="text-xs c-sub"><%= r.taskType === 'chart' ? '榜单' : r.taskType === 'adhoc' ? '手动' : '歌单' %></span>
              </td>
              <td class="text-xs c-sub align-top">
                <% for (const line of H.taskAttrs(r)) { %><div class="whitespace-nowrap"><%= line %></div><% } %>
              </td>
              <td class="whitespace-nowrap">
                <%= r.songName ?? r.songKey %>
                <% if (r.attemptNo > 1) { %><span class="text-xs c-sub" title="这首歌在本任务里的第几次处理">第 <%= r.attemptNo %> 次</span><% } %>
              </td>
              <td class="whitespace-nowrap"><%= r.singer ?? '' %></td>
              <td class="whitespace-nowrap"><%= r.quality ?? '—' %></td>
              <td class="whitespace-nowrap">
                <% if (r.action === 'out') { %><span class="st-warn">移出</span>
                <% } else if (r.action === 'in') { %><span class="st-ok">入库</span>
                <% } else { %><span class="c-sub">—</span><% } %>
              </td>
              <td>
                <span class="badge badge-ghost badge-sm whitespace-nowrap"><%= H.processLabel(r.process) %></span>
                <% const steps = H.detailSteps(r.detail) %>
                <% if (steps.length) { %>
                <details class="mt-0.5">
                  <summary class="cursor-pointer text-xs c-sub select-none">轨迹</summary>
                  <ol class="text-xs c-sub mt-1 space-y-0.5 list-decimal list-inside">
                    <% for (const s of steps) { %><li><%= s %></li><% } %>
                  </ol>
                </details>
                <% } %>
              </td>
              <td>
                <% const sm = H.statusMeta(r.status) %>
                <span class="<%= sm.cls %> whitespace-nowrap"><%= sm.label %></span>
                <% if (r.errorReason) { %><div class="text-xs c-sub"><%= r.errorReason %></div><% } %>
              </td>
              <td class="whitespace-nowrap"><%= H.fmtSize(r.fileSize) %></td>
              <td class="text-xs" style="word-break:break-all"><%= r.filePath ?? '—' %></td>
              <td class="text-xs"><%= H.refsText(r.refBefore, r.refAfter) %></td>
              <td class="text-right whitespace-nowrap">
                <% if (r.status === 'failed') { %>
                <button type="button" class="btn btn-outline btn-xs" title="重下这一首并补入库/入歌单"
                        hx-post="/api/history/item/<%= r.id %>/retry" hx-target="#hist-msg" hx-swap="innerHTML">重试</button>
                <% } %>
                <button type="button" class="btn btn-ghost btn-xs text-error" title="删除这条记录涉及的内容（文件/歌单/历史）"
                        data-item="<%= r.id %>" data-name="<%= r.songName ?? '' %>"
                        onclick="histAskDeleteOne(this)">删除</button>
              </td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- 移动端卡片（桌面隐藏） -->
    <div class="hist-cards space-y-2">
      <% if (!rows.length) { %><p class="c-sub text-xs py-8 text-center">没有符合条件的历史记录</p><% } %>
      <% for (const r of rows) { %>
      <% const sm2 = H.statusMeta(r.status) %>
      <% const steps2 = H.detailSteps(r.detail) %>
      <div class="rounded-lg border border-base-300 p-2 text-xs">
        <div class="flex items-center gap-2 flex-wrap">
          <b><%= r.songName ?? r.songKey %></b>
          <span class="c-sub"><%= r.singer ?? '' %></span>
          <span class="flex-1"></span>
          <span class="<%= sm2.cls %>"><%= sm2.label %></span>
        </div>
        <div class="c-sub mt-0.5"><%= fmtLocal(r.startedAt, true) %> · <%= r.taskName ?? '—' %> · <%= H.taskAttrs(r).join(' · ') %></div>
        <div class="mt-0.5">
          <span class="badge badge-ghost badge-sm"><%= H.processLabel(r.process) %></span>
          <span class="c-sub"><%= r.quality ?? '—' %> · <%= H.fmtSize(r.fileSize) %></span>
        </div>
        <% if (r.errorReason) { %><div class="st-bad mt-0.5"><%= r.errorReason %></div><% } %>
        <% if (steps2.length) { %>
        <details class="mt-1"><summary class="cursor-pointer c-sub select-none">轨迹</summary>
          <ol class="c-sub mt-1 space-y-0.5 list-decimal list-inside"><% for (const s of steps2) { %><li><%= s %></li><% } %></ol>
        </details>
        <% } %>
        <div class="mt-1 flex gap-1">
          <% if (r.status === 'failed') { %>
          <button type="button" class="btn btn-outline btn-xs" hx-post="/api/history/item/<%= r.id %>/retry" hx-target="#hist-msg" hx-swap="innerHTML">重试</button>
          <% } %>
          <button type="button" class="btn btn-ghost btn-xs text-error" data-item="<%= r.id %>" data-name="<%= r.songName ?? '' %>" onclick="histAskDeleteOne(this)">删除</button>
        </div>
      </div>
      <% } %>
    </div>

    <% if (hasMore) { %>
    <div class="text-center py-3">
      <button type="button" class="btn btn-outline btn-xs"
              hx-get="/api/history/rows" hx-include="#hist-filter"
              hx-vals='{"limit":"<%= lim + 100 %>"}'
              hx-target="#hist-rows-wrap" hx-swap="outerHTML">加载更多（再 100 条）</button>
    </div>
    <% } %>
  </form>
</div>
