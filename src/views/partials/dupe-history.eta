<% if (!rows.length) { %><p class="hint">暂无查重记录</p><% } else { %>
<% if (pages > 1) { %>
<div style="display:flex;align-items:center;gap:.3rem;flex-wrap:wrap;margin:.25rem 0">
  <small class="hint">记录过多已分页：</small>
  <% for (let i = 1; i <= pages; i++) { %>
  <button type="button" class="btn-sm<%= i === page ? ' current' : ' secondary' %>" hx-get="/api/dupe/history/partial?page=<%= i %>" hx-target="#dupe-history" hx-swap="innerHTML"><%= i %></button>
  <% } %>
  <small class="hint">第 <%= page %>/<%= pages %> 页（每页 10 条，共 <%= total %> 条）</small>
</div>
<% } else { %>
<p class="hint" style="margin:.25rem 0">共 <%= total %> 条查重记录</p>
<% } %>
<% for (const r of rows) { %>
<div class="dup-rec" style="border-bottom:1px solid #eee;padding:.35rem 0">
  <div style="display:flex;align-items:center;gap:.6rem;flex-wrap:wrap">
    <small><%= r.createdAt.slice(5, 19).replace('T', ' ') %></small>
    <small class="hint">重复 <%= r.groupsCount %> 组 ｜ 自动清理候选 <%= r.autoCount %> ｜ 手动候选 <%= r.manualCount %></small>
    <small class="hint"><%= r.threshold ? '门槛：' + r.threshold : '仅查重' %></small>
    <button type="button" class="btn-sm secondary" onclick="dupeRowExpand(this, <%= r.id %>)">展开查看</button>
    <button type="button" class="btn-sm secondary" onclick="dupeRowCollapse(this)">收起</button>
  </div>
  <div id="dup-body-<%= r.id %>" class="dup-body" style="display:none;margin-top:.35rem"></div>
</div>
<% } %>
<% } %>
