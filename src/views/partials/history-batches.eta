<!-- 批次视图：每个批次一行（任务属性 + 计数），展开后按「新入库/复用/跳过」分组
     分组内容懒加载（/api/history/batch/:id/rows），行渲染与流水页共用同一套 partial -->
<div id="hist-batches" class="space-y-2">
  <% if (!batches.length) { %>
  <p class="c-sub text-xs py-10 text-center">没有符合条件的运行批次</p>
  <% } %>
  <% for (const b of batches) { %>
  <div class="rounded-lg border border-base-300 bg-base-100 p-2.5">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
      <strong class="text-sm"><%= fmtLocal(b.startedAt, true) %></strong>
      <span class="text-xs c-sub">
        <span><%= b.taskType === 'chart' ? '榜单' : b.taskType === 'adhoc' ? '手动下载' : '歌单' %></span>
        <b><%= b.taskName ?? '（任务已删除）' %></b>
        · <%= H.taskAttrText(b) %>
      </span>
      <span class="flex-1"></span>
      <span class="text-xs">
        结果：
        <% if (!b.finishedAt) { %><b class="st-warn">进行中…</b>
        <% } else if (b.result === 'success') { %><b class="st-ok">成功</b>
        <% } else if (b.result === 'partial') { %><b class="st-warn">部分成功</b>
        <% } else if (b.result === 'failed') { %><b class="st-bad">失败</b>
        <% } else { %><%= b.result ?? '—' %><% } %>
      </span>
      <button type="button" class="btn btn-outline btn-xs" onclick="histToggleBatch(<%= b.id %>, this)">
        <svg aria-hidden="true"><use href="#i-chevronDown"/></svg><span class="h-txt">展开</span>
      </button>
    </div>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-1 text-xs">
      <span class="st-ok">✅ 新入库 <%= b.okCount %></span>
      <span class="st-skip">♻️ 复用/查重 <%= b.dupCount + b.dedupCount %></span>
      <span class="st-warn">⏭ 跳过 <%= b.skippedCount %></span>
      <span class="st-bad">❌ 失败 <%= b.failCount %></span>
      <span class="st-warn">⏭ 未满足 <%= b.unsatisfiedCount %></span>
      <span class="st-skip">🗑 移除 <%= b.removedCount %></span>
    </div>
    <% if (b.detail) { %><p class="text-xs c-sub mt-1"><%= b.detail %></p><% } %>
    <div id="batch-<%= b.id %>"></div>
  </div>
  <% } %>

  <!-- 翻页：每页 25 批 -->
  <div class="hist-pager flex flex-wrap items-center justify-center gap-1 py-3 text-xs">
    <span class="c-sub mr-2">共 <%= total %> 批 · 第 <%= page %>/<%= pages %> 页</span>
    <% const mkB = (p, label, dis) => { %>
    <button type="button" class="btn btn-xs <%= p === page ? 'btn-active' : 'btn-outline' %>" <%= dis ? 'disabled' : '' %>
            hx-get="/api/history/batches" hx-vals='{"page":"<%= p %>"}'
            hx-target="#hist-batches" hx-swap="outerHTML"><%= label %></button>
    <% } %>
    <% mkB(1, '«', page <= 1) %>
    <% mkB(page - 1, '‹', page <= 1) %>
    <% for (let p = Math.max(1, page - 2); p <= Math.min(pages, page + 2); p++) { mkB(p, String(p), false) } %>
    <% mkB(page + 1, '›', page >= pages) %>
    <% mkB(pages, '»', page >= pages) %>
  </div>
</div>
