<% const ON = '<span class="icv icv-on" title="是"><svg aria-hidden="true"><use href="#i-check"/></svg></span>' %>
<% const OFF = '<span class="icv icv-off" title="否"><svg aria-hidden="true"><use href="#i-x"/></svg></span>' %>
<table class="table table-sm w-full text-sm">
  <thead>
    <tr class="c-sub">
      <th>LX 歌单</th><th>加入已有 <%= targetName %> 歌单</th><th>同名新建</th><th>模式</th>
      <th>cron</th><th>启用</th><th>上次结果</th><th class="text-right">操作</th>
    </tr>
  </thead>
  <tbody>
    <% if (!tasks.length) { %>
    <tr><td colspan="8" class="hint">暂无任务 —— 在上方"手动新增同步任务"中添加</td></tr>
    <% } %>
    <% for (const t of tasks) { %>
    <tr>
      <td><% if (t.taskType === 'chart') { %>🏆 <% } %><%= t.lxPlaylistName %><% if (t.taskType === 'chart') { %> <small class="hint">（榜单订阅，管理见「榜单订阅」页）</small><% } %></td>
      <td>
        <% if (t.embyTargetPlaylistIdsParsed.length) { %>
          <span class="flex items-center gap-1.5"><%= ON %><small><% for (const pid of t.embyTargetPlaylistIdsParsed) { %><%= (idToName && idToName[pid]) || pid %>、<% } %></small></span>
        <% } else { %><%= OFF %><% } %>
      </td>
      <td><%= t.createSameNamePlaylist ? ON : OFF %></td>
      <td><%= t.syncMode === 'full' ? '完全' : '增量' %></td>
      <td><small><%= t.cronExpr || '仅手动' %></small></td>
      <td><%= t.enabled ? ON : OFF %></td>
      <td><%= t.lastResult ?? '—' %></td>
      <td class="act">
        <button class="btn btn-primary btn-xs" hx-post="/api/task/<%= t.id %>/run" hx-target="closest td" hx-swap="outerHTML"><svg aria-hidden="true"><use href="#i-play"/></svg>同步</button>
        <button class="btn btn-ghost btn-xs" hx-get="/api/task/<%= t.id %>/edit" hx-target="closest tr" hx-swap="outerHTML"><svg aria-hidden="true"><use href="#i-pencil"/></svg>编辑</button>
        <button class="btn btn-ghost btn-xs" hx-post="/api/task/<%= t.id %>/toggle" hx-target="#task-table" hx-swap="innerHTML"><% if (t.enabled) { %><svg aria-hidden="true"><use href="#i-pause"/></svg>停用<% } else { %><svg aria-hidden="true"><use href="#i-play"/></svg>启用<% } %></button>
        <button class="btn btn-ghost btn-xs text-error" hx-post="/api/task/<%= t.id %>/delete" hx-confirm="确认删除该同步任务？" hx-target="#task-table" hx-swap="innerHTML"><svg aria-hidden="true"><use href="#i-trash"/></svg>删除</button>
      </td>
    </tr>
    <% } %>
  </tbody>
</table>
