<div class="overflow-x-auto mt-1">
<table class="table table-sm w-full text-sm">
  <thead>
    <tr class="c-sub"><th class="w-8"></th><th>歌曲</th><th>状态</th><th>音质</th><th>处理过程</th><th>原因</th><th></th></tr>
  </thead>
  <tbody>
    <% for (const it of items) { %>
    <tr>
      <td><input type="checkbox" class="checkbox checkbox-xs hi-ck" value="<%= it.id %>" data-batch="<%= it.batchId %>" onchange="histSync()"></td>
      <td><%= it.songName %><br><small class="c-sub"><%= it.singer %></small></td>
      <td>
        <% if (it.status === 'success') { %><span class="st-ok">✅ 成功</span>
        <% } else if (it.status === 'unsatisfied') { %><span class="st-warn">⏭ 未满足</span>
        <% } else if (it.status === 'removed') { %><span class="st-skip">🗑 移除</span>
        <% } else if (it.status === 'skipped_dup') { %><span class="st-skip">⏭ 已下载跳过</span>
        <% } else if (it.status === 'dedup') { %><span class="st-skip">🔍 查重跳过</span>
        <% } else { %><span class="st-bad">❌ 失败</span><% } %>
      </td>
      <td><%= it.quality ?? '—' %></td>
      <td>
        <%
          // 处理轨迹（查库/尝试档位/下载/入库/入歌单…）：JSON 数组，逐条列出
          let steps = []
          try { steps = it.detail ? JSON.parse(it.detail) : [] } catch { steps = [] }
        %>
        <% if (steps.length) { %>
        <div class="space-y-0.5">
          <% for (const st of steps) { %>
          <div class="text-xs" style="white-space:normal"><span class="c-sub">·</span> <%= st %></div>
          <% } %>
        </div>
        <% } else { %><small class="c-sub">—</small><% } %>
      </td>
      <td><small class="c-sub"><%= it.errorReason ?? '' %></small></td>
      <td>
        <% if (it.status === 'failed' || it.status === 'unsatisfied') { %>
        <button class="btn btn-outline btn-xs" hx-post="/api/history/item/<%= it.id %>/retry" hx-target="closest tr" hx-swap="outerHTML"><svg aria-hidden="true"><use href="#i-retry"/></svg>重试</button>
        <% } %>
      </td>
    </tr>
    <% } %>
  </tbody>
</table>
</div>
