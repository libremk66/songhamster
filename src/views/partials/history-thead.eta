<!-- 事件表表头（流水/批次共用）：colgroup + 列名行；筛选行由流水页自己接在后面 -->
<colgroup>
  <col class="w-32"><!-- 日期时间 -->
  <col class="w-40"><!-- 所属任务 -->
  <col class="w-40"><!-- 任务属性 -->
  <col class="w-44"><!-- 歌曲名 -->
  <col class="w-32"><!-- 歌手 -->
  <col class="w-24"><!-- 音质 -->
  <col class="w-24"><!-- 操作 -->
  <col class="w-36"><!-- 处理过程 -->
  <col class="w-36"><!-- 结果 -->
  <col class="w-28"><!-- 文件大小 -->
  <col class="w-64"><!-- 文件路径 -->
  <col class="w-36"><!-- 引用情况 -->
  <col class="w-28"><!-- 行操作 -->
</colgroup>
<tr class="c-sub">
  <th>日期时间</th><th>所属任务</th><th>任务属性</th><th>歌曲名</th><th>歌手</th><th>音质</th>
  <th>操作</th><th>处理过程</th><th>结果</th><th>文件大小</th><th>文件路径</th><th>引用情况</th><th class="text-right">行操作</th>
</tr>
