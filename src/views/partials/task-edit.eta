<tr class="edit-row">
  <td colspan="8">
    <form id="edit-form-<%= t.id %>" class="space-y-2" hx-post="/api/task/<%= t.id %>/update" hx-target="#task-table" hx-swap="innerHTML">
      <div class="rounded-lg border border-base-300 p-3 space-y-2">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-sm font-medium w-24 shrink-0">LX 歌单</span>
          <span class="text-sm"><%= t.lxPlaylistName %></span>
        </div>
        <div>
          <span class="text-sm font-medium block mb-1">同步到 <%= targetName %> 的目标</span>
          <label class="flex items-center gap-2 cursor-pointer py-0.5"><input type="checkbox" name="createSameNamePlaylist" value="1" <%= t.createSameNamePlaylist ? 'checked' : '' %> class="checkbox checkbox-sm"><span class="text-sm">同名播放列表/歌单(自动生成)</span></label>
          <% if (scopeUI) { %>
          <label class="form-control w-full mb-1">
            <span class="label-text mb-1">目标歌单归属</span>
            <select name="playlistScope" id="scope-<%= t.id %>" class="select select-bordered select-sm w-full"
                    hx-get="/api/media/users/options" hx-include="closest form" hx-vals='{"type":"<%= targetKey %>"}'
                    hx-trigger="load" hx-target="this" hx-swap="innerHTML">
              <option value="<%= t.playlistScope ?? 'shared' %>|<%= t.playlistScopeName ?? '' %>" selected><%= t.playlistScopeName || '共享（所有人可见）' %></option>
            </select>
          </label>
          <% } %>
          <label class="flex items-center gap-2 cursor-pointer py-0.5"><input type="checkbox" id="to-existing-<%= t.id %>" onchange="toggleExistingId(this, '-<%= t.id %>')" <%= t.embyTargetPlaylistIdsParsed.length ? 'checked' : '' %> class="checkbox checkbox-sm"><span class="text-sm">同步到已有播放列表/歌单</span></label>
          <div class="existing-box" id="existing-box-<%= t.id %>" style="display:<%= t.embyTargetPlaylistIdsParsed.length ? '' : 'none' %>">
            <div class="rounded-lg border border-base-300 p-2 overflow-y-auto" style="max-height:9rem;width:24rem;max-width:100%"
                 hx-get="/api/emby/playlists/checkboxes" hx-include="closest form" hx-target="this"
                 hx-trigger="load<% if (scopeUI) { %>, change from:#scope-<%= t.id %><% } %>" hx-swap="innerHTML">
              <% if (t.embyTargetPlaylistIdsParsed.length) { %>
                <% for (const p of embyPlaylists) { if (!t.embyTargetPlaylistIdsParsed.includes(p.id)) continue; %>
                <label style="display:flex;align-items:center;gap:.3rem;margin:.15rem 0"><input type="checkbox" name="embyTarget" value="<%= p.id %>" checked> <%= p.name %></label>
                <% } %>
              <% } else { %><span class="text-xs c-sub">加载中…</span><% } %>
            </div>
          </div>
        </div>
        <div>
          <span class="text-sm font-medium block mb-1">同步方式</span>
          <label class="flex items-center gap-2 cursor-pointer py-0.5"><input type="radio" name="mode" value="incremental" <%= t.mode === 'incremental' || (!t.mode && t.syncMode !== 'full') ? 'checked' : '' %> class="radio radio-sm" onchange="teMode(<%= t.id %>)"><span class="text-sm"><b>增量</b><span class="text-xs c-sub"> 只增不减</span></span></label>
          <label class="flex items-center gap-2 cursor-pointer py-0.5"><input type="radio" name="mode" value="mirror" <%= t.mode === 'mirror' || (!t.mode && t.syncMode === 'full') ? 'checked' : '' %> class="radio radio-sm" onchange="teMode(<%= t.id %>)"><span class="text-sm"><b>镜像</b><span class="text-xs c-sub"> 增删同步(旧「完全」)</span></span></label>
          <div id="edit-del-<%= t.id %>" class="mt-1">
            <span class="text-xs font-bold c-sub block mb-1">LX 端删除时处理方式:</span>
            <label class="flex items-start gap-2 cursor-pointer py-0.5"><input type="radio" name="delPolicy" value="keep" <%= t.delPolicy === 'keep' ? 'checked' : '' %> class="radio radio-sm"><span class="text-sm"><b>处理1</b> 歌单移除+文件不删(默认)</span></label>
            <label class="flex items-start gap-2 cursor-pointer py-0.5"><input type="radio" name="delPolicy" value="delete" <%= t.delPolicy === 'delete' ? 'checked' : '' %> class="radio radio-sm"><span class="text-sm"><b>处理2</b> 歌单移除 + 删除文件</span></label>
            <label class="flex items-start gap-2 cursor-pointer py-0.5"><input type="radio" name="delPolicy" value="archive" <%= t.delPolicy === 'archive' ? 'checked' : '' %> class="radio radio-sm"><span class="text-sm"><b>处理3</b> 移入归档歌单: <input name="archivePlaylist" class="input input-bordered input-sm" style="width:12rem" placeholder="默认 歌单同步任务归档" value="<%= t.archivePlaylist || '歌单同步任务归档' %>"></span></label>
            <div class="ml-6 mt-1 flex flex-wrap items-center gap-1.5">
              <select class="select select-bordered select-sm" style="width:15rem" data-arch-picker="archivePlaylist" onchange="archPickFrom(this)">
                <option value="">选择归档目标…</option>
                <option value="歌单同步任务归档">统一：歌单同步任务归档</option>
                <option value="[歌单名]归档">按来源：[歌单名]归档</option>
                <optgroup label="<%= targetName %> 已有播放列表">
                  <% for (const p of embyPlaylists) { %><option value="<%= p.name %>"><%= p.name %></option><% } %>
                </optgroup>
              </select>
              <span class="text-xs c-sub">输入框写目标歌单名（新的也行）；下拉挑预设或已有歌单。保存时不存在会自动创建，运行中被删则降级为「保留文件」</span>
            </div>
          </div>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-sm font-medium w-24 shrink-0">定时 cron</span>
        <input name="cronExpr" value="<%= t.cronExpr || '' %>" placeholder="0 6 * * *" class="input input-bordered input-sm font-mono text-xs" style="width:12rem">
        <span class="text-xs c-sub">空 = 仅手动</span>
      </div>
      <div class="flex items-center gap-2">
        <button type="submit" class="btn btn-primary btn-xs px-2"><svg aria-hidden="true"><use href="#i-save"/></svg>保存</button>
        <button type="button" class="btn btn-outline btn-xs px-2" hx-get="/api/tasks/table?scope=playlist" hx-target="#task-table" hx-swap="innerHTML"><svg aria-hidden="true"><use href="#i-x"/></svg>取消</button>
      </div>
    </form>
    <script>
      teMode(<%= t.id %>)
    </script>
  </td>
</tr>
