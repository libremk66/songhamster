<style>
  /* 双 tab(同步/洗版):下划线式 */
  .hist-tab { padding: .4rem .9rem; font-size: .8125rem; border-bottom: 2px solid transparent; color: oklch(var(--bc) / 0.7);
              cursor: pointer; background: none; border-radius: 0; transition: color .15s, border-color .15s; }
  .hist-tab:hover { color: var(--sfg-deep); }
  .hist-tab.active { color: var(--sfg-deep); font-weight: 650; border-bottom-color: var(--sfg); }
</style>
<div class="space-y-4">

  <!-- ===== 页头 ===== -->
  <header>
    <div class="flex items-center gap-2 flex-wrap">
      <h2 class="text-lg font-extrabold tracking-tight">历史记录</h2>
    </div>
  </header>

  <section class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-2">
      <div class="flex gap-1 border-b border-base-200">
        <button type="button" class="hist-tab active" id="tab-sync"
          hx-get="/api/history/partial" hx-target="#hist-content" hx-swap="innerHTML"
          onclick="switchHistTab('tab-sync')">同步任务历史记录</button>
        <button type="button" class="hist-tab" id="tab-upgrade"
          hx-get="/api/upgrade/history/partial" hx-target="#hist-content" hx-swap="innerHTML"
          onclick="switchHistTab('tab-upgrade')">洗版历史记录</button>
      </div>
      <div id="hist-content" hx-get="/api/history/partial" hx-trigger="load">
        <p class="c-sub text-xs py-10 text-center">加载中…</p>
      </div>
    </div>
  </section>

</div>

<script>
function switchHistTab(id) {
  document.querySelectorAll('.hist-tab').forEach(function (b) { b.classList.remove('active') })
  document.getElementById(id).classList.add('active')
}
// 批次明细:点展开加载、再点收起(避免重复拉取)
function histToggle(id, btn) {
  var box = document.getElementById('batch-' + id)
  if (!box) return
  if (box.dataset.loaded === '1') {
    box.innerHTML = ''
    box.dataset.loaded = ''
    btn.textContent = '查看明细'
    return
  }
  box.innerHTML = '<span class="c-sub text-xs">加载中…</span>'
  fetch('/api/history/batch/' + id)
    .then(function (r) { return r.text() })
    .then(function (html) {
      box.innerHTML = html
      box.dataset.loaded = '1'
      btn.textContent = '收起'
    })
    .catch(function () { box.innerHTML = '<span class="st-bad text-xs">加载失败，请重试</span>' })
}
</script>
