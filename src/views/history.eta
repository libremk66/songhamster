<style>
  /* 标签:胶囊,未选中白底/选中绿底 */
  .hist-tab { display: inline-flex; align-items: center; gap: .35rem; padding: .3rem .9rem; font-size: .8125rem;
              cursor: pointer; background: oklch(var(--b1)); color: oklch(var(--bc) / .75);
              border: 1px solid oklch(var(--bc) / .22); border-radius: 999px; transition: color .15s, border-color .15s, background .15s; }
  .hist-tab svg { width: 1em; height: 1em; margin-right: .35em; }
  .hist-tab:hover { border-color: var(--sfg); color: var(--sfg-deep); }
  .hist-tab.active { background: var(--sfg-fill); border-color: var(--sfg-fill); color: #fff; font-weight: 650; }
  /* 子标签（流水/批次）：文字标签 + 选中下划线，比主标签轻 */
  .hist-subtab { padding: .15rem .2rem; font-size: .8125rem; color: oklch(var(--bc) / .6);
                 border-bottom: 2px solid transparent; cursor: pointer; }
  .hist-subtab:hover { color: var(--sfg-deep); }
  .hist-subtab.active { color: var(--sfg-deep); border-bottom-color: var(--sfg-fill); font-weight: 650; }
  /* 筛选行：紧凑一点，别喧宾夺主 */
  .hist-filters th { padding-top: .15rem; padding-bottom: .35rem; }
  .hist-filters .input, .hist-filters .select { height: 1.5rem; min-height: 1.5rem; font-size: .7rem; }
  /* 移动端：数据行换成卡片；筛选行保留（列名行隐藏，否则一排表头没意义） */
  .hist-cards { display: none; }
  @media (max-width: 767px) {
    .hist-table-wrap table > thead > tr:first-child,
    .hist-table-wrap tbody,
    .hist-table-wrap .hist-more { display: none; }
    .hist-cards { display: block; }
  }
</style>
<div class="space-y-4">

  <!-- ===== 页头 ===== -->
  <header>
    <div class="flex items-center gap-2 flex-wrap">
      <h2 class="text-lg font-extrabold tracking-tight">进度历史</h2>
    </div>
  </header>

  <!-- 顶部：正在跑的任务 -->
  <div id="progress-live" hx-get="/api/progress/live" hx-trigger="load, every 1s" hx-swap="innerHTML">
    <p class="c-sub text-xs py-4 text-center">加载中…</p>
  </div>

  <!-- ===== 三个标签：全部历史记录 / 各歌单榜单当前状态 / 回收站 ===== -->
  <section class="card tier1 border border-base-300 shadow-sm">
    <div class="card-body gap-2">
      <div class="flex flex-wrap gap-1.5">
        <button type="button" class="hist-tab <%= initialTab === 'rows' ? 'active' : '' %>" id="tab-rows"
          onclick="histSwitch('tab-rows','/api/history/rows')"><svg aria-hidden="true"><use href="#i-listSearch"/></svg>全部历史记录</button>
        <button type="button" class="hist-tab <%= initialTab === 'status' ? 'active' : '' %>" id="tab-status"
          onclick="histSwitch('tab-status','/api/progress/table')"><svg aria-hidden="true"><use href="#i-playlist"/></svg>各歌单/榜单当前状态</button>
        <button type="button" class="hist-tab ml-auto <%= initialTab === 'trash' ? 'active' : '' %>" id="tab-trash"
          onclick="histSwitch('tab-trash','/api/trash/partial')"><svg aria-hidden="true"><use href="#i-trash"/></svg>回收站</button>
      </div>

      <!-- 标签①的工具栏：搜索 + 流水/批次切换（其它标签自动隐藏） -->
      <div id="hist-toolbar" class="<%= initialTab === 'rows' ? '' : 'hidden' %> space-y-2">
        <!-- 标签①的两个子标签：流水（事件） / 批次（每次运行） -->
        <div class="flex items-center gap-4 border-b border-base-200 pb-0.5">
          <button type="button" class="hist-subtab active" id="view-rows" onclick="histView('rows')">流水</button>
          <button type="button" class="hist-subtab" id="view-batches" onclick="histView('batches')">批次</button>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <label class="input input-bordered input-sm flex items-center gap-2 flex-1 min-w-56">
            <svg aria-hidden="true" style="width:1em;height:1em"><use href="#i-listSearch"/></svg>
            <input type="search" name="q" value="" placeholder="搜歌名 / 歌手 / 歌单名 —— 会给出这首歌的完整来历"
                   class="grow" hx-get="/api/history/search" hx-trigger="input changed delay:350ms, search"
                   hx-target="#hist-search" hx-swap="innerHTML"
                   oninput="histSearchToggle(this.value)">
          </label>
        </div>
        <div id="hist-search"></div>
      </div>

      <div id="hist-msg" class="text-sm"></div>
      <div id="hist-content" class="trash-host"
           hx-get="<%= initialTab === 'status' ? '/api/progress/table' : initialTab === 'trash' ? '/api/trash/partial' : '/api/history/rows' %>"
           hx-trigger="load">
        <p class="c-sub text-xs py-10 text-center">加载中…</p>
      </div>
    </div>
  </section>

  <!-- 删除弹窗：三个复选框（文件/歌单/历史） -->
  <dialog id="hist-del-dlg" class="modal">
    <div class="modal-box max-w-md">
      <h3 class="text-base font-bold">删除</h3>
      <p id="hist-del-sum" class="text-sm mt-2"></p>
      <div class="flex flex-col gap-1.5 mt-3 text-sm">
        <label class="flex items-center gap-2 cursor-pointer" title="移入回收站（可恢复）；仍被其它任务引用的会保留">
          <input type="checkbox" id="hist-ck-file" class="checkbox checkbox-sm">文件
        </label>
        <label class="flex items-center gap-2 cursor-pointer" title="从歌单中移除本任务加入过的歌（歌单本身保留）">
          <input type="checkbox" id="hist-ck-pl" class="checkbox checkbox-sm">歌单
        </label>
        <label class="flex items-start gap-2 cursor-pointer">
          <input type="checkbox" id="hist-ck-hist" class="checkbox checkbox-sm mt-0.5" checked>
          <span>历史记录 <span class="text-xs c-sub">（只清这份流水账——<b>不影响以后的同步，也不会重新下载</b>；要让这些歌以后重新下载请勾「文件」）</span></span>
        </label>
      </div>
      <div class="modal-action">
        <button type="button" class="btn btn-ghost btn-sm" onclick="document.getElementById('hist-del-dlg').close()">取消</button>
        <button type="button" class="btn btn-error btn-sm" onclick="histDoDelete()"><svg aria-hidden="true"><use href="#i-trash"/></svg>确认删除</button>
      </div>
    </div>
  </dialog>

</div>

<script>
// ===== 标签切换 =====
function histSwitch(tabId, url) {
  document.querySelectorAll('.hist-tab').forEach(function (b) { b.classList.remove('active') })
  document.getElementById(tabId).classList.add('active')
  var toolbar = document.getElementById('hist-toolbar')
  var isRows = tabId === 'tab-rows'
  toolbar.classList.toggle('hidden', !isRows)
  if (isRows) histView(histViewMode())            // 回到标签①时按当前视图（流水/批次）加载
  else htmx.ajax('GET', url, { target: '#hist-content', swap: 'innerHTML' })
}
function histViewMode() { return document.getElementById('view-batches').classList.contains('active') ? 'batches' : 'rows' }
function histView(mode) {
  document.getElementById('view-rows').classList.toggle('active', mode === 'rows')
  document.getElementById('view-batches').classList.toggle('active', mode === 'batches')
  htmx.ajax('GET', mode === 'batches' ? '/api/history/batches' : '/api/history/rows', { target: '#hist-content', swap: 'innerHTML' })
}
// 搜索框有内容 → 藏起表格只看搜索结果；清空 → 恢复
function histSearchToggle(v) {
  var on = !!v.trim()
  var content = document.getElementById('hist-content')
  if (content) content.classList.toggle('hidden', on)
}
// 搜索卡 / 台账里的「看它的全部记录」：切回标签①并把条件写进筛选表单
function histFilterBy(params) {
  document.querySelectorAll('.hist-tab').forEach(function (b) { b.classList.remove('active') })
  document.getElementById('tab-rows').classList.add('active')
  document.getElementById('hist-toolbar').classList.remove('hidden')
  histView('rows')
  var qs = new URLSearchParams(params).toString()
  htmx.ajax('GET', '/api/history/rows?' + qs, { target: '#hist-content', swap: 'innerHTML' })
  var box = document.querySelector('#hist-toolbar input[type=search]')
  if (box && params.q) box.value = ''
  document.getElementById('hist-search').innerHTML = ''
  window.scrollTo({ top: 0, behavior: 'smooth' })
}

// 日期区间：清除后走「应用」按钮提交（表单的 change 触发被两个日期框主动挡掉了）
function histClearDates() {
  var f = document.getElementById('hist-filter')
  if (!f) return
  var a = f.querySelector('input[name=from]'); if (a) a.value = ''
  var b = f.querySelector('input[name=to]'); if (b) b.value = ''
  var btn = document.getElementById('hist-date-apply')
  if (btn) btn.click()
}

// ===== 删除（三选项）=====
var histPending = null   // { sel: 'i:12' | 's:3:tx_abc', label: '歌曲名' }
function histAskDeleteOne(btn) {
  histPending = { sel: 'i:' + btn.dataset.item, label: btn.dataset.name || '' }
  document.getElementById('hist-del-sum').innerHTML = '将处理：<b>' + histPending.label + '</b>'
  document.getElementById('hist-del-dlg').showModal()
}
function histAskDeleteSong(btn) {
  histPending = { sel: 's:' + btn.dataset.task + ':' + btn.dataset.song, label: btn.dataset.name || btn.dataset.song }
  document.getElementById('hist-del-sum').innerHTML = '将处理：<b>' + histPending.label + '</b>（该任务下这首歌的全部记录）'
  document.getElementById('hist-del-dlg').showModal()
}
function histOpts() {
  return {
    file: document.getElementById('hist-ck-file').checked,
    playlist: document.getElementById('hist-ck-pl').checked,
    history: document.getElementById('hist-ck-hist').checked
  }
}
function histDoDelete() {
  if (!histPending) return
  var o = histOpts()
  if (!o.file && !o.playlist && !o.history) {
    document.getElementById('hist-msg').innerHTML = '<span class="bad">❌ 请至少勾选一项要删除的内容</span>'
    return
  }
  document.getElementById('hist-del-dlg').close()
  var body = new URLSearchParams()
  body.set('sel', histPending.sel)
  body.set('file', o.file ? '1' : '0')
  body.set('playlist', o.playlist ? '1' : '0')
  body.set('history', o.history ? '1' : '0')
  fetch('/api/history/delete', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body })
    .then(function (r) { return r.text() })
    .then(function (html) {
      document.getElementById('hist-msg').innerHTML = html
      histView(histViewMode())
    })
    .catch(function () { document.getElementById('hist-msg').innerHTML = '<span class="bad">❌ 删除请求失败，请重试</span>' })
}
</script>
