<style>
  /* 标签:胶囊,未选中白底/选中绿底 */
  .hist-tab { display: inline-flex; align-items: center; gap: .35rem; padding: .3rem .9rem; font-size: .8125rem;
              cursor: pointer; background: oklch(var(--b1)); color: oklch(var(--bc) / .75);
              border: 1px solid oklch(var(--bc) / .22); border-radius: 999px; transition: color .15s, border-color .15s, background .15s; }
  .hist-tab svg { width: 1em; height: 1em; margin-right: .35em; }
  .hist-tab:hover { border-color: var(--sfg); color: var(--sfg-deep); }
  .hist-tab.active { background: var(--sfg-fill); border-color: var(--sfg-fill); color: #fff; font-weight: 650; }
  /* 子标签（流水/批次）：风格与主标签统一（同款胶囊，尺寸小一号） */
  .hist-subtab { display: inline-flex; align-items: center; gap: .3rem; padding: .2rem .75rem; font-size: .8125rem;
                 cursor: pointer; background: oklch(var(--b1)); color: oklch(var(--bc) / .75);
                 border: 1px solid oklch(var(--bc) / .22); border-radius: 999px; transition: color .15s, border-color .15s, background .15s; }
  .hist-subtab:hover { border-color: var(--sfg); color: var(--sfg-deep); }
  .hist-subtab.active { background: var(--sfg-fill); border-color: var(--sfg-fill); color: #fff; font-weight: 650; }
  /* 可点的歌名（点开看这首歌的完整来历） */
  .hist-song { color: var(--sfg-deep); border-bottom: 1px dashed oklch(var(--bc) / .3); }
  .hist-song:hover { border-bottom-style: solid; }
  /* 日期下拉：fixed 定位贴在按钮下方；外部点击/Esc 关闭 */
  .hist-pop { position: fixed; z-index: 60; width: 15rem; padding: .75rem;
              background: oklch(var(--b1)); border: 1px solid oklch(var(--bc) / .22);
              border-radius: .5rem; box-shadow: 0 8px 24px oklch(0 0 0 / .18); }
  /* 日期列：整格可点（点击区 = 整个单元格，不只是图标） */
  .hist-date-th { cursor: pointer; }
  .hist-date-btn { pointer-events: none; }   /* 视觉按钮，点击交给 th */
  .hist-date-btn svg { width: .95em; height: .95em; }
  /* 表头永远单行；单元格内容该换行就换行，不挤成一条 */
  .hist-table th { white-space: nowrap; }
  .hist-wrap { white-space: normal; word-break: break-word; overflow-wrap: anywhere; }
  /* 筛选行：紧凑一点，别喧宾夺主 */
  .hist-filters th { padding-top: .15rem; padding-bottom: .35rem; }
  .hist-filters .input, .hist-filters .select { height: 1.5rem; min-height: 1.5rem; font-size: .7rem; }
  /* 事件表：列宽由 colgroup 定，表格不足时撑满、超出时横向滚动 */
  .hist-table { width: auto; min-width: 100%; }
  /* 表头 + 分页条固定，中间列表滚动（参考 MoviePilot 的媒体列表）：
     表格外层是滚动容器，sticky 只对它生效，所以改用「表单固定高度 + 内部滚动」，
     表头 sticky 在这个内部滚动容器里就正常了，分页条作为 flex 尾部自然固定 */
  .hist-fixed { display: flex; flex-direction: column; }
  #hist-scroll { overflow: auto; height: calc(100vh - 26rem); min-height: 16rem; }
  .hist-table thead { position: sticky; top: 0; z-index: 6; }
  .hist-table thead th { background: oklch(var(--b1)); box-shadow: inset 0 -1px 0 oklch(var(--bc) / .15); }
  .hist-pager { border-top: 1px solid oklch(var(--bc) / .1); }
  @media (max-width: 767px) { #hist-scroll { height: auto; max-height: none; } }
  /* <details> 当按钮用：去掉默认三角 */
  .dropdown > summary { list-style: none; }
  .dropdown > summary::-webkit-details-marker { display: none; }
  .dropdown > summary::marker { content: ''; }
  .hist-table th, .hist-table td { vertical-align: top; }
  /* 左右滚动按钮：固定在容器两侧，不随内容滚动移动 */
  .hist-scroll-host { position: relative; }
  .hist-scroll-btn { position: absolute; top: 50%; transform: translateY(-50%); z-index: 30;
                     width: 1.6rem; height: 3.6rem; display: none; align-items: center; justify-content: center;
                     background: oklch(var(--b1) / .95); border: 1px solid oklch(var(--bc) / .22);
                     border-radius: .45rem; font-size: 1.15rem; line-height: 1; cursor: pointer;
                     color: oklch(var(--bc) / .7); box-shadow: 0 1px 3px oklch(0 0 0 / .08); }
  .hist-scroll-btn:hover { color: var(--sfg-deep); border-color: var(--sfg); }
  .hist-scroll-btn:active { background: var(--sfg-fill); color: #fff; }
  .hist-scroll-left { left: -0.1rem; }
  .hist-scroll-right { right: -0.1rem; }
  @media (min-width: 768px) { .hist-scroll-btn.show { display: flex; } }

  /* 移动端：数据行换成卡片；筛选行保留（列名行隐藏，否则一排表头没意义） */
  .hist-cards { display: none; }
  @media (max-width: 767px) {
    .hist-table-wrap table > thead > tr:first-child,
    .hist-table-wrap tbody { display: none; }
    .hist-cards { display: block; }
  }
</style>
<div class="space-y-4">

  <!-- ===== 页头 ===== -->
  <header>
    <div class="flex items-center gap-2 flex-wrap">
      <h2 class="text-lg font-extrabold tracking-tight">进度历史</h2>
    </div>
  </header>

  <!-- 顶部：正在跑的任务 -->
  <div id="progress-live" hx-get="/api/progress/live" hx-trigger="load, every 1s" hx-swap="innerHTML">
    <p class="c-sub text-xs py-4 text-center">加载中…</p>
  </div>

  <!-- ===== 三个标签：全部历史记录 / 各歌单榜单当前状态 / 回收站 ===== -->
  <section class="card tier1 border border-base-300 shadow-sm">
    <div class="card-body gap-2">
      <div class="flex flex-wrap gap-1.5">
        <button type="button" class="hist-tab <%= initialTab === 'rows' ? 'active' : '' %>" id="tab-rows"
          onclick="histSwitch('tab-rows','/api/history/rows')"><svg aria-hidden="true"><use href="#i-listSearch"/></svg>全部历史记录</button>
        <button type="button" class="hist-tab <%= initialTab === 'status' ? 'active' : '' %>" id="tab-status"
          onclick="histSwitch('tab-status','/api/progress/table')"><svg aria-hidden="true"><use href="#i-playlist"/></svg>各歌单/榜单当前状态</button>
        <button type="button" class="hist-tab ml-auto <%= initialTab === 'trash' ? 'active' : '' %>" id="tab-trash"
          onclick="histSwitch('tab-trash','/api/trash/partial')"><svg aria-hidden="true"><use href="#i-trash"/></svg>回收站</button>
      </div>

      <!-- 标签①的工具栏：搜索 + 流水/批次切换（其它标签自动隐藏） -->
      <div id="hist-toolbar" class="<%= initialTab === 'rows' ? '' : 'hidden' %> space-y-2">
        <!-- 标签①的两个子标签：流水（事件） / 批次（每次运行） -->
        <div class="flex items-center gap-4 border-b border-base-200 pb-0.5">
          <button type="button" class="hist-subtab active" id="view-rows" onclick="histView('rows')">流水</button>
          <button type="button" class="hist-subtab" id="view-batches" onclick="histView('batches')">批次</button>
        </div>
        <div class="text-xs c-sub">
          搜索/筛选都在下面表头那一行里；<b>点歌曲名</b>可以看这首歌的完整来历（当前状态、文件来源、首次·最近、引用）
        </div>
      </div>

      <div id="hist-msg" class="text-sm"></div>
      <div id="hist-content" class="trash-host"
           hx-get="<%= initialTab === 'status' ? '/api/progress/table' : initialTab === 'trash' ? '/api/trash/partial' : '/api/history/rows' %>"
           hx-trigger="load">
        <p class="c-sub text-xs py-10 text-center">加载中…</p>
      </div>
    </div>
  </section>

  <!-- 歌曲来历弹层：点表格里的歌名打开（复用搜索卡接口） -->
  <dialog id="hist-song-dlg" class="modal">
    <div class="modal-box max-w-2xl">
      <h3 class="text-base font-bold" id="hist-song-title">歌曲来历</h3>
      <div id="hist-song-body" class="mt-2"></div>
      <div class="modal-action">
        <button type="button" class="btn btn-ghost btn-sm" onclick="document.getElementById('hist-song-dlg').close()">关闭</button>
      </div>
    </div>
  </dialog>

  <!-- 删除弹窗：三个复选框（文件/歌单/历史） -->
  <dialog id="hist-del-dlg" class="modal">
    <div class="modal-box max-w-md">
      <h3 class="text-base font-bold">删除</h3>
      <p id="hist-del-sum" class="text-sm mt-2"></p>
      <div class="flex flex-col gap-1.5 mt-3 text-sm">
        <label class="flex items-center gap-2 cursor-pointer" title="移入回收站（可恢复）；仍被其它任务引用的会保留">
          <input type="checkbox" id="hist-ck-file" class="checkbox checkbox-sm">文件
        </label>
        <label class="flex items-center gap-2 cursor-pointer" title="从歌单中移除本任务加入过的歌（歌单本身保留）">
          <input type="checkbox" id="hist-ck-pl" class="checkbox checkbox-sm">歌单
        </label>
        <label class="flex items-start gap-2 cursor-pointer">
          <input type="checkbox" id="hist-ck-hist" class="checkbox checkbox-sm mt-0.5" checked>
          <span>历史记录 <span class="text-xs c-sub">（只清这份流水账——<b>不影响以后的同步，也不会重新下载</b>；要让这些歌以后重新下载请勾「文件」）</span></span>
        </label>
      </div>
      <div class="modal-action">
        <button type="button" class="btn btn-ghost btn-sm" onclick="document.getElementById('hist-del-dlg').close()">取消</button>
        <button type="button" class="btn btn-error btn-sm" onclick="histDoDelete()"><svg aria-hidden="true"><use href="#i-trash"/></svg>确认删除</button>
      </div>
    </div>
  </dialog>

</div>

<script>
// ===== 标签切换 =====
function histSwitch(tabId, url) {
  document.querySelectorAll('.hist-tab').forEach(function (b) { b.classList.remove('active') })
  document.getElementById(tabId).classList.add('active')
  var toolbar = document.getElementById('hist-toolbar')
  var isRows = tabId === 'tab-rows'
  toolbar.classList.toggle('hidden', !isRows)
  if (isRows) histView(histViewMode())            // 回到标签①时按当前视图（流水/批次）加载
  else htmx.ajax('GET', url, { target: '#hist-content', swap: 'innerHTML' })
}
function histViewMode() { return document.getElementById('view-batches').classList.contains('active') ? 'batches' : 'rows' }
function histView(mode) {
  document.getElementById('view-rows').classList.toggle('active', mode === 'rows')
  document.getElementById('view-batches').classList.toggle('active', mode === 'batches')
  htmx.ajax('GET', mode === 'batches' ? '/api/history/batches' : '/api/history/rows', { target: '#hist-content', swap: 'innerHTML' })
}
// 点歌名 → 弹出"这首歌的来历"（复用 /api/history/search 的卡片）
function histShowSong(name) {
  var dlg = document.getElementById('hist-song-dlg')
  var body = document.getElementById('hist-song-body')
  if (!dlg || !body) return
  document.getElementById('hist-song-title').textContent = '歌曲来历：' + name
  body.innerHTML = '<p class="c-sub text-xs py-6 text-center">加载中…</p>'
  dlg.showModal()
  fetch('/api/history/search?q=' + encodeURIComponent(name))
    .then(function (r) { return r.text() })
    .then(function (html) { body.innerHTML = html })
    .catch(function () { body.innerHTML = '<p class="st-bad text-xs">加载失败，请重试</p>' })
}
// 卡片里的「看它的全部记录」：关掉弹层 + 切到流水并按歌名筛选
function histSongToRecords(btn) {
  var name = btn.getAttribute('data-song') || ''
  var dlg = document.getElementById('hist-song-dlg')
  if (dlg && dlg.open) dlg.close()
  histFilterBy({ song: name })
}
// 搜索卡 / 台账里的「看它的全部记录」：切回标签①并把条件写进筛选表单
function histFilterBy(params) {
  document.querySelectorAll('.hist-tab').forEach(function (b) { b.classList.remove('active') })
  document.getElementById('tab-rows').classList.add('active')
  document.getElementById('hist-toolbar').classList.remove('hidden')
  histView('rows')
  var qs = new URLSearchParams(params).toString()
  htmx.ajax('GET', '/api/history/rows?' + qs, { target: '#hist-content', swap: 'innerHTML' })
  window.scrollTo({ top: 0, behavior: 'smooth' })
}

// 横向滚动：两侧固定按钮
function histScroll(dir) {
  var el = document.getElementById('hist-scroll')
  if (!el) return
  el.scrollBy({ left: dir * Math.max(240, el.clientWidth * 0.7), behavior: 'smooth' })
}
// 只有当表格真的超出容器时才显示两侧按钮（窄屏走卡片，不显示）
function histScrollButtons() {
  var el = document.getElementById('hist-scroll')
  if (!el) return
  var host = el.closest('.hist-scroll-host')
  if (!host) return
  var need = el.scrollWidth - el.clientWidth > 8
  host.querySelectorAll('.hist-scroll-btn').forEach(function (b) { b.classList.toggle('show', need) })
}
document.body.addEventListener('htmx:afterSwap', histScrollButtons)
window.addEventListener('resize', histScrollButtons)
document.addEventListener('DOMContentLoaded', function () { histScrollButtons(); setTimeout(histScrollButtons, 300) })

// 固定高度：让表头+分页条不动、只有列表滚动（精确算一下可用高度，CSS 里给的是兜底值）
function histFitHeight() {
  var box = document.getElementById('hist-scroll')
  var wrap = document.getElementById('hist-rows-wrap')
  if (!box || !wrap) return
  if (window.innerWidth < 768) { box.style.height = ''; return }   // 移动端走卡片，不固定
  var pager = wrap.querySelector('.hist-pager')
  var ph = pager ? pager.getBoundingClientRect().height : 0
  var top = box.getBoundingClientRect().top
  var h = Math.max(240, Math.round(window.innerHeight - top - ph - 16))
  box.style.height = h + 'px'
}
document.body.addEventListener('htmx:afterSwap', function () { histFitHeight(); histScrollButtons() })
window.addEventListener('resize', histFitHeight)
document.addEventListener('DOMContentLoaded', function () { histFitHeight(); setTimeout(histFitHeight, 400) })

// 日期下拉：贴在按钮下方弹出（fixed 定位，绕开表格滚动容器的裁剪）
function histToggleDate() {
  var panel = document.getElementById('hist-date-panel')
  var btn = document.getElementById('hist-date-btn')
  if (!panel || !btn) return
  if (!panel.hidden) { panel.hidden = true; return }
  panel.hidden = false
  var r = btn.getBoundingClientRect()
  var pw = panel.offsetWidth, ph = panel.offsetHeight
  var left = Math.min(Math.max(8, r.left), window.innerWidth - pw - 8)
  var top = r.bottom + 6
  if (top + ph > window.innerHeight - 8) top = Math.max(8, r.top - ph - 6)  // 下面放不下就翻到上方
  panel.style.left = left + 'px'
  panel.style.top = top + 'px'
}
// 点面板外面 / 按 Esc 关闭
document.addEventListener('click', function (e) {
  var panel = document.getElementById('hist-date-panel')
  if (!panel || panel.hidden) return
  // 点在面板内、或点在日期表头格里（那格的点击由 histToggleDate 负责）都不关
  var inHeader = e.target && e.target.closest && e.target.closest('.hist-date-th')
  if (panel.contains(e.target) || inHeader) return
  panel.hidden = true
})
document.addEventListener('keydown', function (e) {
  if (e.key !== 'Escape') return
  var panel = document.getElementById('hist-date-panel')
  if (panel) panel.hidden = true
})

// 日期框：点哪都弹日历（原生小图标的热区与图标位置有偏移，用户得瞄着点）
function histPickDate(el) {
  if (el && typeof el.showPicker === 'function') {
    try { el.showPicker() } catch (e) { /* 需要用户手势或不支持：忽略，原生行为兜底 */ }
  }
}

// 日期区间：清除后走「应用」按钮提交（表单的 change 触发被两个日期框主动挡掉了）
function histClearDates() {
  var f = document.getElementById('hist-filter')
  if (!f) return
  var a = f.querySelector('input[name=from]'); if (a) a.value = ''
  var b = f.querySelector('input[name=to]'); if (b) b.value = ''
  var btn = document.getElementById('hist-date-apply')
  if (btn) btn.click()
}

// ===== 删除（三选项）=====
var histPending = null   // { sel: 'i:12' | 's:3:tx_abc', label: '歌曲名' }
function histAskDeleteOne(btn) {
  histPending = { sel: 'i:' + btn.dataset.item, label: btn.dataset.name || '' }
  document.getElementById('hist-del-sum').innerHTML = '将处理：<b>' + histPending.label + '</b>'
  document.getElementById('hist-del-dlg').showModal()
}
function histAskDeleteSong(btn) {
  histPending = { sel: 's:' + btn.dataset.task + ':' + btn.dataset.song, label: btn.dataset.name || btn.dataset.song }
  document.getElementById('hist-del-sum').innerHTML = '将处理：<b>' + histPending.label + '</b>（该任务下这首歌的全部记录）'
  document.getElementById('hist-del-dlg').showModal()
}
function histOpts() {
  return {
    file: document.getElementById('hist-ck-file').checked,
    playlist: document.getElementById('hist-ck-pl').checked,
    history: document.getElementById('hist-ck-hist').checked
  }
}
function histDoDelete() {
  if (!histPending) return
  var o = histOpts()
  if (!o.file && !o.playlist && !o.history) {
    document.getElementById('hist-msg').innerHTML = '<span class="bad">❌ 请至少勾选一项要删除的内容</span>'
    return
  }
  document.getElementById('hist-del-dlg').close()
  var body = new URLSearchParams()
  body.set('sel', histPending.sel)
  body.set('file', o.file ? '1' : '0')
  body.set('playlist', o.playlist ? '1' : '0')
  body.set('history', o.history ? '1' : '0')
  fetch('/api/history/delete', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body })
    .then(function (r) { return r.text() })
    .then(function (html) {
      document.getElementById('hist-msg').innerHTML = html
      histView(histViewMode())
    })
    .catch(function () { document.getElementById('hist-msg').innerHTML = '<span class="bad">❌ 删除请求失败，请重试</span>' })
}
</script>
