<style>
  /* 双 tab(同步/洗版):下划线式 */
  .hist-tab { display: inline-flex; align-items: center; gap: .35rem; padding: .3rem .9rem; font-size: .8125rem;
              cursor: pointer; background: oklch(var(--b1)); color: oklch(var(--bc) / .75);
              border: 1px solid oklch(var(--bc) / .22); border-radius: 999px; transition: color .15s, border-color .15s, background .15s; }
  .hist-tab { display: inline-flex; align-items: center; }
  .hist-tab svg { width: 1em; height: 1em; margin-right: .35em; }
  .hist-tab:hover { color: var(--sfg-deep); }
  .hist-tab:hover { border-color: var(--sfg); color: var(--sfg-deep); }
  .hist-tab.active { background: var(--sfg); border-color: var(--sfg); color: var(--sfg-ink); font-weight: 650; }
</style>
<div class="space-y-4">

  <!-- ===== 页头 ===== -->
  <header>
    <div class="flex items-center gap-2 flex-wrap">
      <h2 class="text-lg font-extrabold tracking-tight">历史记录</h2>
    </div>
  </header>

  <section class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-2">
      <div class="flex flex-wrap gap-1.5">
        <button type="button" class="hist-tab active" id="tab-sync"
          hx-get="/api/history/partial" hx-target="#hist-content" hx-swap="innerHTML"
          onclick="switchHistTab('tab-sync')"><svg aria-hidden="true"><use href="#i-clock"/></svg>同步任务历史记录</button>
        <button type="button" class="hist-tab" id="tab-upgrade"
          hx-get="/api/upgrade/history/partial" hx-target="#hist-content" hx-swap="innerHTML"
          onclick="switchHistTab('tab-upgrade')"><svg aria-hidden="true"><use href="#i-refresh"/></svg>洗版历史记录</button>
      </div>
      <div id="hist-content" hx-get="/api/history/partial" hx-trigger="load">
        <p class="c-sub text-xs py-10 text-center">加载中…</p>
      </div>
    </div>
  </section>

</div>

<script>
function switchHistTab(id) {
  document.querySelectorAll('.hist-tab').forEach(function (b) { b.classList.remove('active') })
  document.getElementById(id).classList.add('active')
}
// 批次明细:点展开加载、再点收起(避免重复拉取);图标与文案随状态切换
function histSetState(btn, open) {
  var sp = btn.querySelector('.h-txt')
  var u = btn.querySelector('use')
  if (sp) sp.textContent = open ? '收起' : '查看明细'
  if (u) u.setAttribute('href', open ? '#i-chevronUp' : '#i-chevronDown')
}
function histToggle(id, btn) {
  var box = document.getElementById('batch-' + id)
  if (!box) return
  if (box.dataset.loaded === '1') {
    box.innerHTML = ''
    box.dataset.loaded = ''
    histSetState(btn, false)
    return
  }
  box.innerHTML = '<span class="c-sub text-xs">加载中…</span>'
  histSetState(btn, true)
  fetch('/api/history/batch/' + id)
    .then(function (r) { return r.text() })
    .then(function (html) {
      box.innerHTML = html
      box.dataset.loaded = '1'
    })
    .catch(function () {
      box.innerHTML = '<span class="st-bad text-xs">加载失败，请重试</span>'
      histSetState(btn, false)
    })
}
</script>
